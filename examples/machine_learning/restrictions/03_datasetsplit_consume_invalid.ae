open ML

def train_and_score
    (1 training: TrainingDataset)
    (1 testing: {test: TestingDataset
        | testing_features test = training_features training
       && testing_split_id test = training_split_id training}) : Float :=
    let model := decision_tree_classifier training in
    accuracy model testing


# WRONG: the same DatasetSplit cannot be eliminated twice.
def consume_twice (1 parts: DatasetSplit) : Float :=
    let first_score := consume_split parts train_and_score in
    consume_split parts train_and_score
