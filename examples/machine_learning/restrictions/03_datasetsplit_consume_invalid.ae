open ML

def score_split_twice_case
    (1 training: TrainingDataset)
    (1 testing: {test: TestingDataset
        | testing_features test = training_features training
       && testing_classes test = training_classes training
       && testing_split_id test = training_split_id training}) : Float :=
    let model := decision_tree_classifier training in
    accuracy model testing


# ERRADO: o mesmo DatasetSplit e aberto por consume_split duas vezes.
def main (_: Int) : Float :=
    let 1 df := read_csv "examples/machine_learning/titanic.csv" in
    let 1 dataset := target df 1 in
    let 1 parts := split dataset 0.7 in
    let first_score := consume_split parts score_split_twice_case in
    let second_score := consume_split parts score_split_twice_case in
    first_score + second_score
