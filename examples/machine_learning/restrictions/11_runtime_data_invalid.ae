open ML

# O tipo apenas conhece os metadados prometidos por read_csv/target; precisa de
# abrir o ficheiro para descobrir que o target real so contem a classe 0.
# Este programa passa a verificacao estatica e falha em target no runtime.
def score_invalid_runtime_data
    (1 training: TrainingDataset)
    (1 testing: {test: TestingDataset
        | testing_features test = training_features training
       && testing_classes test = training_classes training
       && testing_split_id test = training_split_id training}) : Float :=
    let model := decision_tree_classifier training in
    accuracy model testing


def main (_: Int) : Float :=
    let 1 df := read_csv "examples/machine_learning/data/invalid_single_class.csv" in
    let 1 dataset := target df 1 in
    let 1 parts := split dataset 0.5 in
    consume_split parts score_invalid_runtime_data
