open ML

# ERRADO: as duas chamadas tentam consumir o mesmo DataFrame.
# Os resultados nao sao lineares de proposito: assim o unico erro demonstrado
# por este ficheiro e a reutilizacao de df.
def main (_: Int) : Float :=
    let 1 df := read_csv "examples/machine_learning/titanic.csv" in
    let first_dataset := target df 1 in
    let second_dataset := target df 1 in
    0.0
