open ML

def train_and_score
    (1 training: TrainingDataset)
    (1 testing: {test: TestingDataset
        | testing_features test = training_features training
       && testing_split_id test = training_split_id training}) : Float :=
    let 1 model := decision_tree_classifier training in
    let score := accuracy model testing in
    let _ := dispose_classifier model in score


# CORRECT: consume_split eliminates the linear container once.
def consume_once (1 parts: DatasetSplit) : Float :=
    consume_split parts train_and_score
