open ML

# ERRADO: um Dataset ja entregue a split nao pode originar um segundo split.
def main (_: Int) : Float :=
    let 1 df := read_csv "examples/machine_learning/titanic.csv" in
    let 1 dataset := target df 1 in
    let first_parts := split dataset 0.7 in
    let second_parts := split dataset 0.7 in
    0.0
