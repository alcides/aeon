open ML

# The callback exposes the two linear resources produced by split. Training is
# consumed by the classifier and testing by accuracy. Refinements relate their
# feature count and split provenance.
def train_and_evaluate
    (1 training: TrainingDataset)
    (1 testing: {test: TestingDataset
        | testing_features test = training_features training
       && testing_split_id test = training_split_id training}) : Float :=
    let model := decision_tree_classifier training in
    accuracy model testing


def main (_: Int) : Float :=
    # Every pipeline state has one owner and is consumed exactly once.
    let 1 raw := read_csv "examples/machine_learning/titanic.csv" in
    let 1 df := assume_columns raw 12 in
    let 1 dataset := target df 1 in
    let 1 parts := split dataset 0.7 in
    consume_split parts train_and_evaluate
