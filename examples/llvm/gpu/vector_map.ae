open Array
open ArrayKernels

# Updated GPU Array map example (replaces deleted Vector API).
@gpu(target:="cuda", block_size:=256)
def mul10 (x: Int) : Int := x * 10;

@gpu(target:="cuda", block_size:=256)
def multiply_by_ten (1 v:(Array Int)) (n: Int) : {r:(Array Int) | size r = n} :=
    map_n_int mul10 v n;

def main (args:Int) : Unit :=
    let 1 v0 := Array.mk_empty{Int} unit in
    let 1 v1 := Array.mk_concat v0 (Array.mk_1 1) in
    let 1 v2 := Array.mk_concat v1 (Array.mk_1 2) in
    let 1 v3 := Array.mk_concat v2 (Array.mk_1 3) in
    let 1 res := multiply_by_ten v3 3 in
    print (Array.take{Int} res 1);
