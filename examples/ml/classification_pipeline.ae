# End-to-end classification pipeline showcasing the Learning library.
#
# This pipeline is *leakage-free* by construction, and the refinements
# enforce it (see ``libraries/Learning.ae``):
#
#   * ``require_enough_data`` discharges the minimum-data precondition of
#     ``split`` on the CSV path, where the row count is statically unknown.
#   * The train/test ``split`` happens **before** any cross-row transform.
#     SMOTE is applied to the *training half only*, after the split — doing
#     it earlier would taint the test set (``coupled`` source) and
#     ``accuracy`` / ``f1`` would no longer type-check.
#   * The metric is chosen by an inline ``balanced`` check: ``accuracy``
#     (balance-sensitive) only when the test set is balanced, otherwise the
#     balance-insensitive ``f1``.

open Learning
open Maybe


def pipeline (path: String) (target_col: String) : (Maybe Float) :=
    let 1 df := read_csv path in
    if has_column df target_col then
    # ``false false`` = not a time series, no missing values.
    let 1 ds0 := target df target_col false false in
    if n_features ds0 > 0 then
    let 1 ds := require_enough_data ds0 in
    let 1 parts := split ds 0.8 true in
    with_datasets parts (fun owned_left_parts => fun owned_right_parts =>
        let 1 train0 := owned_left_parts in
        let 1 test := owned_right_parts in
        # Balance the *training* half only, after the split.
        let 1 train := if is_multiclass train0 && min_class_rows train0 >= 6 then smote train0 else train0 in
        let 1 model := random_forest_classifier train in
        let score := if balanced test then
            accuracy model test
        else
            f1 model test in
        let _ := dispose_classifier model in Maybe.just score )
    else let _ := dispose_dataset ds0 in Maybe.none
    else let _ := dispose_dataframe df in Maybe.none;


# ComplementNB requires imbalanced, nonnegative data. If features are
# negative, use GaussianNB instead. Callers establish the frame/column
# preconditions with n_columns, has_column, and a positive row count.
def cnb_pipeline
    (1 df: {d: DataFrame | df_cols d > 1 && df_rows d > 0})
    (target_col: {s: String | hasColumn df s}) : SklearnClassifier :=
    let 1 ds := target df target_col false false in
    if has_nonnegative_features ds then
        if balanced ds then multinomial_nb ds else complement_nb ds
    else gaussian_nb ds;
