# Synthesis benchmark: amltk cross-validation pipeline search.
# Source: https://automl.github.io/amltk/latest/examples/sklearn-hpo-cv/
# GOAL: maximize mean three-fold stratified CV accuracy on development data.
# SEARCH: imputation strategy, scaling stage, forest depth or SVC kernel;
# 30 pipelines. Aeon chooses a composition of the typed stage constructors.
# Run: python -m aeon --budget 20 -s enumerative examples/ml/amltk_cv.ae

type Data
type Imputer
type Scaler
type Estimator
type Member

# Typed building blocks form Aeon's pipeline grammar. Python only constructs
# sklearn components; it does not sample configurations or select winners.
def pd : Unit := native_import "pandas"
def ms : Unit := native_import "sklearn.model_selection"
def ensemble : Unit := native_import "sklearn.ensemble"
def impute : Unit := native_import "sklearn.impute"
def preprocessing : Unit := native_import "sklearn.preprocessing"
def pipeline : Unit := native_import "sklearn.pipeline"
def svm : Unit := native_import "sklearn.svm"
def base : Unit := native_import "sklearn.base"

def mean_imputer : Imputer := native "impute.SimpleImputer(strategy='mean')"
def median_imputer : Imputer := native "impute.SimpleImputer(strategy='median')"
def no_scaler : Scaler := native "'passthrough'"
def standard_scaler : Scaler := native "preprocessing.StandardScaler()"
def minmax_scaler : Scaler := native "preprocessing.MinMaxScaler()"
def shallow_forest : Estimator := native "ensemble.RandomForestClassifier(n_estimators=30, max_depth=1, random_state=42, n_jobs=1)"
def medium_forest : Estimator := native "ensemble.RandomForestClassifier(n_estimators=30, max_depth=3, random_state=42, n_jobs=1)"
def deep_forest : Estimator := native "ensemble.RandomForestClassifier(n_estimators=30, max_depth=5, random_state=42, n_jobs=1)"
def linear_svc : Estimator := native "svm.SVC(C=1.0, kernel='linear', probability=True, random_state=42)"
def rbf_svc : Estimator := native "svm.SVC(C=1.0, kernel='rbf', probability=True, random_state=42)"

def assemble (fill: Imputer) (scale: Scaler) (estimator: Estimator) : Member :=
    native "pipeline.make_pipeline(fill, scale, estimator)"

def load (path: String) : Data :=
    native "(lambda df: (df.drop(columns=['species']).to_numpy(), df['species'].to_numpy()))(pd.read_csv(path))"

# X_development, X_test, y_development, y_test: 80/20, stratified.
def holdout (data: Data) : Data :=
    native "ms.train_test_split(data[0], data[1], test_size=0.2, stratify=data[1], random_state=42)"

def development : Data := holdout (load "examples/ml/data/iris.csv")

# CV clones the whole pipeline per fold: preprocessing fits only on that
# fold's training rows. The final 20% test partition is outside the objective.
def cv_accuracy (candidate: Member) : Float :=
    native "float(ms.cross_val_score(candidate, development[0], development[2], cv=ms.StratifiedKFold(n_splits=3, shuffle=True, random_state=43), scoring='accuracy', n_jobs=1).mean())"

@maximize_float(cv_accuracy (synth 0))
def synth (_: Int) : Member := ?pipeline;

# This score is never used by synthesis. Refit the synthesized pipeline on
# all development rows before the single final test evaluation.
def test_accuracy (candidate: Member) : Float :=
    native "float(base.clone(candidate).fit(development[0], development[2]).score(development[1], development[3]))"

def main (_: Int) : Float :=
    let candidate := synth 0 in
    let objective := print (cv_accuracy candidate) in
    let test := test_accuracy candidate in
    let shown := print test in
    test
