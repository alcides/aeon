# Compare classifiers from several families on one typed pipeline.
#
# ``open Learning`` brings the whole API — the core (load / target / split /
# metrics) plus every estimator family — into scope. Here we train four
# classifiers drawn from four *different* families on the same train/test
# split and report the best F1. The refinements thread through the pipeline:
# ``split`` only accepts a dataset with enough rows, marks its test half as a
# clean held-out set, and the trained models' feature counts must match the
# test set — so a leaky or mis-shaped evaluation is a type error.
#
# ``Dataset`` is linear, so each fit/score consumes its argument. We branch
# with ``copy_dataset`` and feed the projections straight into consumers
# (no intermediate ``let 1`` of a half that would then be passed to an
# ω-scaled position under nested applications).

open Learning
open Math


# F1 needs no class-balance precondition (unlike accuracy / precision /
# recall), so it scores any clean test set directly. (The result is in
# [0, 1], but ``maxf`` returns a plain ``Float``, so we report it as such.)
def best_f1 (path: String) : Float :=
    let 1 df := read_csv path in
    let 1 ds0 := target df "species" false false in
    let 1 ds := require_enough_data ds0 in
    let 1 parts := split ds 0.7 true in
    with_datasets parts (fun owned_left_parts => fun owned_right_parts =>
        let 1 train0 := owned_left_parts in
        let 1 test0 := owned_right_parts in
        let 1 tp1 := copy_dataset train0 in
        with_datasets tp1 (fun owned_left_tp1 => fun owned_right_tp1 =>
            let 1 tp2 := copy_dataset (owned_right_tp1) in
            with_datasets tp2 (fun owned_left_tp2 => fun owned_right_tp2 =>
                let 1 tp3 := copy_dataset (owned_right_tp2) in
                with_datasets tp3 (fun owned_left_tp3 => fun owned_right_tp3 =>
                    let 1 ep1 := copy_dataset test0 in
                    with_datasets ep1 (fun owned_left_ep1 => fun owned_right_ep1 =>
                        let 1 ep2 := copy_dataset (owned_right_ep1) in
                        with_datasets ep2 (fun owned_left_ep2 => fun owned_right_ep2 =>
                            let 1 ep3 := copy_dataset (owned_right_ep2) in
                            with_datasets ep3 (fun owned_left_ep3 => fun owned_right_ep3 =>
                                let forest_model := random_forest_classifier owned_left_tp1 in
                                let forest := f1 forest_model owned_left_ep1 in
                                let tree_model := decision_tree_classifier owned_left_tp2 in
                                let tree := f1 tree_model owned_left_ep2 in
                                let svc_f_model := svc owned_left_tp3 in
                                let svc_f := f1 svc_f_model owned_left_ep3 in
                                let lda_model := linear_discriminant_analysis owned_right_tp3 in
                                let lda := f1 lda_model owned_right_ep3 in
                                maxf (maxf forest tree) (maxf svc_f lda) )))))));


def main (_: Int) : Unit :=
    print (best_f1 "examples/ml/data/iris.csv")
