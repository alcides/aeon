# alldifferentreif: four nondecreasing values in 1..4 and their distinctness flag
# GOAL: Synthesize a nondecreasing sequence and a Boolean flag equivalent to all its values being distinct.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/cpmpy/all_different_reif.py
# Generated by scripts/generate_hakank_manual.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def x0 : {v:Int | 1 <= v && v <= 4} := ?h_x0;
def x1 : {v:Int | 1 <= v && v <= 4} := ?h_x1;
def x2 : {v:Int | 1 <= v && v <= 4} := ?h_x2;
def x3 : {v:Int | 1 <= v && v <= 4} := ?h_x3;
def distinct : Bool := ?h_distinct;
def sequence0_tail0 : (Vec Int) := Vec.cons (x0) (Vec.cons (x1) (Vec.cons (x2) (Vec.cons (x3) (Vec.nil))));

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := Vec.increasing (sequence0_tail0);
def constraint1 : Bool := distinct = Vec.allDifferent (sequence0_tail0);
def valid : Bool := ((constraint0) && (constraint1));

def objective : Int := 0;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print x0 in
    let report1 := print x1 in
    let report2 := print x2 in
    let report3 := print x3 in
    let report4 := print distinct in
    unit;
