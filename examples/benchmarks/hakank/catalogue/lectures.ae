import Vec;

def decision0 : {v:Int | 1 <= v && v <= 1} := ?h_decision0;
def decision1 : {v:Int | 1 <= v && v <= 2} := ?h_decision1;
def decision2 : {v:Int | 1 <= v && v <= 6} := ?h_decision2;
def decision3 : {v:Int | 1 <= v && v <= 6} := ?h_decision3;
def decision4 : {v:Int | 1 <= v && v <= 6} := ?h_decision4;
def decision5 : {v:Int | 1 <= v && v <= 6} := ?h_decision5;
def decision6 : {v:Int | 1 <= v && v <= 6} := ?h_decision6;
def decision7 : {v:Int | 1 <= v && v <= 6} := ?h_decision7;
def decision8 : {v:Int | 1 <= v && v <= 6} := ?h_decision8;
def decision9 : {v:Int | 1 <= v && v <= 6} := ?h_decision9;
def decision10 : {v:Int | 1 <= v && v <= 6} := ?h_decision10;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := decision6 = (if decision1 >= 1 then decision1 else 1);
def constraint1 : Bool := decision7 = (if decision2 >= decision6 then decision2 else decision6);
def constraint2 : Bool := decision8 = (if decision3 >= decision7 then decision3 else decision7);
def constraint3 : Bool := decision9 = (if decision4 >= decision8 then decision4 else decision8);
def constraint4 : Bool := decision10 = (if decision5 >= decision9 then decision5 else decision9);
def constraint5 : Bool := ((0 - 1) * decision1) != (0 - 1);
def constraint6 : Bool := ((0 - 1) * decision3) != (0 - 1);
def constraint7 : Bool := ((1 * decision2) + ((0 - 1) * decision4)) != 0;
def constraint8 : Bool := ((1 * decision1) + ((0 - 1) * decision5)) != 0;
def constraint9 : Bool := ((1 * decision3) + ((0 - 1) * decision4)) != 0;
def constraint10 : Bool := ((1 * decision4) + ((0 - 1) * decision5)) != 0;
def constraint11 : Bool := ((0 - 1) * decision5) != (0 - 1);
def valid : Bool := ((((constraint0) && ((constraint1) && (constraint2))) && ((constraint3) && ((constraint4) && (constraint5)))) && (((constraint6) && ((constraint7) && (constraint8))) && ((constraint9) && ((constraint10) && (constraint11)))));

def objective : Int := decision10 - 1;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

