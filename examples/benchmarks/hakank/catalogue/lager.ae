def sequence1_tail0 : (Vec Int) := Vec.cons (decision0) (Vec.cons (decision3) (Vec.cons (decision1) (Vec.cons (decision4) (Vec.cons (decision2) (Vec.cons (decision5) (Vec.cons (decision6) (Vec.nil)))))));

