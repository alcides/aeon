# derangement: witness search over the source predicate's 1..5 domain; fixed demonstration removed
# GOAL: Find a permutation of 1..5 with no fixed point.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/minizinc/derangement.mzn
# Generated by scripts/generate_hakank_globals.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def x0 : {v:Int | 1 <= v && v <= 5} := ?h_x0;
def x1 : {v:Int | 1 <= v && v <= 5} := ?h_x1;
def x2 : {v:Int | 1 <= v && v <= 5} := ?h_x2;
def x3 : {v:Int | 1 <= v && v <= 5} := ?h_x3;
def x4 : {v:Int | 1 <= v && v <= 5} := ?h_x4;
def sequence0_tail0 : (Vec Int) := Vec.cons (x0) (Vec.cons (x1) (Vec.cons (x2) (Vec.cons (x3) (Vec.cons (x4) (Vec.nil)))));

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := Vec.allDifferent (sequence0_tail0);
def constraint1 : Bool := x0 != 1;
def constraint2 : Bool := x1 != 2;
def constraint3 : Bool := x2 != 3;
def constraint4 : Bool := x3 != 4;
def constraint5 : Bool := x4 != 5;
def valid : Bool := (((constraint0) && ((constraint1) && (constraint2))) && ((constraint3) && ((constraint4) && (constraint5))));

def objective : Int := 0;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print x0 in
    let report1 := print x1 in
    let report2 := print x2 in
    let report3 := print x3 in
    let report4 := print x4 in
    unit;
