# globalcardinality: five values with frequencies [4,1,0,0,0]
# GOAL: Find a sequence containing four ones, one two, and no values three through five.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/picat/global_cardinality.pi
# Generated by scripts/generate_hakank_globals.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def x0 : {v:Int | 1 <= v && v <= 5} := ?h_x0;
def x1 : {v:Int | 1 <= v && v <= 5} := ?h_x1;
def x2 : {v:Int | 1 <= v && v <= 5} := ?h_x2;
def x3 : {v:Int | 1 <= v && v <= 5} := ?h_x3;
def x4 : {v:Int | 1 <= v && v <= 5} := ?h_x4;
def sequence0_tail0 : (Vec Int) := Vec.cons (x0) (Vec.cons (x1) (Vec.cons (x2) (Vec.cons (x3) (Vec.cons (x4) (Vec.nil)))));

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := Vec.count 1 (sequence0_tail0) = 4;
def constraint1 : Bool := Vec.count 2 (sequence0_tail0) = 1;
def constraint2 : Bool := Vec.count 3 (sequence0_tail0) = 0;
def constraint3 : Bool := Vec.count 4 (sequence0_tail0) = 0;
def constraint4 : Bool := Vec.count 5 (sequence0_tail0) = 0;
def valid : Bool := (((constraint0) && (constraint1)) && ((constraint2) && ((constraint3) && (constraint4))));

def objective : Int := 0;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print x0 in
    let report1 := print x1 in
    let report2 := print x2 in
    let report3 := print x3 in
    let report4 := print x4 in
    unit;
