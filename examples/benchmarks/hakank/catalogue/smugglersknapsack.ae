# smugglers_knapsack: explicit prepared parameters {"reference_invocation": "first_default", "reference_seed": "0"}
# GOAL: Maximize upstream objective within its declared domain.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/cpmpy/smugglers_knapsack.py
# Generated by scripts/import_hakank_flatzinc.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def decision0 : {v:Int | 0 <= v && v <= 9} := ?h_decision0;
def decision1 : {v:Int | 0 <= v && v <= 9} := ?h_decision1;
def decision2 : {v:Int | 0 <= v && v <= 9} := ?h_decision2;
def decision3 : {v:Int | 0 <= v && v <= 288} := ?h_decision3;
def sequence0_tail0 : (Vec Int) := Vec.cons (15) (Vec.cons (10) (Vec.cons (7) (Vec.cons ((0 - 1)) (Vec.nil))));
def sequence1_tail0 : (Vec Int) := Vec.cons (decision0) (Vec.cons (decision1) (Vec.cons (decision2) (Vec.cons (decision3) (Vec.nil))));

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := ((4 * decision0) + ((3 * decision1) + (2 * decision2))) <= 9;
def constraint1 : Bool := Vec.dot (sequence0_tail0) (sequence1_tail0) = 0;
def valid : Bool := ((constraint0) && (constraint1));

def objective : Int := 288 - decision3;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print decision0 in
    let report1 := print decision1 in
    let report2 := print decision2 in
    let report3 := print decision3 in
    unit;
