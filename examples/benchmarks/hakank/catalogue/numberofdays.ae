# Generated by scripts/import_hakank_flatzinc.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def decision0 : {v:Int | 0 <= v && v <= 1} := ?h_decision0;
def decision1 : {v:Int | 0 <= v && v <= 1} := ?h_decision1;
def decision2 : {v:Int | 0 <= v && v <= 1} := ?h_decision2;
def decision3 : {v:Int | 0 <= v && v <= 1} := ?h_decision3;
def decision4 : {v:Int | 0 <= v && v <= 1} := ?h_decision4;
def decision5 : {v:Int | 0 <= v && v <= 11800} := ?h_decision5;
def sequence0_tail0 : (Vec Int) := Vec.cons (1) (Vec.cons ((0 - 1000)) (Vec.cons ((0 - 1200)) (Vec.cons ((0 - 2500)) (Vec.cons ((0 - 3100)) (Vec.cons ((0 - 4000)) (Vec.nil))))));
def sequence1_tail0 : (Vec Int) := Vec.cons (decision5) (Vec.cons (decision0) (Vec.cons (decision1) (Vec.cons (decision2) (Vec.cons (decision3) (Vec.cons (decision4) (Vec.nil))))));
def sequence2_tail0 : (Vec Int) := Vec.cons ((0 - 1)) (Vec.cons ((0 - 2)) (Vec.cons ((0 - 3)) (Vec.cons ((0 - 4)) (Vec.cons ((0 - 7)) (Vec.nil)))));
def sequence3_tail0 : (Vec Int) := Vec.cons (decision0) (Vec.cons (decision1) (Vec.cons (decision2) (Vec.cons (decision3) (Vec.cons (decision4) (Vec.nil)))));

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := Vec.dot (sequence0_tail0) (sequence1_tail0) = 0;
def constraint1 : Bool := Vec.dot (sequence2_tail0) (sequence3_tail0) = (0 - 13);
def valid : Bool := ((constraint0) && (constraint1));

def objective : Int := decision5 - 0;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

