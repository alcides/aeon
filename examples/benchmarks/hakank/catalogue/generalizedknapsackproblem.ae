# generalized_knapsack_problem: explicit prepared parameters {}
# GOAL: Maximize upstream objective within its declared domain.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/minizinc/generalized_knapsack_problem.mzn
# Generated by scripts/import_hakank_flatzinc.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def decision0 : {v:Int | 1 <= v && v <= 3} := ?h_decision0;
def decision1 : {v:Int | 1 <= v && v <= 3} := ?h_decision1;
def decision2 : {v:Int | 1 <= v && v <= 4} := ?h_decision2;
def decision3 : {v:Int | 50 <= v && v <= 235} := ?h_decision3;
def decision4 : {v:Int | 12 <= v && v <= 20} := ?h_decision4;
def decision5 : {v:Int | 0 <= v && v <= 90} := ?h_decision5;
def decision6 : {v:Int | 0 <= v && v <= 50} := ?h_decision6;
def decision7 : {v:Int | 50 <= v && v <= 95} := ?h_decision7;
def sequence0_tail0 : (Vec Int) := Vec.cons (1) (Vec.cons ((0 - 1)) (Vec.cons ((0 - 1)) (Vec.cons ((0 - 1)) (Vec.nil))));
def sequence1_tail0 : (Vec Int) := Vec.cons (decision3) (Vec.cons (decision5) (Vec.cons (decision6) (Vec.cons (decision7) (Vec.nil))));
def sequence2_tail0 : (Vec Int) := Vec.cons (1) (Vec.cons ((0 - 4)) (Vec.cons ((0 - 5)) (Vec.cons ((0 - 3)) (Vec.nil))));
def sequence3_tail0 : (Vec Int) := Vec.cons (decision4) (Vec.cons (decision0) (Vec.cons (decision1) (Vec.cons (decision2) (Vec.nil))));

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := (((decision0 = 1 && decision5 = 45) || (decision0 = 2 && decision5 = 70)) || ((decision0 = 3 && decision5 = 90) || (decision0 = 4 && decision5 = 0)));
def constraint1 : Bool := (((decision1 = 1 && decision6 = 20) || (decision1 = 2 && decision6 = 40)) || ((decision1 = 3 && decision6 = 50) || (decision1 = 4 && decision6 = 0)));
def constraint2 : Bool := (((decision2 = 1 && decision7 = 50) || (decision2 = 2 && decision7 = 70)) || ((decision2 = 3 && decision7 = 85) || (decision2 = 4 && decision7 = 95)));
def constraint3 : Bool := Vec.dot (sequence0_tail0) (sequence1_tail0) = 0;
def constraint4 : Bool := Vec.dot (sequence2_tail0) (sequence3_tail0) = 0;
def valid : Bool := (((constraint0) && (constraint1)) && ((constraint2) && ((constraint3) && (constraint4))));

def objective : Int := 235 - decision3;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

