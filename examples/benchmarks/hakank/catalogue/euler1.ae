# euler1: sum multiples of 3 or 5 below 1000
# GOAL: Synthesize the sum of every natural number below 1000 divisible by 3 or 5.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/minizinc/euler_1.mzn
# Generated by scripts/generate_hakank_algorithmic.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;


def sumMultiples (limit:Int) (start:Int) (stride:Int) : Int :=
    if start >= limit then 0
    else if stride >= limit then
        if start % 3 = 0 || start % 5 = 0 then start else 0
    else (sumMultiples limit start (stride * 2)) +
         (sumMultiples limit (start + stride) (stride * 2));

def answer : {v:Int | 0 <= v && v <= 1000000} := ?h_answer;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := answer = sumMultiples 1000 0 1;
def valid : Bool := (constraint0);

def objective : Int := 0;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print answer in
    unit;
