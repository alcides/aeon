# volsay2: explicit prepared parameters {}
# GOAL: Maximize upstream objective within its declared domain.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/minizinc/volsay2.mzn
# Generated by scripts/import_hakank_flatzinc.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def decision0 : {v:Float | 0.0 <= v && v <= 100.0} := ?h_decision0;
def decision1 : {v:Float | 0.0 <= v && v <= 40.0} := ?h_decision1;
def decision2 : {v:Float | 0.0 <= v && v <= 9000.0} := ?h_decision2;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := ((1.0 * decision0) + (1.0 * decision1)) <= 50.0;
def constraint1 : Bool := ((3.0 * decision0) + (4.0 * decision1)) <= 180.0;
def constraint2 : Bool := ((40.0 * decision0) + ((50.0 * decision1) + ((0.0 - 1.0) * decision2))) = -0.0;
def valid : Bool := ((constraint0) && ((constraint1) && (constraint2)));

def objective : Float := 9000.0 - decision2;
def score : Float := objective;

@require(valid)
@minimize_float(score)
def benchmark : Float := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print decision0 in
    let report1 := print decision1 in
    let report2 := print decision2 in
    unit;
