import Vec;

def decision0 : {v:Float | 0.0 <= v && v <= 1000.0} := ?h_decision0;
def decision1 : {v:Float | 0.0 <= v && v <= 1000.0} := ?h_decision1;
def decision2 : {v:Float | 0.0 <= v && v <= 1000.0} := ?h_decision2;
def decision3 : {v:Float | 0.0 <= v && v <= 1000.0} := ?h_decision3;
def decision4 : {v:Float | 0.0 <= v && v <= 1000.0} := ?h_decision4;
def decision5 : {v:Float | 0.0 <= v && v <= 1000.0} := ?h_decision5;
def decision6 : {v:Float | 0.0 <= v && v <= 1053.0} := ?h_decision6;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := ((1.0 * decision0) + ((1.0 * decision1) + (1.0 * decision2))) <= 350.0;
def constraint1 : Bool := ((1.0 * decision3) + ((1.0 * decision4) + (1.0 * decision5))) <= 600.0;
def constraint2 : Bool := (((0.0 - 1.0) * decision0) + ((0.0 - 1.0) * decision3)) <= (0.0 - 325.0);
def constraint3 : Bool := (((0.0 - 1.0) * decision1) + ((0.0 - 1.0) * decision4)) <= (0.0 - 300.0);
def constraint4 : Bool := (((0.0 - 1.0) * decision2) + ((0.0 - 1.0) * decision5)) <= (0.0 - 275.0);
def constraint5 : Bool := (((0.225 * decision0) + ((0.153 * decision1) + (0.162 * decision2))) + (((0.225 * decision3) + (0.162 * decision4)) + ((0.126 * decision5) + ((0.0 - 1.0) * decision6)))) = -0.0;
def valid : Bool := (((constraint0) && ((constraint1) && (constraint2))) && ((constraint3) && ((constraint4) && (constraint5))));

def objective : Float := decision6 - 0.0;
def score : Float := objective;

@require(valid)
@minimize_float(score)
def benchmark : Float := score;

