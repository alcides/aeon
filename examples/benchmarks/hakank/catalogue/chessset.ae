# chess_set: explicit prepared parameters {}
# GOAL: Maximize upstream objective within its declared domain.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/minizinc/chessset.mzn
# Generated by scripts/import_hakank_flatzinc.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def decision0 : {v:Int | 0 <= v && v <= 53} := ?h_decision0;
def decision1 : {v:Int | 0 <= v && v <= 66} := ?h_decision1;
def decision2 : {v:Int | 0 <= v && v <= 1585} := ?h_decision2;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := ((1 * decision0) + (3 * decision1)) <= 200;
def constraint1 : Bool := ((3 * decision0) + (2 * decision1)) <= 160;
def constraint2 : Bool := 0 <= decision0;
def constraint3 : Bool := 0 <= decision1;
def constraint4 : Bool := ((5 * decision0) + ((20 * decision1) + ((0 - 1) * decision2))) = 0;
def valid : Bool := (((constraint0) && (constraint1)) && ((constraint2) && ((constraint3) && (constraint4))));

def objective : Int := 1585 - decision2;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print decision0 in
    let report1 := print decision1 in
    let report2 := print decision2 in
    unit;
