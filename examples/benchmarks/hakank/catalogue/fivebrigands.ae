def decision1 : {v:Int | 8 <= v && v <= 160} := ?h_decision1;
def decision2 : {v:Int | 8 <= v && v <= 160} := ?h_decision2;
def decision3 : {v:Int | 8 <= v && v <= 100} := ?h_decision3;
def decision4 : {v:Int | 8 <= v && v <= 66} := ?h_decision4;
def sequence0_tail0 : (Vec Int) := Vec.cons (1) (Vec.cons (1) (Vec.cons (1) (Vec.cons (2) (Vec.cons (3) (Vec.nil)))));
