# all_interval: series of size 5 (reduced instance)
# GOAL: Find a feasible assignment (score 0).
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/cpmpy/all_interval.py
# Generated by scripts/generate_hakank_examples.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def x0 : {v:Int | 1 <= v && v <= 5} := ?h_x0;
def x1 : {v:Int | 1 <= v && v <= 5} := ?h_x1;
def x2 : {v:Int | 1 <= v && v <= 5} := ?h_x2;
def x3 : {v:Int | 1 <= v && v <= 5} := ?h_x3;
def x4 : {v:Int | 1 <= v && v <= 5} := ?h_x4;
def d0 : {v:Int | 1 <= v && v <= 4} := ?h_d0;
def d1 : {v:Int | 1 <= v && v <= 4} := ?h_d1;
def d2 : {v:Int | 1 <= v && v <= 4} := ?h_d2;
def d3 : {v:Int | 1 <= v && v <= 4} := ?h_d3;
def sequence0_tail0 : (Vec Int) := Vec.cons (x0) (Vec.cons (x1) (Vec.cons (x2) (Vec.cons (x3) (Vec.cons (x4) (Vec.nil)))));
def sequence1_tail0 : (Vec Int) := Vec.cons (d0) (Vec.cons (d1) (Vec.cons (d2) (Vec.cons (d3) (Vec.nil))));

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := Vec.allDifferent (sequence0_tail0);
def constraint1 : Bool := Vec.allDifferent (sequence1_tail0);
def constraint2 : Bool := d0 = x1 - x0 || d0 = x0 - x1;
def constraint3 : Bool := d1 = x2 - x1 || d1 = x1 - x2;
def constraint4 : Bool := d2 = x3 - x2 || d2 = x2 - x3;
def constraint5 : Bool := d3 = x4 - x3 || d3 = x3 - x4;
def constraint6 : Bool := x0 < x4;
def constraint7 : Bool := d0 < d1;
def valid : Bool := ((((constraint0) && (constraint1)) && ((constraint2) && (constraint3))) && (((constraint4) && (constraint5)) && ((constraint6) && (constraint7))));

def objective : Int := 0;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print x0 in
    let report1 := print x1 in
    let report2 := print x2 in
    let report3 := print x3 in
    let report4 := print x4 in
    let report5 := print d0 in
    let report6 := print d1 in
    let report7 := print d2 in
    let report8 := print d3 in
    unit;
