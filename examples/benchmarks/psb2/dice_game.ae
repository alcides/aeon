# PSB2: dice-game
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/dice_game.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "dice-game" 200;

def score (cases:Cases) (candidate:(n:{v:Int | 1 <= v && v <= 1000}) -> (m:{v:Int | 1 <= v && v <= 1000}) -> {r:Float | 0.0 <= r && r < 1.0}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('dice-game', cases(None), candidate)";

def dice_game (n:{v:Int | 1 <= v && v <= 1000}) (m:{v:Int | 1 <= v && v <= 1000}) : Float :=
    if n <= m then
        let denominator := Math.toFloat (2 * m) in if denominator = 0.0 then 0.0 else Math.toFloat (n - 1) / denominator
    else let denominator := Math.toFloat (2 * n) in if denominator = 0.0 then 0.0 else 1.0 - Math.toFloat (m + 1) / denominator;

@doc("Return the probability that an n-sided die rolls strictly above an m-sided die.")
@minimize_float(PSB2Fitness.meanError (score train synth))
def synth (n:{v:Int | 1 <= v && v <= 1000}) (m:{v:Int | 1 <= v && v <= 1000}) : {r:Float | 0.0 <= r && r < 1.0} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    let dice_game := unit in
    ?hole;
