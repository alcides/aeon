# PSB2: square-digits
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/square_digits.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "square-digits" 200;

def score (cases:Cases) (candidate:(n:{v:Int | 0 <= v && v <= 1000000}) -> {r:String | 1 <= String.len r && String.len r <= 14 && (n != 0 || r = "0")}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('square-digits', cases(None), candidate)";

def square_digit_unsafe (n:{v:Int | 0 <= v && v <= 1000000}) : String :=
    String.joinList "" (List.map (fun c => let digit := String.stringToInt c in String.intToString (digit * digit)) (String.characters (String.intToString n)));

@doc("Square each decimal digit and concatenate the results, including a zero input.")
@minimize_float(PSB2Fitness.meanError (score train synth_sd))
def synth_sd (n:{v:Int | 0 <= v && v <= 1000000}) : {r:String | 1 <= String.len r && String.len r <= 14 && (n != 0 || r = "0")} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    let square_digit_unsafe := unit in
    ?hole;
