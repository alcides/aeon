# PSB2: bowling
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/bowling.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "bowling" 200;

def score (cases:Cases) (candidate:(scores:{v:String | 12 <= String.len v && String.len v <= 21}) -> {v:Int | 0 <= v && v <= 300}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('bowling', cases(None), candidate)";

@doc("Score ten valid bowling frames, including strike and spare bonuses.")
@multi_minimize_float(PSB2Fitness.per_example_errors (score train synth), 200)
def synth (scores:{v:String | 12 <= String.len v && String.len v <= 21}) : {v:Int | 0 <= v && v <= 300} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
