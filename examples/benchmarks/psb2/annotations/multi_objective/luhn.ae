# PSB2: luhn
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/luhn.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "luhn" 200;

def score (cases:Cases) (candidate:(digits:{v:(List Int){|fun x => 0 <= x && x <= 9|} | 16 <= List.size v && List.size v <= 16}) -> {v:Int | 0 <= v && v <= 144}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('luhn', cases(None), candidate)";

@doc("Sum sixteen Luhn-transformed digits, doubling the digit at index zero and every other digit.")
@multi_minimize_float(PSB2Fitness.per_example_errors (score train synth), 200)
def synth (digits:{v:(List Int){|fun x => 0 <= x && x <= 9|} | 16 <= List.size v && List.size v <= 16}) : {v:Int | 0 <= v && v <= 144} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
