# PSB2: fuel-cost
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/fuel_cost.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "fuel-cost" 200;

def score (cases:Cases) (candidate:(xs:{v:(List Int){|fun x => 6 <= x && x <= 10000|} | 1 <= List.size v && List.size v <= 20}) -> {r:Int | 0 <= r && r <= 3331 * List.size xs}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('fuel-cost', cases(None), candidate)";

@doc("Sum floor(mass / 3) - 2 over the input masses.")
@multi_minimize_float(PSB2Fitness.per_example_errors (score train synth), 200)
def synth (xs:{v:(List Int){|fun x => 6 <= x && x <= 10000|} | 1 <= List.size v && List.size v <= 20}) : {r:Int | 0 <= r && r <= 3331 * List.size xs} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
