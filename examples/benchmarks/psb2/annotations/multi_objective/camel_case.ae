# PSB2: camel-case
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/camel_case.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "camel-case" 200;

def score (cases:Cases) (candidate:(s:String) -> {r:String | String.len r <= String.len s}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('camel-case', cases(None), candidate)";

@doc("Remove hyphens and capitalize the following word fragments; lower-case the first result character.")
@multi_minimize_float(PSB2Fitness.per_example_errors (score train synth), 200)
def synth (s:String) : {r:String | String.len r <= String.len s} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
