# PSB2: basement
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/basement.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "basement" 200;

def score (cases:Cases) (candidate:(nums:{v:(List Int){|fun x => (-100) <= x && x <= 100|} | 1 <= List.size v && List.size v <= 20}) -> {r:Int | 0 <= r && r < List.size nums}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('basement', cases(None), candidate)";

@doc("Find the first index whose inclusive prefix sum is negative; PSB2 inputs guarantee such an index.")
@multi_minimize_float(PSB2Fitness.per_example_errors (score train synth), 200)
def synth (nums:{v:(List Int){|fun x => (-100) <= x && x <= 100|} | 1 <= List.size v && List.size v <= 20}) : {r:Int | 0 <= r && r < List.size nums} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
