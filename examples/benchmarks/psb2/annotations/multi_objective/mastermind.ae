# PSB2: mastermind
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/mastermind.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "mastermind" 200;

def score (cases:Cases) (candidate:(code:{v:String | String.len v = 4}) -> (guess:{v:String | String.len v = 4}) -> {r:(List Int) | List.size r = 2 && 0 <= (List.first r) && 0 <= (List.first (List.rest r)) && (List.first r) + (List.first (List.rest r)) <= 4}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('mastermind', cases(None), candidate)";

@doc("Return white then black peg counts, counting duplicate colors only as many times as they occur.")
@multi_minimize_float(PSB2Fitness.per_example_errors (score train synth), 200)
def synth (code:{v:String | String.len v = 4}) (guess:{v:String | String.len v = 4}) : {r:(List Int) | List.size r = 2 && 0 <= (List.first r) && 0 <= (List.first (List.rest r)) && (List.first r) + (List.first (List.rest r)) <= 4} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
