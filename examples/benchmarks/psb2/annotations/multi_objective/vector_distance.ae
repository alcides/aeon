# PSB2: vector-distance
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/vector_distance.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "vector-distance" 200;

def score (cases:Cases) (candidate:(vector1:{v:(List Float){|fun x => (-100.0) <= x && x <= 100.0|} | 1 <= List.size v && List.size v <= 20}) -> (vector2:{v:(List Float){|fun x => (-100.0) <= x && x <= 100.0|} | List.size v = List.size vector1}) -> {r:Float | 0.0 <= r && r <= 1000.0}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('vector-distance', cases(None), candidate)";

@doc("Compute Euclidean distance between equally sized floating-point vectors.")
@multi_minimize_float(PSB2Fitness.per_example_errors (score train synth), 200)
def synth (vector1:{v:(List Float){|fun x => (-100.0) <= x && x <= 100.0|} | 1 <= List.size v && List.size v <= 20}) (vector2:{v:(List Float){|fun x => (-100.0) <= x && x <= 100.0|} | List.size v = List.size vector1}) : {r:Float | 0.0 <= r && r <= 1000.0} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
