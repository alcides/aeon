# PSB2: shopping-list
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/shopping_list.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "shopping-list" 200;

def score (cases:Cases) (candidate:(prices:{v:(List Float){|fun x => 0.0 <= x && x <= 50.0|} | 1 <= List.size v && List.size v <= 20}) -> (discounts:{v:(List Float){|fun x => 0.0 <= x && x <= 100.0|} | List.size v = List.size prices}) -> {r:Float | 0.0 <= r && r <= 1000.0}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('shopping-list', cases(None), candidate)";

@doc("Apply percentage discounts to prices, sum the costs, and round the total to two decimal places.")
@multi_minimize_float(PSB2Fitness.per_example_errors (score train synth), 200)
def synth (prices:{v:(List Float){|fun x => 0.0 <= x && x <= 50.0|} | 1 <= List.size v && List.size v <= 20}) (discounts:{v:(List Float){|fun x => 0.0 <= x && x <= 100.0|} | List.size v = List.size prices}) : {r:Float | 0.0 <= r && r <= 1000.0} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
