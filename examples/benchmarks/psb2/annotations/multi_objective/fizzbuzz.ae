# PSB2: fizz-buzz
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/fizz_buzz.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "fizz-buzz" 200;

def score (cases:Cases) (candidate:(n:{v:Int | 1 <= v && v <= 1000000}) -> {r:String | 1 <= String.len r && String.len r <= 8}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('fizz-buzz', cases(None), candidate)";

@doc("Return Fizz, Buzz, FizzBuzz, or the decimal input according to divisibility by three and five.")
@multi_minimize_float(PSB2Fitness.per_example_errors (score train synth), 200)
def synth (n:{v:Int | 1 <= v && v <= 1000000}) : {r:String | 1 <= String.len r && String.len r <= 8} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
