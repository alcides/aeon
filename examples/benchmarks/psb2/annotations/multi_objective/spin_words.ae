import PSB2Fitness (per_example_errors)
import PSB2 (training_data, fresh_train_data, extract_train_data, get_input_list, get_output_list, calculate_str_list_errors, get_sw_synth_values, unpack_train_data, load_dataset)
import Array
def String_len : (i:String) -> Int := fun i => native "len(i)"
def String_list_to_String : (1 l:(Array Int)) -> String := fun l => native "' '.join(l)"
def map_String_String_List : (function:(a: String) -> String) -> (1 l: (Array Int)) -> (Array Int) := fun f => fun xs => native "map(f, xs)"
def String_split : (i:String) -> (j:String) -> (Array Int) := fun i => fun j => native "i.split(j)"
def String_reverse : (i:String) -> String := fun i => native "i[::-1]"

def train : TrainingCases := training_data "spin-words" 200 200

def calculate_spin_words_errors : (1 train:TrainData) -> (f:(a: String) -> String)  -> (Array Int)  :=  fun data => fun func => native "[__import__('textdistance').levenshtein(func(x[0]), y[0]) for x , y in data]"

@multi_minimize_float(per_example_errors (calculate_spin_words_errors (fresh_train_data train) synth), 200)
def synth (phrase: String) : String := (let extract_train_data := unit in let unpack_train_data := unit in let load_dataset := unit in let calculate_spin_words_errors := unit in let train := unit in ?hole)
