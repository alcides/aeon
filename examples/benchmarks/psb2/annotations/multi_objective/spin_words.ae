# PSB2: spin-words
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/spin_words.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "spin-words" 200;

def score (cases:Cases) (candidate:(phrase:String) -> {r:String | String.len r = String.len phrase}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('spin-words', cases(None), candidate)";

@doc("Reverse words of at least five characters, keeping other words and spaces in place.")
@multi_minimize_float(PSB2Fitness.per_example_errors (score train synth), 200)
def synth (phrase:String) : {r:String | String.len r = String.len phrase} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
