# PSB2: substitution-cipher
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/substitution_cipher.clj

import List
import Math
import String
import Map
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "substitution-cipher" 200;

def score (cases:Cases) (candidate:(cipher_from:{v:String | String.len v <= 26}) -> (cipher_to:{v:String | String.len v = String.len cipher_from}) -> (message:{v:String | String.len v <= 26}) -> {r:String | String.len r = String.len message}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('substitution-cipher', cases(None), candidate)";

@doc("Substitute message characters using the equally sized source and destination alphabets; message characters belong to the source alphabet.")
@multi_minimize_float(PSB2Fitness.per_example_errors (score train synth), 200)
def synth (cipher_from:{v:String | String.len v <= 26}) (cipher_to:{v:String | String.len v = String.len cipher_from}) (message:{v:String | String.len v <= 26}) : {r:String | String.len r = String.len message} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
