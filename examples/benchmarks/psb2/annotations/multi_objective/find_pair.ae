# PSB2: find-pair
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/find_pair.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "find-pair" 200;

def score (cases:Cases) (candidate:(numbers:{v:(List Int){|fun x => (-10000) <= x && x <= 10000|} | 2 <= List.size v && List.size v <= 20}) -> (target:{v:Int | (-20000) <= v && v <= 20000}) -> {r:(List Int) | List.size r = 2 && (List.first r) + (List.first (List.rest r)) = target && (List.first r) != (List.first (List.rest r))}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('find-pair', cases(None), candidate)";

@doc("Find the two distinct input values that sum to the target; PSB2 guarantees a unique pair.")
@multi_minimize_float(PSB2Fitness.per_example_errors (score train synth), 200)
def synth (numbers:{v:(List Int){|fun x => (-10000) <= x && x <= 10000|} | 2 <= List.size v && List.size v <= 20}) (target:{v:Int | (-20000) <= v && v <= 20000}) : {r:(List Int) | List.size r = 2 && (List.first r) + (List.first (List.rest r)) = target && (List.first r) != (List.first (List.rest r))} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
