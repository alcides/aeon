import PSB2Fitness (per_example_errors)
import Array
open Math
import PSB2 (training_data, fresh_train_data, extract_train_data, load_dataset , objective_errors)

def isZero : (n: Int) -> Bool := fun n => n = 0;

def train : TrainingCases := training_data "snow-day" 200 200
def calculate_snow_day_errors : (1 train:TrainData) -> (f:(a: Int) -> (b: Float) -> (c: Float) -> (d: Float) -> Float)  -> (Array Int)  :=  fun data => fun func => native "[abs(func(x[0])(x[1])(x[2])(x[3]) - y[0]) for x , y in data]"


@multi_minimize_float(per_example_errors (calculate_snow_day_errors (fresh_train_data train) synth), 200)
def synth ( n :Int) (m :Float) (t :Float) (p :Float) : Float := (let extract_train_data := unit in let load_dataset := unit in let train := unit in let calculate_snow_day_errors := unit in ?hole)
