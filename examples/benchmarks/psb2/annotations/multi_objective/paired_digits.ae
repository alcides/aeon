# PSB2: paired-digits
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/paired_digits.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "paired-digits" 200;

def score (cases:Cases) (candidate:(nums:{v:String | 2 <= String.len v && String.len v <= 20}) -> {r:Int | 0 <= r && r <= 9 * (String.len nums - 1)}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('paired-digits', cases(None), candidate)";

@doc("Sum each decimal digit that equals the following digit; there is no wraparound.")
@multi_minimize_float(PSB2Fitness.per_example_errors (score train synth), 200)
def synth (nums:{v:String | 2 <= String.len v && String.len v <= 20}) : {r:Int | 0 <= r && r <= 9 * (String.len nums - 1)} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
