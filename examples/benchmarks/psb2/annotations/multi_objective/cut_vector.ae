# PSB2: cut-vector
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/cut_vector.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "cut-vector" 200;

def score (cases:Cases) (candidate:(xs:{v:(List Int){|fun x => 0 <= x && x <= 10000|} | 1 <= List.size v && List.size v <= 20}) -> {r:(List (List Int)) | List.size r = 2 && List.size (List.first r) + List.size (List.first (List.rest r)) = List.size xs}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('cut-vector', cases(None), candidate)";

@doc("Split a vector into two parts with the closest sums; match PSB2 tie-breaking.")
@multi_minimize_float(PSB2Fitness.per_example_errors (score train cut_vector), 200)
def cut_vector (xs:{v:(List Int){|fun x => 0 <= x && x <= 10000|} | 1 <= List.size v && List.size v <= 20}) : {r:(List (List Int)) | List.size r = 2 && List.size (List.first r) + List.size (List.first (List.rest r)) = List.size xs} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
