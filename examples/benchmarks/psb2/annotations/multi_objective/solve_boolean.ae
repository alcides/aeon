# PSB2: solve-boolean
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/solve_boolean.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "solve-boolean" 200;

def score (cases:Cases) (candidate:(s:{v:String | 1 <= String.len v && String.len v <= 39 && String.len v % 2 = 1}) -> Bool) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('solve-boolean', cases(None), candidate)";

@doc("Evaluate a valid t/f expression with & and | strictly from left to right.")
@multi_minimize_float(PSB2Fitness.per_example_errors (score train synth), 200)
def synth (s:{v:String | 1 <= String.len v && String.len v <= 39 && String.len v % 2 = 1}) : Bool :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
