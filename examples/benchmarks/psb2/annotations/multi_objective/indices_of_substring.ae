# PSB2: indices-of-substring
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/indices_of_substring.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "indices-of-substring" 200;

def score (cases:Cases) (candidate:(text:{v:String | 1 <= String.len v && String.len v <= 20}) -> (target:{v:String | 1 <= String.len v && String.len v <= 20}) -> {r:(List Int){|fun i => 0 <= i && i + String.len target <= String.len text|} | List.size r <= String.len text}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('indices-of-substring', cases(None), candidate)";

@doc("Return all starting indices of a substring, including overlapping matches.")
@multi_minimize_float(PSB2Fitness.per_example_errors (score train synth), 200)
def synth (text:{v:String | 1 <= String.len v && String.len v <= 20}) (target:{v:String | 1 <= String.len v && String.len v <= 20}) : {r:(List Int){|fun i => 0 <= i && i + String.len target <= String.len text|} | List.size r <= String.len text} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
