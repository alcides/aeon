# PSB2: twitter
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/twitter.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "twitter" 200;

def score (cases:Cases) (candidate:(tweet:{v:String | String.len v <= 200}) -> {r:String | (String.len tweet = 0 && r = "You didn't type anything") || (String.len tweet > 140 && r = "Too many characters") || (0 < String.len tweet && String.len tweet <= 140 && 27 <= String.len r && String.len r <= 29)}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('twitter', cases(None), candidate)";

@doc("Report an empty or overlong tweet, otherwise include its character count in the confirmation.")
@minimize_float(PSB2Fitness.meanError (score train synth))
def synth (tweet:{v:String | String.len v <= 200}) : {r:String | (String.len tweet = 0 && r = "You didn't type anything") || (String.len tweet > 140 && r = "Too many characters") || (0 < String.len tweet && String.len tweet <= 140 && 27 <= String.len r && String.len r <= 29)} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
