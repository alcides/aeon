# PSB2: middle-character
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/middle_character.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "middle-character" 200;

def score (cases:Cases) (candidate:(s:{v:String | 1 <= String.len v && String.len v <= 100}) -> {r:String | (String.len s % 2 = 0 && String.len r = 2) || (String.len s % 2 != 0 && String.len r = 1)}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('middle-character', cases(None), candidate)";

@doc("Return the central character, or the central two characters for even lengths.")
@minimize_float(PSB2Fitness.meanError (score train synth))
def synth (s:{v:String | 1 <= String.len v && String.len v <= 100}) : {r:String | (String.len s % 2 = 0 && String.len r = 2) || (String.len s % 2 != 0 && String.len r = 1)} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
