# PSB2: gcd
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/gcd.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "gcd" 200;

def score (cases:Cases) (candidate:(n:{v:Int | 1 <= v && v <= 1000000}) -> (z:{v:Int | 1 <= v && v <= 1000000}) -> {r:Int | 1 <= r && r <= n && r <= z && n % r = 0 && z % r = 0}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('gcd', cases(None), candidate)";

@doc("Find the greatest common divisor of two positive integers.")
@minimize_float(PSB2Fitness.meanError (score train synth))
def synth (n:{v:Int | 1 <= v && v <= 1000000}) (z:{v:Int | 1 <= v && v <= 1000000}) : {r:Int | 1 <= r && r <= n && r <= z && n % r = 0 && z % r = 0} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    let Math_gcd := unit in
    ?hole;
