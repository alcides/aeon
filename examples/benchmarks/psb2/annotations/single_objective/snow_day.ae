# PSB2: snow-day
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/snow_day.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "snow-day" 200;

def score (cases:Cases) (candidate:(hours:{v:Int | 0 <= v && v <= 20}) -> (snow:{v:Float | 0.0 <= v && v <= 20.0}) -> (snowfall:{v:Float | 0.0 <= v}) -> (melt:{v:Float | 0.0 <= v && v <= 1.0}) -> {r:Float | 0.0 <= r && (hours != 0 || r = snow)}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('snow-day', cases(None), candidate)";

@doc("Each hour, melt the given fraction of existing snow and then add fresh snowfall.")
@minimize_float(PSB2Fitness.meanError (score train synth))
def synth (hours:{v:Int | 0 <= v && v <= 20}) (snow:{v:Float | 0.0 <= v && v <= 20.0}) (snowfall:{v:Float | 0.0 <= v}) (melt:{v:Float | 0.0 <= v && v <= 1.0}) : {r:Float | 0.0 <= r && (hours != 0 || r = snow)} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
