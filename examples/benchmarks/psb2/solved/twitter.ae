# PSB2: twitter
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/twitter.clj

import List
import Math
import String

@doc("Report an empty or overlong tweet, otherwise include its character count in the confirmation.")
def twitter (tweet:{v:String | String.len v <= 200}) : String :=
    if String.len tweet = 0 then "You didn't type anything" else if String.len tweet > 140 then "Too many characters" else
    String.concat (String.concat "Your tweet has " (String.intToString (String.len tweet))) " characters";
