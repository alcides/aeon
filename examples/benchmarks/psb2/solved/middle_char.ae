# PSB2: middle-character
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/middle_character.clj

import List
import Math
import String

@doc("Return the central character, or the central two characters for even lengths.")
def middle_char (s:{v:String | 1 <= String.len v && String.len v <= 100}) : String :=
    if String.len s % 2 = 0 then String.substr s (Math.floor_division (String.len s) 2 - 1) 2 else String.charAt s (Math.floor_division (String.len s) 2);
