# PSB2: paired-digits
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/paired_digits.clj

import List
import Math
import String

@doc("Sum each decimal digit that equals the following digit; there is no wraparound.")
def paired_digits (nums:{v:String | 2 <= String.len v && String.len v <= 20}) : Int :=
    let digits := String.characters nums in
    List.sum (List.zipWith (fun a => fun b => if a = b then String.stringToInt a else 0) digits (List.drop 1 digits));
