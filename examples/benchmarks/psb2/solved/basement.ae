# PSB2: basement
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/basement.clj

import List
import Math
import String

def basement_go (xs:(List Int)) (total:Int) (index:Int) : Int :=
    match xs with | List.nil => (-1) | List.cons x rest =>
        if total + x < 0 then index else basement_go rest (total + x) (index + 1);

@doc("Find the first index whose inclusive prefix sum is negative; PSB2 inputs guarantee such an index.")
def basement (nums:{v:(List Int){|fun x => (-100) <= x && x <= 100|} | 1 <= List.size v && List.size v <= 20}) : Int :=
    basement_go nums 0 0;
