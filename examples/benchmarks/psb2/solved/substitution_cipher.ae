# PSB2: substitution-cipher
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/substitution_cipher.clj

import List
import Math
import String
import Map

def cipher_table (xs:(List String)) (ys:(List String)) (table:(Map String String)) : (Map String String) :=
    match xs with | List.nil => table | List.cons x rest =>
        match ys with | List.nil => table | List.cons y tail => cipher_table rest tail (Map.set table x y);

@doc("Substitute message characters using the equally sized source and destination alphabets; message characters belong to the source alphabet.")
def substitution_cipher (cipher_from:{v:String | String.len v <= 26}) (cipher_to:{v:String | String.len v = String.len cipher_from}) (message:{v:String | String.len v <= 26}) : String :=
    let table := cipher_table (String.characters cipher_from) (String.characters cipher_to) (Map.new : (Map String String)) in
    String.joinList "" (List.map (fun c => Map.get_or table c "") (String.characters message));
