# PSB2: coin-sums
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/coin_sums.clj

import List
import Math
import String

@doc("Return minimal coin counts in penny, nickel, dime, quarter order.")
def coin_sum (cents:{v:Int | 1 <= v && v <= 10000}) : (List Int) :=
    [cents % 5, Math.floor_division (cents % 25 % 10) 5, Math.floor_division (cents % 25) 10, Math.floor_division cents 25];
