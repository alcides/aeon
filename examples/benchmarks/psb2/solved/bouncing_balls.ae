# PSB2: bouncing-balls
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/bouncing_balls.clj

import List
import Math
import String

def bounce_go (height:Float) (bounce:Float) (ratio:Float) (remaining:Int) (distance:Float) : Float :=
    if remaining <= 0 then distance else
        bounce_go bounce (bounce * ratio) ratio (remaining - 1) (distance + height + bounce);

@doc("Accumulate the downward and upward travel for the requested number of bounces.")
def bouncing_balls (starting_height:{v:Float | 1.0 <= v && v <= 100.0}) (bounce_height:{v:Float | 1.0 <= v && v < starting_height}) (bounces:{v:Int | 1 <= v && v <= 20}) : Float :=
    bounce_go starting_height bounce_height (bounce_height / starting_height) bounces 0.0;
