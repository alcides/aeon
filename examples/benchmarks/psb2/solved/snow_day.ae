# PSB2: snow-day
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/snow_day.clj

import List
import Math
import String

def snow_go (remaining:Int) (snow:Float) (snowfall:Float) (melt:Float) : Float :=
    if remaining <= 0 then snow else snow_go (remaining - 1) (snow * (1.0 - melt) + snowfall) snowfall melt;

@doc("Each hour, melt the given fraction of existing snow and then add fresh snowfall.")
def snow_day (hours:{v:Int | 0 <= v && v <= 20}) (snow:{v:Float | 0.0 <= v && v <= 20.0}) (snowfall:{v:Float | 0.0 <= v}) (melt:{v:Float | 0.0 <= v && v <= 1.0}) : Float :=
    snow_go hours snow snowfall melt;
