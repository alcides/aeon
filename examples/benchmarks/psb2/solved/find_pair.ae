# PSB2: find-pair
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/find_pair.clj

import List
import Math
import String

def find_pair_go (xs:(List Int)) (target:Int) : (List Int) :=
    match xs with | List.nil => [] | List.cons x rest =>
        match List.filter (fun y => x + y = target) rest with
        | List.nil => find_pair_go rest target
        | List.cons y tail => [x, y];

@doc("Find the two distinct input values that sum to the target; PSB2 guarantees a unique pair.")
def find_pair (numbers:{v:(List Int){|fun x => (-10000) <= x && x <= 10000|} | 2 <= List.size v && List.size v <= 20}) (target:{v:Int | (-20000) <= v && v <= 20000}) : (List Int) :=
    find_pair_go numbers target;
