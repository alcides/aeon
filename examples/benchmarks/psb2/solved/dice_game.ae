# PSB2: dice-game
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/dice_game.clj

import List
import Math
import String

@doc("Return the probability that an n-sided die rolls strictly above an m-sided die.")
def dice_game (n:{v:Int | 1 <= v && v <= 1000}) (m:{v:Int | 1 <= v && v <= 1000}) : Float :=
    if n <= m then
        let denominator := Math.toFloat (2 * m) in if denominator = 0.0 then 0.0 else Math.toFloat (n - 1) / denominator
    else let denominator := Math.toFloat (2 * n) in if denominator = 0.0 then 0.0 else 1.0 - Math.toFloat (m + 1) / denominator;
