# PSB2: shopping-list
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/shopping_list.clj

import List
import Math
import String

@doc("Apply percentage discounts to prices, sum the costs, and round the total to two decimal places.")
def shopping (prices:{v:(List Float){|fun x => 0.0 <= x && x <= 50.0|} | 1 <= List.size v && List.size v <= 20}) (discounts:{v:(List Float){|fun x => 0.0 <= x && x <= 100.0|} | List.size v = List.size prices}) : Float :=
    let total := List.sumFloat (List.zipWith (fun price => fun discount => price * ((100.0 - discount) / 100.0)) prices discounts) in
    Math.toFloat (Math.floor (total * 100.0 + 0.5)) / 100.0;
