# PSB2: luhn
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/luhn.clj

import List
import Math
import String

def luhn_go (xs:(List Int)) (double:Bool) : Int :=
    match xs with | List.nil => 0 | List.cons x rest =>
        (if double then (if x * 2 > 9 then x * 2 - 9 else x * 2) else x) + luhn_go rest (!double);

@doc("Sum sixteen Luhn-transformed digits, doubling the digit at index zero and every other digit.")
def luhn (digits:{v:(List Int){|fun x => 0 <= x && x <= 9|} | 16 <= List.size v && List.size v <= 16}) : Int :=
    luhn_go digits true;
