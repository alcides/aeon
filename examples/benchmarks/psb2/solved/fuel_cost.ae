# PSB2: fuel-cost
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/fuel_cost.clj

import List
import Math
import String

@doc("Sum floor(mass / 3) - 2 over the input masses.")
def fuel_cost (xs:{v:(List Int){|fun x => 6 <= x && x <= 10000|} | 1 <= List.size v && List.size v <= 20}) : Int :=
    List.sum (List.map (fun mass => Math.floor_division mass 3 - 2) xs);
