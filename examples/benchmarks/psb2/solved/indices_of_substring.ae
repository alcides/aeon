# PSB2: indices-of-substring
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/indices_of_substring.clj

import List
import Math
import String

@doc("Return all starting indices of a substring, including overlapping matches.")
def indices_of_substring (text:{v:String | 1 <= String.len v && String.len v <= 20}) (target:{v:String | 1 <= String.len v && String.len v <= 20}) : (List Int) :=
    List.filter (fun i => String.substr text i (String.len target) = target) (List.range 0 (String.len text));
