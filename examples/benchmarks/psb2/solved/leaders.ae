# PSB2: leaders
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/leaders.clj

import List
import Math
import String

def leaders_go (xs:(List Int)) : (List Int) :=
    match xs with | List.nil => [] | List.cons x rest =>
        if List.all (fun y => x >= y) rest then List.cons x (leaders_go rest) else leaders_go rest;

@doc("Keep values at least as large as every value to their right, including equal maxima.")
def leaders (vector:{v:(List Int){|fun x => 0 <= x && x <= 1000|} | 0 <= List.size v && List.size v <= 20}) : (List Int) :=
    leaders_go vector;
