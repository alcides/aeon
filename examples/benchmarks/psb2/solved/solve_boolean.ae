# PSB2: solve-boolean
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/solve_boolean.clj

import List
import Math
import String

def boolean_go (s:String) (index:Int) (value:Bool) : Bool :=
    if index >= String.len s then value else
        let next := String.charAt s (index + 1) = "t" in
        boolean_go s (index + 2) (if String.charAt s index = "&" then value && next else value || next);

@doc("Evaluate a valid t/f expression with & and | strictly from left to right.")
def solve_boolean (s:{v:String | 1 <= String.len v && String.len v <= 39 && String.len v % 2 = 1}) : Bool :=
    boolean_go s 1 (String.charAt s 0 = "t");
