# PSB2: bowling
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/bowling.clj

import List
import Math
import String

def pins (s:String) : Int := if s = "X" || s = "/" then 10 else if s = "-" then 0 else String.stringToInt s;
def bowling_go (s:String) (frames:Int) : Int :=
    if frames <= 0 then 0 else
        let a := String.charAt s 0 in let b := String.charAt s 1 in let c := String.charAt s 2 in
        if a = "X" then (if c = "/" then 20 else 10 + pins b + pins c) + bowling_go (String.substr s 1 (String.len s)) (frames - 1)
        else if b = "/" then 10 + pins c + bowling_go (String.substr s 2 (String.len s)) (frames - 1)
        else pins a + pins b + bowling_go (String.substr s 2 (String.len s)) (frames - 1);

@doc("Score ten valid bowling frames, including strike and spare bonuses.")
def bowling (scores:{v:String | 12 <= String.len v && String.len v <= 21}) : Int :=
    bowling_go scores 10;
