# PSB2: camel-case
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/camel_case.clj

import List
import Math
import String

@doc("Remove hyphens and capitalize the following word fragments; lower-case the first result character.")
def camel_case (s:String) : String :=
    let combined := String.joinList "" (List.map String.capitalize (String.splitList s "-")) in
    String.concat (String.lower (String.charAt combined 0)) (String.substr combined 1 (String.len combined));
