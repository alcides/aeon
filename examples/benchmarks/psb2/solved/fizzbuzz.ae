# PSB2: fizz-buzz
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/fizz_buzz.clj

import List
import Math
import String

@doc("Return Fizz, Buzz, FizzBuzz, or the decimal input according to divisibility by three and five.")
def fizzbuzz (n:{v:Int | 1 <= v && v <= 1000000}) : String :=
    if n % 15 = 0 then "FizzBuzz" else if n % 3 = 0 then "Fizz" else if n % 5 = 0 then "Buzz" else String.intToString n;
