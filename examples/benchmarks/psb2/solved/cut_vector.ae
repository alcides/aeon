# PSB2: cut-vector
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/cut_vector.clj

import List
import Math
import String

def choose_cut (xs:(List Int)) (i:Int) (best:Int) (difference:Int) : Int :=
    if i >= List.length xs then best else
        let delta := Math.abs (List.sum (List.take i xs) - List.sum (List.drop i xs)) in
        if delta = 0 then i else
        if delta <= difference then choose_cut xs (i + 1) i delta else choose_cut xs (i + 1) best difference;

@doc("Split a vector into two parts with the closest sums; match PSB2 tie-breaking.")
def cut_vector (xs:{v:(List Int){|fun x => 0 <= x && x <= 10000|} | 1 <= List.size v && List.size v <= 20}) : (List (List Int)) :=
    let values:(List Int) := xs in
    if List.length values = 1 then [values, []] else
    let cut := choose_cut values 1 0 (List.foldr Math.max 0 values) in [List.take cut values, List.drop cut values];
