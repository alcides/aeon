# PSB2: vector-distance
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/vector_distance.clj

import List
import Math
import String

@doc("Compute Euclidean distance between equally sized floating-point vectors.")
def vector_distance (vector1:{v:(List Float){|fun x => (-100.0) <= x && x <= 100.0|} | 1 <= List.size v && List.size v <= 20}) (vector2:{v:(List Float){|fun x => (-100.0) <= x && x <= 100.0|} | List.size v = List.size vector1}) : Float :=
    Math.sqrtf (Math.absf (List.sumFloat (List.zipWith (fun a => fun b => (a - b) * (a - b)) vector1 vector2)));
