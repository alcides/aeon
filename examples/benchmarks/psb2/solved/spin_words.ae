# PSB2: spin-words
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/spin_words.clj

import List
import Math
import String

@doc("Reverse words of at least five characters, keeping other words and spaces in place.")
def spin_words (phrase:String) : String :=
    String.joinList " " (List.map (fun word => if String.len word >= 5 then String.reverse word else word) (String.splitList phrase " "));
