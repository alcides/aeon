import PSB2Fitness (per_example_errors)
# Fuel Cost: Given a vector of positive integers, divide each by 3,
# round down, and subtract 2. Return the sum of all values >= 0.
# input  : vector of integers (length [1, 20]) in [6, 100000]
# output : integer

import PSB2 (extract_train_data, load_dataset)
import Array

def train : TrainData := extract_train_data (load_dataset "fuel-cost" 200 200)

def calculate_fuel_cost_errors : (train: TrainData) -> (f: (1 a: {l:(Array Int) | 1 <= Array.size l && Array.size l <= 20}) -> Int) -> (Array Int) :=
    fun data => fun func => native "[abs(func(x[0][0]) - x[1][0]) for x in data]"

@multi_minimize_float(per_example_errors (calculate_fuel_cost_errors train synth), 200)
def synth (1 xs : {l:(Array Int) | 1 <= Array.size l && Array.size l <= 20}) : {r:Int | 0 <= r} := (let extract_train_data := unit in let load_dataset := unit in let train := unit in let calculate_fuel_cost_errors := unit in ?hole);
