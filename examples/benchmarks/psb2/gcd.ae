import PSB2Fitness (per_example_errors)
# Given two positive integers, return their greatest common divisor.
# input  : 2 integers in [1, 1000000]
# output : integer in [1, 1000000]

import PSB2 (training_data, fresh_train_data, extract_train_data, load_dataset)
import Array

def train : TrainingCases := training_data "gcd" 200 200

def calculate_gcd_errors : (1 train:TrainData) -> (f: (a: {x:Int | 1 <= x && x <= 1000000}) -> (b: {y:Int | 1 <= y && y <= 1000000}) -> Int) -> (Array Int) :=
    fun data => fun func => native "[abs(func(x[0][0])(x[0][1]) - x[1][0]) for x in data]"

@multi_minimize_float(per_example_errors (calculate_gcd_errors (fresh_train_data train) synth), 200)
def synth (n : {x:Int | 1 <= x && x <= 1000000})
          (z : {y:Int | 1 <= y && y <= 1000000}) : {r:Int | 1 <= r} := (let extract_train_data := unit in let load_dataset := unit in let train := unit in let calculate_gcd_errors := unit in ?hole);
