# PSB2: bouncing-balls
# Reference: thelmuth/Clojush, tag psb2-v1.0, src/clojush/problems/psb2/bouncing_balls.clj

import List
import Math
import String
import PSB2Fitness

def train : Cases := PSB2Fitness.cases "bouncing-balls" 200;

def score (cases:Cases) (candidate:(starting_height:{v:Float | 1.0 <= v && v <= 100.0}) -> (bounce_height:{v:Float | 1.0 <= v && v < starting_height}) -> (bounces:{v:Int | 1 <= v && v <= 20}) -> {r:Float | 0.0 <= r && r <= 4000.0}) : (Array Float) :=
    native "__import__('aeon.bindings.psb2', fromlist=['errors']).errors('bouncing-balls', cases(None), candidate)";

@doc("Accumulate the downward and upward travel for the requested number of bounces.")
@minimize_float(PSB2Fitness.meanError (score train synth))
def synth (starting_height:{v:Float | 1.0 <= v && v <= 100.0}) (bounce_height:{v:Float | 1.0 <= v && v < starting_height}) (bounces:{v:Int | 1 <= v && v <= 20}) : {r:Float | 0.0 <= r && r <= 4000.0} :=
    let score := unit in
    let train := unit in
    let PSB2Fitness_cases := unit in
    ?hole;
