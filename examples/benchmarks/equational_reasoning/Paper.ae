# Adapted from Lists.hs in EquationalReasoningInLiquidHaskell (MIT).
# Explicit defining equations replace Liquid Haskell's `reflect` annotation.
import List;
import Maybe;
def noResult : {r:(Maybe (List Int)) | r = Maybe.none && !Maybe.present r} := Maybe.none;
# A concrete standard-list value retains the nullary constructor's refinement.
def emptyList : {xs:(List Int) | xs = List.nil && List.structuralRank xs = 0} := List.nil{Int}{|fun value => true|};

def length (xs:(List Int)) : {n:Int | n = List.structuralRank xs && n >= 0} decreasing_by [List.structuralRank xs] :=
 match xs with | nil => 0 | cons h t => 1 + length t;

def append (xs:(List Int)) (ys:{v:(List Int) | List.structuralRank v >= 0}) : {r:(List Int) |
 (List.structuralRank xs = 0 --> r = ys) &&
 (List.structuralRank xs > 0 --> r = List.cons (List.first xs) (append (List.rest xs) ys)) &&
 List.structuralRank r = List.structuralRank xs + List.structuralRank ys && List.structuralRank r >= 0}
 decreasing_by [List.structuralRank xs] :=
 match xs with | nil => ys | cons h t => List.cons{Int}{|fun value => true|} h (append t ys);

def reverse (xs:(List Int)) : {r:(List Int) |
 (List.structuralRank xs = 0 --> r = emptyList) &&
 (List.structuralRank xs > 0 --> r = append (reverse (List.rest xs)) (List.cons (List.first xs) emptyList)) &&
 List.structuralRank r = List.structuralRank xs && List.structuralRank r >= 0}
 decreasing_by [List.structuralRank xs] :=
 match xs with | nil => emptyList | cons h t => append (reverse t) (List.cons{Int}{|fun value => true|} h emptyList);

theorem rightIdP (xs:(List Int)) : append xs emptyList = xs decreasing_by [List.structuralRank xs] :=
 by induction xs with
 | nil => smt
 | cons h t ih => simp [ih];

# The companion calls its automated right-identity variant leftIdP.
theorem leftIdP (xs:(List Int)) : append xs emptyList = xs decreasing_by [List.structuralRank xs] :=
 by induction xs with
 | nil => smt
 | cons h t ih => simp [ih];

theorem assocP (xs:(List Int)) (ys:{v:(List Int) | List.structuralRank v >= 0}) (zs:{v:(List Int) | List.structuralRank v >= 0})
 : append xs (append ys zs) = append (append xs ys) zs
 decreasing_by [List.structuralRank xs] :=
 match xs with | nil => unit | cons h t => let ih := assocP t ys zs in
   let step := append (List.cons{Int}{|fun value => true|} h (append t ys)) zs in unit;

theorem singletonP (x:Int) : reverse (List.cons x emptyList) = List.cons x emptyList :=
 calc (reverse (List.cons{Int}{|fun value => true|} x emptyList) = List.cons{Int}{|fun value => true|} x emptyList := by smt);
theorem singleton1P : reverse (List.cons 1 emptyList) = List.cons 1 emptyList := singletonP 1;

theorem distributivityP (xs:(List Int)) (ys:{v:(List Int) | List.structuralRank v >= 0})
 : reverse (append xs ys) = append (reverse ys) (reverse xs)
 decreasing_by [List.structuralRank xs] :=
 match xs with
 | nil => let identity := rightIdP (reverse ys) in unit
 | cons h t =>
   let ih := distributivityP t ys in
   let association := assocP (reverse ys) (reverse t) (List.cons{Int}{|fun value => true|} h emptyList) in
   let step := reverse (List.cons{Int}{|fun value => true|} h (append t ys)) in
   calc (reverse (append xs ys) = append (reverse ys) (reverse xs) := by smt);

theorem involutionP (xs:(List Int)) : reverse (reverse xs) = xs
 decreasing_by [List.structuralRank xs] :=
 match xs with
 | nil => unit
 | cons h t =>
   let distribution := distributivityP (reverse t) (List.cons{Int}{|fun value => true|} h emptyList) in
   let ih := involutionP t in
   let singleton := singletonP h in
   let step := append (List.cons{Int}{|fun value => true|} h emptyList) t in
   calc (reverse (reverse xs) = xs := by smt);

# Paper section 4; explicit equations are checked, not assumed.


def reverseApp0 (xs:(List Int)) (ys:{v:(List Int) | List.structuralRank v >= 0})
 : {r:(List Int) | r = append (reverse xs) ys} := append (reverse xs) ys;
def reverseApp1 (xs:(List Int)) (ys:{v:(List Int) | List.structuralRank v >= 0})
 : {r:(List Int) | r = append (reverse xs) ys} :=
 match xs with | nil => append (reverse xs) ys | cons h t => append (reverse xs) ys;
def reverseApp (xs:(List Int)) (ys:{v:(List Int) | List.structuralRank v >= 0})
 : {r:(List Int) | r = append (reverse xs) ys && List.structuralRank r >= 0}
 decreasing_by [List.structuralRank xs] :=
 match xs with
 | nil => ys
 | cons h t =>
   let association := assocP (reverse t) (List.cons{Int}{|fun value => true|} h emptyList) ys in
   let step := append (List.cons{Int}{|fun value => true|} h emptyList) ys in
   reverseApp t (List.cons{Int}{|fun value => true|} h ys);
def reverseFast (xs:(List Int)) : {r:(List Int) | r = reverse xs} :=
 let identity := rightIdP (reverse xs) in reverseApp xs emptyList;

inductive Tree
| Leaf (n:Int) : {t:Tree | Tree.rank t = 1 && Tree.value t = n}
| Node (l:{t:Tree | Tree.rank t >= 1}) (r:{t:Tree | Tree.rank t >= 1})
 : {t:Tree | Tree.rank t = 1 + Tree.rank l + Tree.rank r && Tree.left t = l && Tree.right t = r}
+ rank (t:Tree) : Int
+ value (t:Tree) : Int
+ left (t:Tree) : Tree
+ right (t:Tree) : Tree

def flatten (t:Tree) : {xs:(List Int) |
 (Tree.rank t = 1 --> xs = List.cons (Tree.value t) emptyList) &&
 (Tree.rank t > 1 --> xs = append (flatten (Tree.left t)) (flatten (Tree.right t))) &&
 List.structuralRank xs >= 0}
 decreasing_by [Tree.rank t] :=
 match t with | Leaf n => List.cons{Int}{|fun value => true|} n emptyList | Node l r => append (flatten l) (flatten r);
def flattenApp0 (t:Tree) (ns:{v:(List Int) | List.structuralRank v >= 0})
 : {v:(List Int) | v = append (flatten t) ns} := append (flatten t) ns;
def flattenApp (t:Tree) (ns:{v:(List Int) | List.structuralRank v >= 0})
 : {v:(List Int) | v = append (flatten t) ns && List.structuralRank v >= 0}
 decreasing_by [Tree.rank t] :=
 match t with
 | Leaf n =>
   let step := append (List.cons{Int}{|fun value => true|} n emptyList) ns in List.cons{Int}{|fun value => true|} n ns
 | Node l r =>
   let association := assocP (flatten l) (flatten r) ns in flattenApp l (flattenApp r ns);
def flattenFast (t:Tree) : {v:(List Int) | v = flatten t} :=
 let identity := rightIdP (flatten t) in flattenApp t emptyList;

# Section 5: a total stack machine. Code fuses [Op] into nil/PUSH/ADD.
inductive Expr
| Val (n:Int) : {e:Expr | Expr.rank e = 1 && Expr.value e = n && Expr.adds e = 0}
| Add (x:{e:Expr | Expr.rank e >= 1}) (y:{e:Expr | Expr.rank e >= 1})
 : {e:Expr | Expr.rank e = 1 + Expr.rank x + Expr.rank y && Expr.left e = x && Expr.right e = y && Expr.adds e = 1 + Expr.adds x + Expr.adds y}
+ rank (e:Expr) : Int
+ value (e:Expr) : Int
+ left (e:Expr) : Expr
+ right (e:Expr) : Expr
+ adds (e:Expr) : Int

def eval (e:Expr) : {n:Int |
 (Expr.rank e = 1 --> n = Expr.value e) &&
 (Expr.rank e > 1 --> n = eval (Expr.left e) + eval (Expr.right e))}
 decreasing_by [Expr.rank e] :=
 match e with | Val n => n | Add x y => eval x + eval y;

inductive Code
| done : {c:Code | Code.rank c = 0 && Code.tag c = 0 && Code.adds c = 0}
| PUSH (n:Int) (c:{c:Code | Code.rank c >= 0})
 : {d:Code | Code.rank d = Code.rank c + 1 && Code.tag d = 1 && Code.value d = n && Code.tail d = c && Code.adds d = Code.adds c}
| ADD (c:{c:Code | Code.rank c >= 0})
 : {d:Code | Code.rank d = Code.rank c + 1 && Code.tag d = 2 && Code.tail d = c && Code.adds d = Code.adds c + 1}
+ rank (c:Code) : Int
+ tag (c:Code) : Int
+ value (c:Code) : Int
+ tail (c:Code) : Code
+ adds (c:Code) : Int

def app (c:Code) (d:{c:Code | Code.rank c >= 0}) : {r:Code |
 (Code.tag c = 0 --> r = d) &&
 (Code.tag c = 1 --> r = Code.PUSH (Code.value c) (app (Code.tail c) d)) &&
 (Code.tag c = 2 --> r = Code.ADD (app (Code.tail c) d)) &&
 Code.rank r = Code.rank c + Code.rank d && Code.rank r >= 0 && Code.adds r = Code.adds c + Code.adds d}
 decreasing_by [Code.rank c] :=
 match c with | done => d | PUSH n t => Code.PUSH n (app t d) | ADD t => Code.ADD (app t d);

theorem appRightIdP (c:Code) : app c Code.done = c decreasing_by [Code.rank c] :=
 match c with | done => unit | PUSH n t => let ih := appRightIdP t in unit | ADD t => let ih := appRightIdP t in unit;
theorem appAssocP (c:Code) (d:{c:Code | Code.rank c >= 0}) (e:{c:Code | Code.rank c >= 0})
 : app (app c d) e = app c (app d e) decreasing_by [Code.rank c] :=
 match c with
 | done => unit
 | PUSH n t => let ih := appAssocP t d e in let step := app (Code.PUSH n (app t d)) e in unit
 | ADD t => let ih := appAssocP t d e in let step := app (Code.ADD (app t d)) e in unit;

def exec (c:Code) (s:{s:(List Int) | List.structuralRank s >= 0}) : {r:(Maybe (List Int)) |
 (Code.tag c = 0 --> r = Maybe.just s) &&
 (Code.tag c = 1 --> r = exec (Code.tail c) (List.cons (Code.value c) s)) &&
 (Code.tag c = 2 && List.structuralRank s < 2 --> r = noResult) &&
 (Code.tag c = 2 && List.structuralRank s >= 2 -->
   r = exec (Code.tail c) (List.cons (List.first (List.rest s) + List.first s) (List.rest (List.rest s)))) &&
 (Maybe.present r --> List.structuralRank (Maybe.value r) >= 0)}
 decreasing_by [Code.rank c] :=
 match c with
 | done => Maybe.just s
 | PUSH n t => exec t (List.cons{Int}{|fun value => true|} n s)
 | ADD t => match s with
   | nil => noResult
   | cons m rest => match rest with
     | nil => noResult
     | cons n ss => exec t (List.cons{Int}{|fun value => true|} (n + m) ss);

# First-order specialization of (>>=) to the continuation `exec d`.
def bindExec (r:{v:(Maybe (List Int)) | Maybe.present v --> List.structuralRank (Maybe.value v) >= 0}) (d:Code) : {v:(Maybe (List Int)) |
 (Maybe.present r --> v = exec d (Maybe.value r)) && (!Maybe.present r --> v = noResult)} :=
 match r with | none => noResult | just s => let valid := length s in exec d s;

theorem sequenceP (c:Code) (d:{c:Code | Code.rank c >= 0}) (s:{s:(List Int) | List.structuralRank s >= 0})
 : exec (app c d) s = bindExec (exec c s) d
 decreasing_by [Code.rank c] :=
 match c with
 | done => let step := bindExec (Maybe.just s) d in unit
 | PUSH n t =>
   let ih := sequenceP t d (List.cons{Int}{|fun value => true|} n s) in
   let step := exec (Code.PUSH n (app t d)) s in unit
 | ADD t => match s with
   | nil =>
     let step := exec (Code.ADD (app t d)) s in
     let failure := bindExec noResult d in unit
   | cons m rest => match rest with
     | nil =>
       let step := exec (Code.ADD (app t d)) s in
       let failure := bindExec noResult d in unit
     | cons n ss =>
       let ih := sequenceP t d (List.cons{Int}{|fun value => true|} (n + m) ss) in
       let step := exec (Code.ADD (app t d)) s in
       let unfold := exec c s in unit;

def comp (e:Expr) : {c:Code |
 (Expr.rank e = 1 --> c = Code.PUSH (Expr.value e) Code.done) &&
 (Expr.rank e > 1 --> c = app (comp (Expr.left e)) (app (comp (Expr.right e)) (Code.ADD Code.done))) &&
 Code.rank c >= 0 && Code.adds c = Expr.adds e}
 decreasing_by [Expr.rank e] :=
 match e with | Val n => Code.PUSH n Code.done | Add x y => app (comp x) (app (comp y) (Code.ADD Code.done));

theorem generalizedCorrectnessP (e:Expr) (s:{s:(List Int) | List.structuralRank s >= 0})
 : exec (comp e) s = Maybe.just (List.cons (eval e) s) decreasing_by [Expr.rank e] :=
 match e with
 | Val n =>
   let push := exec (Code.PUSH n Code.done) s in
   let finish := exec Code.done (List.cons{Int}{|fun value => true|} n s) in unit
 | Add x y =>
   let seqX := sequenceP (comp x) (app (comp y) (Code.ADD Code.done)) s in
   let ihX := generalizedCorrectnessP x s in
   let bindX := bindExec (Maybe.just (List.cons{Int}{|fun value => true|} (eval x) s)) (app (comp y) (Code.ADD Code.done)) in
   let seqY := sequenceP (comp y) (Code.ADD Code.done) (List.cons{Int}{|fun value => true|} (eval x) s) in
   let ihY := generalizedCorrectnessP y (List.cons{Int}{|fun value => true|} (eval x) s) in
   let bindY := bindExec (Maybe.just (List.cons{Int}{|fun value => true|} (eval y) (List.cons{Int}{|fun value => true|} (eval x) s))) (Code.ADD Code.done) in
   let add := exec (Code.ADD Code.done) (List.cons{Int}{|fun value => true|} (eval y) (List.cons{Int}{|fun value => true|} (eval x) s)) in
   let finish := exec Code.done (List.cons{Int}{|fun value => true|} (eval x + eval y) s) in
   let compiled := comp e in let value := eval e in
   calc (
     exec (comp e) s = exec (app (comp x) (app (comp y) (Code.ADD Code.done))) s := by smt;
     _ = bindExec (exec (comp x) s) (app (comp y) (Code.ADD Code.done)) := by smt;
     _ = bindExec (Maybe.just (List.cons{Int}{|fun value => true|} (eval x) s)) (app (comp y) (Code.ADD Code.done)) := by smt;
     _ = exec (app (comp y) (Code.ADD Code.done)) (List.cons{Int}{|fun value => true|} (eval x) s) := by smt;
     _ = bindExec (exec (comp y) (List.cons{Int}{|fun value => true|} (eval x) s)) (Code.ADD Code.done) := by smt;
     _ = bindExec (Maybe.just (List.cons{Int}{|fun value => true|} (eval y) (List.cons{Int}{|fun value => true|} (eval x) s))) (Code.ADD Code.done) := by smt;
     _ = exec (Code.ADD Code.done) (List.cons{Int}{|fun value => true|} (eval y) (List.cons{Int}{|fun value => true|} (eval x) s)) := by smt;
     _ = exec Code.done (List.cons{Int}{|fun value => true|} (eval x + eval y) s) := by smt;
     _ = Maybe.just (List.cons{Int}{|fun value => true|} (eval e) s) := by smt);
theorem correctnessP (e:Expr) : exec (comp e) emptyList = Maybe.just (List.cons (eval e) emptyList) :=
 generalizedCorrectnessP e emptyList;

def compApp (e:Expr) (c:{c:Code | Code.rank c >= 0}) : {d:Code |
 d = app (comp e) c && Code.rank d >= 0 && Code.adds d = Expr.adds e + Code.adds c &&
 (Expr.rank e = 1 --> d = Code.PUSH (Expr.value e) c) &&
 (Expr.rank e > 1 --> d = compApp (Expr.left e) (compApp (Expr.right e) (Code.ADD c)))}
 decreasing_by [Expr.rank e] :=
 match e with
 | Val n => let step := app (Code.PUSH n Code.done) c in Code.PUSH n c
 | Add x y =>
   let assocX := appAssocP (comp x) (app (comp y) (Code.ADD Code.done)) c in
   let assocY := appAssocP (comp y) (Code.ADD Code.done) c in
   let step := app (Code.ADD Code.done) c in compApp x (compApp y (Code.ADD c));
def compFast (e:Expr) : {c:Code | c = compApp e Code.done && Code.rank c >= 0} := compApp e Code.done;
theorem equivP (e:Expr) : compFast e = comp e :=
 let identity := appRightIdP (comp e) in
 calc (
   compFast e = compApp e Code.done := by smt;
   _ = app (comp e) Code.done := by smt;
   _ = comp e := by smt);
theorem equivCorrectnessP (e:Expr)
 : exec (compFast e) emptyList = Maybe.just (List.cons (eval e) emptyList) :=
 let equivalence := equivP e in let correctness := correctnessP e in unit;

theorem generalizedCorrectnessFastP (e:Expr) (s:{s:(List Int) | List.structuralRank s >= 0}) (c:{c:Code | Code.rank c >= 0})
 : exec (compApp e c) s = exec c (List.cons (eval e) s) decreasing_by [Expr.rank e] :=
 match e with
 | Val n => let step := exec (Code.PUSH n c) s in unit
 | Add x y =>
   let ihX := generalizedCorrectnessFastP x s (compApp y (Code.ADD c)) in
   let ihY := generalizedCorrectnessFastP y (List.cons{Int}{|fun value => true|} (eval x) s) (Code.ADD c) in
   let step := exec (Code.ADD c) (List.cons{Int}{|fun value => true|} (eval y) (List.cons{Int}{|fun value => true|} (eval x) s)) in
   let compiled := compApp e c in let value := eval e in unit;
theorem correctnessFastP (e:Expr)
 : exec (compFast e) emptyList = Maybe.just (List.cons (eval e) emptyList) :=
 let correctness := generalizedCorrectnessFastP e emptyList Code.done in
 let finish := exec Code.done (List.cons{Int}{|fun value => true|} (eval e) emptyList) in unit;

# Historical companion measures, retained as executable checked functions.
def exprAdds (e:Expr) : {n:Int | n = Expr.adds e && n >= 0} decreasing_by [Expr.rank e] :=
 match e with | Val n => 0 | Add x y => 1 + exprAdds x + exprAdds y;
def addCount (c:Code) : {n:Int | n = Code.adds c && n >= 0} decreasing_by [Code.rank c] :=
 match c with | done => 0 | PUSH n t => addCount t | ADD t => 1 + addCount t;

# Runtime smoke test complements (and does not replace) the quantified proofs.
def encode (xs:(List Int)) : Int := match xs with | nil => 0 | cons h t => h + 10 * encode t;
def answer (r:(Maybe (List Int))) : Int :=
 match r with | none => 0 | just xs => match xs with | nil => 0 | cons h t => h;
def main (_:Int) : Int :=
 let xs := List.cons{Int}{|fun value => true|} 1 (List.cons{Int}{|fun value => true|} 2 (List.cons{Int}{|fun value => true|} 3 emptyList)) in
 let tree := Tree.Node (Tree.Leaf 1) (Tree.Node (Tree.Leaf 2) (Tree.Leaf 3)) in
 let e := Expr.Add (Expr.Val 20) (Expr.Val 22) in
 let lists := involutionP xs in
 let naive := correctnessP e in
 let equivalence := equivCorrectnessP e in
 let optimized := correctnessFastP e in
 if encode (reverseApp0 xs emptyList) = 123 && encode (reverseApp1 xs emptyList) = 123 &&
    encode (reverseFast xs) = 123 && encode (flattenApp0 tree emptyList) = 321 &&
    encode (flattenFast tree) = 321 &&
    exec (Code.ADD Code.done) emptyList = noResult &&
    exec (Code.ADD Code.done) (List.cons{Int}{|fun value => true|} 1 emptyList) = noResult &&
    answer (exec (comp e) emptyList) = 42 && answer (exec (compFast e) emptyList) = 42 &&
    addCount (compApp e (Code.ADD Code.done)) = exprAdds e + 1
 then 42 else 0;
