# AVL-RotateL — Synquid PLDI16, pinned source in upstream/AVL-RotateL.sq
# Balance only: child heights differ by at most one. Key order and element sets are not restored.

inductive Avl a
| leaf : {t:(Avl a) | height t = 0 && balFac t = 0}
| node (x:a) (l:(Avl a)) (r:{v:(Avl a) | height l - height v <= 1 && height v - height l <= 1}) :
    {t:(Avl a) | height t = (if height l >= height r then height l else height r) + 1 && balFac t = height l - height r}
+ height (t:(Avl a)) : {v:Int | v >= 0}
+ balFac (t:(Avl a)) : Int

def inc (x:Int) : {v:Int | v = x + 1} := x + 1;

def rotLR : forall a:B,
    (x:a) -> (left:{t:(Avl a) | Avl.balFac t < 0}) -> (right:{t:(Avl a) | Avl.height left - Avl.height t = 2}) ->
    {t:(Avl a) | Avl.height t = Avl.height left} :=
    Λ a:B => fun x => fun left => fun right =>
    ?hole;

def rotLL : forall a:B,
    (x:a) -> (left:{t:(Avl a) | Avl.balFac t > 0}) -> (right:{t:(Avl a) | Avl.height left - Avl.height t = 2}) ->
    {t:(Avl a) | Avl.height t = Avl.height left} :=
    Λ a:B => fun x => fun left => fun right =>
    ?hole;

def rotL0 : forall a:B,
    (x:a) -> (left:{t:(Avl a) | Avl.balFac t = 0}) -> (right:{t:(Avl a) | Avl.height left - Avl.height t = 2}) ->
    {t:(Avl a) | Avl.height t = Avl.height left + 1} :=
    Λ a:B => fun x => fun left => fun right =>
    ?hole;
