# Tree-ToList — Synquid PLDI16, pinned source in upstream/Tree-ToList.sq
# Contract matches upstream; see manifest.json for vocabulary differences.

inductive List a
| nil : {xs:(List a) | len xs = 0}
| cons (x:a) (xs:(List a)) : {ys:(List a) | len ys = 1 + len xs}
+ len (xs:(List a)) : {v:Int | v >= 0}

inductive Tree a
| empty : {t:(Tree a) | size t = 0}
| node (x:a) (l:(Tree a)) (r:(Tree a)) : {t:(Tree a) | size t = size l + size r + 1}
+ size (t:(Tree a)) : {v:Int | v >= 0}

def append (xs:(List a)) (ys:(List a)) : {v:(List a) | List.len v = List.len xs + List.len ys}
    decreasing_by [List.len xs] :=
    match xs with | nil => ys | cons x tail => List.cons x (append tail ys);

def toList (t:(Tree a)) : {v:(List a) | List.len v = Tree.size t} decreasing_by [Tree.size t] := ?hole;
