# Tree-Elem — LEGACY APPROXIMATION, not an equivalent upstream benchmark.
# See manifest.json and upstream/Tree-Elem.sq for the missing contracts.

inductive Tree a
| leaf : {t:(Tree a) | tsize t = 0}
| node (left: (Tree a)) (x: a) (right: (Tree a)) : {t:(Tree a) | tsize t = tsize left + tsize right + 1}
+ tsize (t: (Tree a)) : Int

def telem (x: a) (t: (Tree a)) : Bool := ?hole;
