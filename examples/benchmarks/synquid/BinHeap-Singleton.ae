# BinHeap-Singleton — Synquid PLDI16, pinned source in upstream/BinHeap-Singleton.sq
# Contract-faithful: children are strictly greater than the parent, and the singleton set is exact.

inductive Heap a
| empty : {h:(Heap a) | size h = 0 && elems h = Set_empty}
| node (x:a) (left:(Heap {v:a | v > x})) (right:(Heap {v:a | v > x})) :
    {h:(Heap a) | size h = size left + size right + 1 && elems h = Set_cup (Set_cup (elems left) (elems right)) (Set_sng x)}
+ size (h:(Heap a)) : {v:Int | v >= 0}
+ elems (h:(Heap a)) : (Set a)

def leq : forall a:B, (x:a) -> (y:a) -> {v:Bool | v = (x <= y)} :=
    Λ a:B => fun x => fun y => x <= y;

def neq : forall a:B, (x:a) -> (y:a) -> {v:Bool | v = (x != y)} :=
    Λ a:B => fun x => fun y => x != y;

def singleton : forall a:B, (x:a) -> {h:(Heap a) | Heap.elems h = Set_sng x} :=
    Λ a:B => fun x =>
    ?hole;
