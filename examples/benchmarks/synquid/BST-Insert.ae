# BST-Insert — LEGACY APPROXIMATION, not an equivalent upstream benchmark.
# See manifest.json and upstream/BST-Insert.sq for the missing contracts.

inductive BTree a
| bleaf : {t:(BTree a) | bsz t = 0}
| bnode (left: (BTree a)) (key: a) (right: (BTree a)) : {t:(BTree a) | bsz t = bsz left + bsz right + 1}
+ bsz (t: (BTree a)) : Int

def binsert (x: a) (t: (BTree a)) : {r:(BTree a) | bsz r >= bsz t} := ?hole;
