# BST-Member — LEGACY APPROXIMATION, not an equivalent upstream benchmark.
# See manifest.json and upstream/BST-Member.sq for the missing contracts.

inductive BTree a
| bleaf : {t:(BTree a) | bsz t = 0}
| bnode (left: (BTree a)) (key: a) (right: (BTree a)) : {t:(BTree a) | bsz t = bsz left + bsz right + 1}
+ bsz (t: (BTree a)) : Int

def member (x: a) (t: (BTree a)) : Bool := ?hole;
