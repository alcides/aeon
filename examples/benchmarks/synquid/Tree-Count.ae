# Tree-Count — Synquid PLDI16, pinned source in upstream/Tree-Count.sq
# Contract matches upstream; see manifest.json for vocabulary differences.

inductive Tree a
| empty : {t:(Tree a) | size t = 0}
| node (x:a) (l:(Tree a)) (r:(Tree a)) : {t:(Tree a) | size t = size l + size r + 1}
+ size (t:(Tree a)) : {v:Int | v >= 0}

def zero : {v:Int | v = 0} := 0;
def one : {v:Int | v = 1} := 1;
def plus (x:Int) (y:Int) : {v:Int | v = x + y} := x + y;

def countNodes (t:(Tree a)) : {v:Int | v = Tree.size t} decreasing_by [Tree.size t] := ?hole;
