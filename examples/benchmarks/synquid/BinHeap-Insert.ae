# BinHeap-Insert — LEGACY APPROXIMATION, not an equivalent upstream benchmark.
# See manifest.json and upstream/BinHeap-Insert.sq for the missing contracts.

inductive Heap a
| hleaf : {h:(Heap a) | hsz h = 0}
| hnode (left: (Heap a)) (key: a) (right: (Heap a)) : {h:(Heap a) | hsz h = hsz left + hsz right + 1}
+ hsz (h: (Heap a)) : Int

def hinsert (x: a) (h: (Heap a)) : {r:(Heap a) | hsz r = hsz h + 1} := ?hole;
