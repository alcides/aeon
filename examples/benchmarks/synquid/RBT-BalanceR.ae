# RBT-BalanceR — LEGACY APPROXIMATION, not an equivalent upstream benchmark.
# See manifest.json and upstream/RBT-BalanceR.sq for the missing contracts.

inductive Rbt a
| rleaf : {t:(Rbt a) | rsz t = 0}
| rnode (left: (Rbt a)) (key: a) (right: (Rbt a)) : {t:(Rbt a) | rsz t = rsz left + rsz right + 1}
+ rsz (t: (Rbt a)) : Int

def balanceRR (left: (Rbt a)) (x: a) (right: (Rbt a)) : {r:(Rbt a) | rsz r = rsz left + rsz right + 1} := ?hole;
