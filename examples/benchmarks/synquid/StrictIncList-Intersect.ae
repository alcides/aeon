# StrictIncList-Intersect — LEGACY APPROXIMATION, not an equivalent upstream benchmark.
# See manifest.json and upstream/StrictIncList-Intersect.sq for the missing contracts.

inductive SList
| snil : {l:SList | slen l = 0}
| scons (hd: Int) (tl: {t:SList | slen t = 0 || hd < smin t}) : {l:SList | slen l = slen tl + 1 && smin l = hd}
+ slen (l: SList) : Int
+ smin (l: SList) : Int

def sintersect (xs: SList) (ys: SList) : {l:SList | slen l <= slen xs && slen l <= slen ys} := ?hole;
