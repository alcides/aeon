# IncList-Merge — LEGACY APPROXIMATION, not an equivalent upstream benchmark.
# See manifest.json and upstream/IncList-Merge.sq for the missing contracts.

inductive IncList
| inil : {l:IncList | ilen l = 0}
| icons (hd: Int) (tl: {t:IncList | ilen t = 0 || hd <= imin t}) : {l:IncList | ilen l = ilen tl + 1 && imin l = hd}
+ ilen (l: IncList) : Int
+ imin (l: IncList) : Int

def merge (xs: IncList) (ys: IncList) : {l:IncList | ilen l = ilen xs + ilen ys} := ?hole;
