# List-Partition — LEGACY APPROXIMATION, not an equivalent upstream benchmark.
# See manifest.json and upstream/List-Partition.sq for the missing contracts.

open List

inductive LPair a
| mkLP (fa: (List a)) (sb: (List a)) : {p:(LPair a) | asize p = List.size fa && bsize p = List.size sb}
+ asize (p: (LPair a)) : Int
+ bsize (p: (LPair a)) : Int

def partition (pivot: a) (xs: (List a)) : {p:(LPair a) | asize p + bsize p = List.size xs} := ?hole;
