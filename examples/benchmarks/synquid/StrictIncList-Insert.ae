# StrictIncList-Insert — LEGACY APPROXIMATION, not an equivalent upstream benchmark.
# See manifest.json and upstream/StrictIncList-Insert.sq for the missing contracts.

inductive SList
| snil : {l:SList | slen l = 0}
| scons (hd: Int) (tl: {t:SList | slen t = 0 || hd < smin t}) : {l:SList | slen l = slen tl + 1 && smin l = hd}
+ slen (l: SList) : Int
+ smin (l: SList) : Int

def sinsert (x: Int) (xs: SList) : {l:SList | slen l >= slen xs} := ?hole;
