# List-Product — Synquid PLDI16, pinned source in upstream/List-Product.sq
# Contract matches upstream; see manifest.json for vocabulary differences.

inductive Pair a b
| pair (x:a) (y:b) : {v:(Pair a b) | fst v = x && snd v = y}
+ fst (v:(Pair a b)) : a
+ snd (v:(Pair a b)) : b

inductive List a
| nil : {xs:(List a) | len xs = 0}
| cons (x:a) (xs:(List a)) : {ys:(List a) | len ys = 1 + len xs}
+ len (xs:(List a)) : {v:Int | v >= 0}

def map (f:(x:a) -> b) (xs:(List a)) : {v:(List b) | List.len v = List.len xs}
    decreasing_by [List.len xs] :=
    match xs with | nil => List.nil | cons x tail => List.cons (f x) (map f tail);

def append (xs:(List a)) (ys:(List a)) : {v:(List a) | List.len v = List.len xs + List.len ys}
    decreasing_by [List.len xs] :=
    match xs with | nil => ys | cons x tail => List.cons x (append tail ys);

def product (xs:(List c)) (ys:(List d)) : {v:(List (Pair c d)) | List.len v = List.len xs * List.len ys}
    decreasing_by [List.len xs] := ?hole;
