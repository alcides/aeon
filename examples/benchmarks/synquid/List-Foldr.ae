# List-Foldr — Synquid PLDI16, pinned source in upstream/List-Foldr.sq
# Dependent tail-aware fold and abstract result relation; unused elems measure omitted.

inductive List a
| nil : {xs:(List a) | len xs = 0}
| cons (x:a) (xs:(List a)) : {ys:(List a) | len ys = 1 + len xs}
+ len (xs:(List a)) : {v:Int | v >= 0}

def foldr : forall a:B, forall b:B, forall <p:(List a) -> b -> Bool>,
    (f:(xs:(List a)) -> (x:a) -> (acc:{v:b | p xs v}) -> {v:b | p (List.cons x xs) v}) ->
    (seed:{v:b | p (List.nil{a}) v}) -> (ys:(List a)) -> {v:b | p ys v}
    decreasing_by [List.len ys] :=
    Λ a:B => Λ b:B => Λ <p:(List a) -> b -> Bool> => fun f => fun seed => fun ys =>
    ?hole;
