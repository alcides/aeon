# List-Append — Synquid PLDI16, pinned source in upstream/List-Append.sq
# Contract matches upstream; see manifest.json for vocabulary differences.

inductive List a
| nil : {xs:(List a) | len xs = 0}
| cons (x:a) (xs:(List a)) : {ys:(List a) | len ys = 1 + len xs}
+ len (xs:(List a)) : {v:Int | v >= 0}

def append (xs:(List a)) (ys:(List a)) : {v:(List a) | List.len v = List.len xs + List.len ys} decreasing_by [List.len xs] := ?hole;
