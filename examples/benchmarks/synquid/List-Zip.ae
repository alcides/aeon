# List-Zip — Synquid PLDI16, pinned source in upstream/List-Zip.sq
# Contract matches upstream; see manifest.json for vocabulary differences.

inductive Pair a b
| pair (x:a) (y:b) : (Pair a b)

inductive List a
| nil : {xs:(List a) | len xs = 0}
| cons (x:a) (xs:(List a)) : {ys:(List a) | len ys = 1 + len xs}
+ len (xs:(List a)) : {v:Int | v >= 0}

def zip (xs:(List c)) (ys:{v:(List d) | List.len v = List.len xs}) : {v:(List (Pair c d)) | List.len v = List.len xs}
    decreasing_by [List.len xs] := ?hole;
