# AddressBook-Make — Synquid PLDI16, pinned source in upstream/AddressBook-Make.sq
# Contract matches upstream; see manifest.json for vocabulary differences.

inductive List a
| nil : {xs:(List a) | len xs = 0}
| cons (x:a) (xs:(List a)) : {ys:(List a) | len ys = 1 + len xs}
+ len (xs:(List a)) : {v:Int | v >= 0}

def append (xs:(List a)) (ys:(List a)) : {v:(List a) | List.len v = List.len xs + List.len ys}
    decreasing_by [List.len xs] :=
    match xs with | nil => ys | cons x tail => List.cons x (append tail ys);

inductive Info
| info (streetAddr:Int) (zipcode:Int) (local:Bool) : Info

inductive Address
| address (info:Info) (priv:Bool) : {v:Address | isPriv v = priv}
+ isPriv (v:Address) : Bool

def getPriv (a:Address) : {v:Bool | v = Address.isPriv a} :=
    match a with | address info priv => priv;

inductive AddressBook
| addressBook (business:(List {v:Address | !(Address.isPriv v)})) (personal:(List {v:Address | Address.isPriv v})) : {v:AddressBook | size v = List.len business + List.len personal}
+ size (v:AddressBook) : {v:Int | v >= 0}

def mkAddressBook (adds:(List Address)) : {v:AddressBook | AddressBook.size v = List.len adds} decreasing_by [List.len adds] := ?hole;
