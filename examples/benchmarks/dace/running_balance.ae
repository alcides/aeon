# DACE category: running (cumulative) total -- a spatial scan down a column,
# e.g. an account balance. `cumsum` fills `balance` with the running sum.
open Table

def tx : {t:Table | rowCount t = 3 && intColumn t "amt"} := native "[{'d':1,'amt':10},{'d':2,'amt':-3},{'d':3,'amt':5}]";

def withbal : {t:Table | rowCount t = 3 && intColumn t "balance"} := tx.cumsum "amt" "balance";

def final_balance : Int := withbal.cell 2 "balance";  # 10 - 3 + 5 = 12

def main (x:Int) : Unit := print final_balance;
