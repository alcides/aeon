# Problem 1: Find the last element of a list.
# Uses a refinement to require the input list to be non-empty.

open Array

def Array.last (1 l: {x:(Array a) | Array.size x > 0}) : a := native "l[-1]"

def main (args:Int) : Unit :=
    let 1 xs := Array.mk_concat (Array.mk_2{Int} 1 2) (Array.mk_1{Int} 3);
    print xs.last;
