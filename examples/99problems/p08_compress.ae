# Problem 8: Eliminate consecutive duplicates of list elements.
# The compressed list cannot grow.

open Array

def Array.compress (1 l: (Array Int)) : {r:(Array Int) | Array.size r <= Array.size l} :=
    native "[x for i, x in enumerate(l) if i == 0 or x != l[i-1]]"

def main (args:Int) : Unit :=
    let 1 a: (Array Int)  := Array.mk_concat (Array.mk_4{Int} 1 1 2 3) (Array.mk_1{Int} 3);
    print a.compress
