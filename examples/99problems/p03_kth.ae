# Problem 3: Find the K'th element of a list (0-indexed).
# Refinement enforces that k is a valid index.

open Array

def kth (1 l: (Array a)) (k: {n:Int | n >= 0 && n < Array.size l}) : a := native "l[k]"

def main (args:Int) : Unit :=
    let 1 xs := Array.mk_4{Int} 10 20 30 40;
    print (kth xs 2);
