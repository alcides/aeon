# Problem 12: Decode a run-length encoded list.
# Inverse of Problem 10: each [count, value] pair expands to ``count`` copies of ``value``.

open Array

def decode (1 l: (Array (Array Int))) : (Array Int) :=
    native "[pair[1] for pair in l for _ in range(pair[0])]"

def main (args:Int) : Unit :=
    let 1 p1: (Array Int)  := Array.mk_2{Int} 3 1;
    let 1 p2: (Array Int)  := Array.mk_2{Int} 1 2;
    let 1 p3: (Array Int)  := Array.mk_2{Int} 2 3;
    let 1 enc1: (Array (Array Int))  := Array.mk_1{(Array Int)} p1;
    let 1 enc2: (Array (Array Int))  := Array.mk_concat enc1 (Array.mk_1 p2);
    let 1 enc: (Array (Array Int))  := Array.mk_concat enc2 (Array.mk_1 p3);
    print (decode enc)
