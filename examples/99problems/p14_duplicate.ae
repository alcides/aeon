# Problem 14: Duplicate the elements of a list.
# Refinement: the output has exactly twice the size of the input.

open Array

def duplicate (1 l: (Array Int)) : {r:(Array Int) | Array.size r = 2 * Array.size l} :=
    native "[x for x in l for _ in range(2)]"

def main (args:Int) : Unit :=
    let 1 a: (Array Int)  := Array.mk_concat (Array.mk_2{Int} 1 2) (Array.mk_1{Int} 3);
    print (duplicate a)
