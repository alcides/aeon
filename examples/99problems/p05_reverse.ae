# Problem 5: Reverse a list.
# Refinement: output has the same size as input.

open Array

def Array.rev (1 l: (Array a)) : {r:(Array a) | Array.size r = Array.size l} := native "l[::-1]"

def main (args:Int) : Unit :=
    let 1 xs := Array.mk_concat (Array.mk_2{Int} 1 2) (Array.mk_1{Int} 3);
    let 1 rs: (Array Int)  := xs.rev;
    print rs;
