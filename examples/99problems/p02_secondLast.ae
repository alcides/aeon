# Problem 2: Find the second-to-last element of a list.
# Refinement requires at least two elements.

open Array

def Array.secondLast (1 l: {x:(Array a) | Array.size x > 1}) : a := native "l[-2]"

def main (args:Int) : Unit :=
    let 1 xs := Array.mk_concat (Array.mk_2{Int} 1 2) (Array.mk_1{Int} 3);
    print xs.secondLast;
