# Problem 20: Remove the K'th element from a list (0-indexed).
# Refinement: k is a valid index, and output has size one less than input.

open Array

def remove_at (1 l: (Array Int)) (k: {x:Int | x >= 0 && x < Array.size l}) :
        {r:(Array Int) | Array.size r = Array.size l - 1} :=
    native "l[:k] + l[k+1:]"

def main (args:Int) : Unit :=
    let 1 a: {x:(Array Int) | Array.size x = 5} :=
        Array.mk_concat (Array.mk_4{Int} 10 20 30 40) (Array.mk_1{Int} 50);
    print (remove_at a 2)
