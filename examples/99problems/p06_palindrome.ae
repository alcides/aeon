# Problem 6: Detect whether a list is a palindrome.
# A list is a palindrome if it reads the same forwards and backwards.

open Array

def Array.isPalindrome (1 l: (Array Int)) : Bool := native "l == l[::-1]"

def main (args:Int) : Unit :=
    let 1 pal := Array.mk_concat (Array.mk_2{Int} 1 2) (Array.mk_1{Int} 1);
    let 1 notpal := Array.mk_concat (Array.mk_2{Int} 1 2) (Array.mk_1{Int} 3);
    _ := print pal.isPalindrome;
    print notpal.isPalindrome
