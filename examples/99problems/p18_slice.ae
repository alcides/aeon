# Problem 18: Extract a slice from a list.
# Given indices i and k (1-indexed, inclusive), return l[i..k].

open Array

def slice (1 l: (Array Int))
          (i: {x:Int | x >= 1 && x <= Array.size l})
          (k: {y:Int | y >= i && y <= Array.size l}) : (Array Int) :=
    native "l[i-1:k]"

def main (args:Int) : Unit :=
    let 1 a: {x:(Array Int) | Array.size x = 7} :=
        Array.mk_concat (Array.mk_concat (Array.mk_4{Int} 1 2 3 4) (Array.mk_2{Int} 5 6)) (Array.mk_1{Int} 7);
    print (slice a 3 5)
