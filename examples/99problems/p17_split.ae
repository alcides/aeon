# Problem 17: Split a list into two parts at the given position.
# Refinement: n must be a valid split point (0 <= n <= size l).

open Array

def split (1 l: (Array Int)) (n: {k:Int | k >= 0 && k <= Array.size l}) : (Array (Array Int)) :=
    native "[l[:n], l[n:]]"

def main (args:Int) : Unit :=
    let 1 a: {x:(Array Int) | Array.size x = 5} :=
        Array.mk_concat (Array.mk_4{Int} 1 2 3 4) (Array.mk_1{Int} 5);
    print (split a 2)
