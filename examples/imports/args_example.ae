open Args
open Array

# Build a parser with a flag and an option-with-default. We use parseList
# with an explicit empty argv so the example runs cleanly under
# `aeon args_example.ae` (which doesn't forward CLI args).

def parser : Parser :=
    p0 : Parser := Args.newParser "Demo CLI";
    p1 : Parser := if Args.canAdd p0 "greeting" then Args.addOption p0 "greeting" "Hello" "what to say" else p0;
    if Args.canAdd p1 "uppercase" then Args.addFlag p1 "uppercase" "shout instead of say" else p1

def emptyArgs (_: Unit) : (Array String)  := native "[]"

def main (_:Int) : Unit :=
    let 1 a : ParsedArgs := Args.parseList parser (emptyArgs unit) in
    g : String := if Args.hasString a "greeting" then Args.getString a "greeting" else "";
    let _ := Args.dispose a in
    print g
