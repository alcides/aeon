open Subprocess
open Array

# Build an argument vector — never a shell string, so there is nothing to
# inject — and run it. `run` requires a non-empty `Array String`; the
# `Array.size` postconditions of `mk_2` discharge that automatically.

def echoArgs (_: Unit) : {a: (Array String) | Array.size a >= 1} :=
    Array.mk_2{String} "echo" "hello"

# Inspect the exit code before trusting the output. `succeeded` ties the
# boolean to the `exitCode` measure, so the branch reads cleanly.
def main (_:Int) : Unit :=
    let 1 args := echoArgs unit in
    let 1 p : CompletedProcess := Subprocess.run args in
    let output := if Subprocess.succeeded p then Subprocess.stdout p else Subprocess.stderr p in
    let _ := Subprocess.dispose_result p in
    print output
