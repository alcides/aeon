open Stack

# push → peek → pop → discard
def demo (u: Unit) : Int :=
    let 1 s0 := new_stack{Int} u in
    let 1 s1 := push 1 s0 in
    let 1 s2 := push 2 s1 in
    let 1 pk := peek s2 in
    with_peek pk (fun top => fun s3 =>
        let 1 po := pop s3 in
        let 1 s4 := pop_stack po in
        let 1 po2 := pop s4 in
        let 1 s5 := pop_stack po2 in
        let _ := discard s5 in
        top);

def main (args: Int) : Unit := print "ok"
