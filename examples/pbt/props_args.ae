# Property-based tests and machine-checked examples for the Args library
# (argparse via FFI). See libraries/Args.ae.
#
# Two kinds of checks:
#
#   * @property — universally quantified over generated Int/Float inputs (drawn
#     from the synthesis grammar). The robust round-trip properties feed a value
#     as an option *default*, which argparse stores verbatim without re-parsing
#     it, so any generated value survives intact. prop_int_positional_roundtrips
#     additionally exercises the real argv parse path (the value is rendered to
#     a string and parsed back). Strings are covered by the @example tests
#     instead — random String generation is not supported as a property input.
#
#   * @example — concrete unit tests for the argv-parsing paths (flags,
#     options, choices, positionals, and string values) where a hand-picked
#     input keeps argparse away from its CLI edge cases (a leading '-' looks
#     like an option, etc.).
#
# Run with:  aeon --test examples/pbt/props_args.ae

open Args
open Array
open String

# ── argv constants (argparse consumes a list of strings) ─────────────────

def argvEmpty (_: Unit) : (Array String) := native "[]"
def argvAlice (_: Unit) : (Array String) := native "['alice']"
def argv42 (_: Unit) : (Array String) := native "['42']"
def argvRatio (_: Unit) : (Array String) := native "['1.5']"
def argvVerbose (_: Unit) : (Array String) := native "['--verbose']"
def argvOutFile (_: Unit) : (Array String) := native "['--out', 'file.txt']"
def argvNum99 (_: Unit) : (Array String) := native "['--num', '99']"
def argvModeSlow (_: Unit) : (Array String) := native "['--mode', 'slow']"

# Built with mk_2 so its size (2 > 0) is provable — addChoice requires
# a statically non-empty list of options.
def choicesModes (_: Unit) : {l : (Array String) | Array.size l > 0} :=
    Array.mk_2{String} "fast" "slow"

def singleton (x : String) : (Array String) := native "[x]"

# ── Properties: option defaults round-trip through argparse ───────────────
# An option's default is stored as-is, so for ANY generated value, building a
# parser with that default and parsing an empty argv must read it back equal.

@property
def prop_int_option_default_roundtrips (d : Int) : Bool :=
    p0 : Parser := Args.newParser "t";
    p : Parser := if Args.canAdd p0 "num" then Args.addIntOption p0 "num" d "" else p0;
    let 1 a : ParsedArgs := Args.parseList p (argvEmpty unit) in
    let result := (if Args.hasInt a "num" then Args.getInt a "num" else 0) = d in
    let _ := Args.dispose a in
    result;

@property
def prop_float_option_default_roundtrips (d : Float) : Bool :=
    p0 : Parser := Args.newParser "t";
    p : Parser := if Args.canAdd p0 "x" then Args.addFloatOption p0 "x" d "" else p0;
    let 1 a : ParsedArgs := Args.parseList p (argvEmpty unit) in
    let result := (if Args.hasFloat a "x" then Args.getFloat a "x" else 0.0) = d in
    let _ := Args.dispose a in
    result;

# (String inputs are exercised by the @example unit tests below rather than a
# @property: random String generation is not supported as a quantified input.)

# Full argv parse path: a non-negative int rendered to a string and parsed
# back as a positional must equal the original (non-negative avoids the
# leading-'-' argparse ambiguity).
@property
def prop_int_positional_roundtrips (d : {v : Int | v >= 0}) : Bool :=
    p0 : Parser := Args.newParser "t";
    p : Parser := if Args.canAdd p0 "count" then Args.addIntArg p0 "count" "" else p0;
    let 1 a : ParsedArgs := Args.parseList p (singleton (String.intToString d)) in
    let result := (if Args.hasInt a "count" then Args.getInt a "count" else 0) = d in
    let _ := Args.dispose a in
    result;

# ── Unit tests: argv parsing for each accessor / argument kind ────────────

# Required string positional.
@example(getName (argvAlice unit))
def getName (1 argv : (Array String)) : Bool :=
    p0 : Parser := Args.newParser "t";
    p : Parser := if Args.canAdd p0 "name" then Args.addArg p0 "name" "" else p0;
    let 1 a : ParsedArgs := Args.parseList p argv in
    let result := ((if Args.hasString a "name" then Args.getString a "name" else "")).equal "alice" in
    let _ := Args.dispose a in
    result;

# Required int positional.
@example(getCount (argv42 unit) = 42)
def getCount (1 argv : (Array String)) : Int :=
    p0 : Parser := Args.newParser "t";
    p : Parser := if Args.canAdd p0 "count" then Args.addIntArg p0 "count" "" else p0;
    let 1 a : ParsedArgs := Args.parseList p argv in
    let result := (if Args.hasInt a "count" then Args.getInt a "count" else 0) in
    let _ := Args.dispose a in
    result;

# Required float positional.
@example(getRatio (argvRatio unit) = 1.5)
def getRatio (1 argv : (Array String)) : Float :=
    p0 : Parser := Args.newParser "t";
    p : Parser := if Args.canAdd p0 "ratio" then Args.addFloatArg p0 "ratio" "" else p0;
    let 1 a : ParsedArgs := Args.parseList p argv in
    let result := (if Args.hasFloat a "ratio" then Args.getFloat a "ratio" else 0.0) in
    let _ := Args.dispose a in
    result;

# Boolean flag: true when present, false (the default) when absent.
@example(getVerbose (argvVerbose unit) = true)
@example(getVerbose (argvEmpty unit) = false)
def getVerbose (1 argv : (Array String)) : Bool :=
    p0 : Parser := Args.newParser "t";
    p : Parser := if Args.canAdd p0 "verbose" then Args.addFlag p0 "verbose" "" else p0;
    let 1 a : ParsedArgs := Args.parseList p argv in
    let result := (if Args.hasBool a "verbose" then Args.getBool a "verbose" else false) in
    let _ := Args.dispose a in
    result;

# String option: default when absent, supplied value when present.
@example(String.equal (getOut (argvEmpty unit)) "stdout")
@example(String.equal (getOut (argvOutFile unit)) "file.txt")
def getOut (1 argv : (Array String)) : String :=
    p0 : Parser := Args.newParser "t";
    p : Parser := if Args.canAdd p0 "out" then Args.addOption p0 "out" "stdout" "" else p0;
    let 1 a : ParsedArgs := Args.parseList p argv in
    let result := (if Args.hasString a "out" then Args.getString a "out" else "") in
    let _ := Args.dispose a in
    result;

# Int option: default when absent, supplied value when present.
@example(getNum (argvEmpty unit) = 10)
@example(getNum (argvNum99 unit) = 99)
def getNum (1 argv : (Array String)) : Int :=
    p0 : Parser := Args.newParser "t";
    p : Parser := if Args.canAdd p0 "num" then Args.addIntOption p0 "num" 10 "" else p0;
    let 1 a : ParsedArgs := Args.parseList p argv in
    let result := (if Args.hasInt a "num" then Args.getInt a "num" else 0) in
    let _ := Args.dispose a in
    result;

# Choice option restricted to a fixed set: default and a valid override.
@example(String.equal (getMode (argvEmpty unit)) "fast")
@example(String.equal (getMode (argvModeSlow unit)) "slow")
def getMode (1 argv : (Array String)) : String :=
    p0 : Parser := Args.newParser "t";
    let 1 p : Parser := if Args.canAdd p0 "mode" then Args.addChoice p0 "mode" (choicesModes unit) "fast" "" else p0 in
    let 1 a : ParsedArgs := Args.parseList p argv in
    let result := (if Args.hasString a "mode" then Args.getString a "mode" else "") in
    let _ := Args.dispose a in
    result;
