# Naive Bayes pipeline: MultinomialNB for nonnegative features, GaussianNB
# otherwise. Callers establish the frame/column contracts after read_csv.
# https://people.csail.mit.edu/jrennie/papers/icml03-nb.pdf
#
# SMOTE is applied to the training half only, after the split, so the
# held-out test set is never contaminated.

open Learning


def train_naive_bayes
    (1 df: {d: DataFrame | df_cols d > 1})
    (target_col: {s: String | hasColumn df s}) : SklearnClassifier :=
    let 1 ds0 := target df target_col false false in
    let 1 ds := require_enough_data ds0 in
    let 1 parts := split ds 0.7 true in
    let 1 train0 := train_of parts in
    let 1 train := if is_multiclass train0 && min_class_rows train0 >= 6 then smote train0 else train0 in
    if has_nonnegative_features train then multinomial_nb train else gaussian_nb train;
