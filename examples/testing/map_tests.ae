# Tests for the Map library (immutable key/value map). `size` is an
# uninterpreted measure (no runtime value), so tests observe behaviour through
# `get` / `has` / `delete`.
#
# Run with:  aeon --test examples/testing/map_tests.ae

open Testing
open Map
import Maybe

# ── Unit tests ───────────────────────────────────────────────────────────────

@property(1)
def test_get_after_set : Bool := assertEqual (get_or (set Map.new 1 100) 1 0) 100;

@property(1)
def test_has : Bool :=
    m := set Map.new 1 100;
    both (assertTrue (has m 1))
         (assertFalse (has m 2));

@property(1)
def test_overwrite : Bool :=
    m := set (set Map.new 1 100) 1 200;
    assertEqual (get_or m 1 0) 200;

@property(1)
def test_two_keys : Bool :=
    m := set (set Map.new 1 10) 2 20;
    both (assertEqual (get_or m 1 0) 10)
         (assertEqual (get_or m 2 0) 20);

@property(1)
def test_delete : Bool :=
    m := delete (set Map.new 1 100) 1;
    assertFalse (has m 1);

@property(1)
def test_delete_keeps_others : Bool :=
    m := delete (set (set Map.new 1 10) 2 20) 1;
    both (assertFalse (has m 1))
         (assertTrue (has m 2));

# ── Property-based tests (Int keys and values generated) ──────────────────────

# Whatever value you set for a key, you get it back.
@property
def prop_set_get_roundtrip (k : Int) (v : Int) : Bool :=
    assertEqual (get_or (set Map.new k v) k 0) v;

# A key is present right after being set.
@property
def prop_set_then_has (k : Int) (v : Int) : Bool :=
    assertTrue (has (set Map.new k v) k);

# A key is absent right after being deleted.
@property
def prop_delete_then_absent (k : Int) (v : Int) : Bool :=
    assertFalse (has (delete (set Map.new k v) k) k);

# The last write wins.
@property
def prop_last_write_wins (k : Int) (v1 : Int) (v2 : Int) : Bool :=
    assertEqual (get_or (set (set Map.new k v1) k v2) k 0) v2;

@property(1)
def test_missing_key_is_none : Bool := Maybe.isNone (get (set Map.new 1 10) 2);

@property(1)
def test_missing_key_uses_default : Bool := get_or (set Map.new 1 10) 2 99 = 99;

@property(1)
def test_present_key_is_just : Bool := Maybe.withDefault 99 (get (set Map.new 1 10) 1) = 10;
