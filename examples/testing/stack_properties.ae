import Stack

# Generate ordinary elements and build the linear handle through the real API.
# Checking size borrows the handle; pop twice and discard the empty stack.
@property(30)
def prop_stack_lifo (x:Int) (y:Int) : Bool :=
    let 1 empty := Stack.new_stack{Int} unit in
    let 1 one := Stack.push x empty in
    let 1 two := Stack.push y one in
    let count := Stack.length two in
    let 1 first := Stack.pop two in
    Stack.with_pop first (fun top => fun remaining =>
        let 1 second := Stack.pop remaining in
        Stack.with_pop second (fun bottom => fun final =>
            let done := Stack.discard final in
            count = 2 && top = y && bottom = x));
