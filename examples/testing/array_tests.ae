# Tests for the Array library (flat, native-backed sequence). Arrays are a
# ``linear type``: every owner is at multiplicity 1. ``length`` / ``empty``
# borrow the array; ``get`` / ``sum`` consume it. Updates consume the old
# owner and return a new one.
#
# Run with:  aeon --test examples/testing/array_tests.ae

open Testing
open Array

# ── Unit tests ───────────────────────────────────────────────────────────────

@property(1)
def test_mk_empty : Bool :=
    both (assertTrue (empty (Array.mk_empty unit)))
         (assertEqual (length (Array.mk_empty unit)) 0);

@property(1)
def test_mk_2_length : Bool :=
    let 1 arr := Array.mk_2 5 9 in
    let n := Array.length arr in
    both (assertEqual n 2) (assertEqual (sum arr) 14);

@property(1)
def test_mk_2_sum : Bool :=
    assertEqual (sum (Array.mk_2 5 9)) 14;

@property(1)
def test_get : Bool :=
    let 1 arr := Array.mk_2 5 9 in
    with_get (get_at arr 0) (fun v0 => fun arr2 =>
    let 1 g1 := get_at arr2 1 in
    both (assertEqual v0 5)
         (assertEqual (got_value g1) 9));

@property(1)
def test_mk_concat_order : Bool :=
    let 1 arr := mk_concat (mk_1 5) (mk_1 9) in
    with_get (get_at arr 0) (fun v0 => fun arr2 =>
    both (assertEqual v0 5)
         (assertEqual (get arr2 1) 9));

@property(1)
def test_head : Bool := assertEqual (head (mk_concat (mk_1 5) (mk_1 9))) 5;

@property(1)
def test_set_preserves_length : Bool :=
    let 1 arr := Array.mk_2 5 9 in
    let before := Array.length arr in
    let 1 updated := Array.set arr 0 7 in
    let after := Array.length updated in
    both (assertEqual before after) (assertEqual (get updated 0) 7);

@property(1)
def test_set_updates_element : Bool :=
    let 1 updated := Array.set (Array.mk_2 5 9) 0 7 in
    assertEqual (Array.get updated 0) 7;

@property(1)
def test_reversed : Bool :=
    let 1 arr := reversed (Array.mk_2 5 9) in
    with_get (get_at arr 0) (fun v0 => fun arr2 =>
    both (assertEqual v0 9)
         (assertEqual (get arr2 1) 5));

@property(1)
def test_map : Bool :=
    let 1 arr := map (fun x => x + 1) (Array.mk_2 5 9) in
    assertEqual (sum arr) 16;

@property(1)
def test_sum : Bool := assertEqual (sum (Array.mk_2 2 3)) 5;

# ``copy`` splits one linear reference into two independent arrays.
@property(1)
def test_copy_duplicates : Bool :=
    let 1 a := Array.mk_2 5 9 in
    with_pair (copy a) (fun left => fun right =>
    let count := length right in
    let _ := dispose right in
    both (assertEqual (sum left) 14)
         (assertEqual count 2));

# The two halves of a copy are independent: extending one leaves the other
# untouched.
@property(1)
def test_copy_independent : Bool :=
    let 1 a := Array.mk_2 1 2 in
    with_pair (copy a) (fun left => fun right =>
    let 1 l2 := Array.mk_concat left (Array.mk_1 9) in
    let n := length l2 in
    let m := length right in
    let _ := dispose l2 in
    let _ := dispose right in
    both (assertEqual n 3)
         (assertEqual m 2));

# ── Property-based tests (Int elements generated) ─────────────────────────────

@property
def prop_singleton_get (x : Int) : Bool :=
    assertEqual (get (Array.mk_1 x) 0) x;

@property
def prop_mk_2_length (x : Int) (y : Int) : Bool :=
    assertEqual (length (Array.mk_2 x y)) 2;

@property
def prop_set_overwrites (x : Int) (y : Int) : Bool :=
    let 1 arr := set (Array.mk_1 x) 0 y in
    let n := length arr in
    both (assertEqual (get arr 0) y)
         (assertEqual n 1);

@property
def prop_sum_two (x : Int) (y : Int) : Bool :=
    assertEqual (sum (Array.mk_2 x y)) (x + y);
