import Map

# The second key must differ from the first; synthesis enforces this directly.
@property(30)
def prop_delete_preserves_other_key
    (key:Int) (other:{v:Int | v != key}) (value:Int) (other_value:Int) : Bool :=
    original := Map.set (Map.set Map.new key value) other other_value;
    changed := Map.delete original key;
    !Map.has changed key && Map.has changed other && Map.get changed other = other_value &&
        Map.has original key && Map.get original key = value;

@property(30)
def prop_distinct_writes_commute
    (key:Int) (other:{v:Int | v != key}) (value:Int) (other_value:Int) : Bool :=
    left := Map.set (Map.set Map.new key value) other other_value;
    right := Map.set (Map.set Map.new other other_value) key value;
    Map.get left key = Map.get right key && Map.get left other = Map.get right other;
