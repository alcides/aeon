# knapsack_rosetta_code_unbounded_int: explicit prepared parameters {}
# GOAL: Maximize upstream objective within its declared domain.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/minizinc/knapsack_rosetta_code_unbounded_int.mzn
# Generated by scripts/import_hakank_flatzinc.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def decision0 : {v:Int | 0 <= v && v <= 10} := ?h_decision0;
def decision1 : {v:Int | 0 <= v && v <= 16} := ?h_decision1;
def decision2 : {v:Int | 0 <= v && v <= 12} := ?h_decision2;
def decision3 : {v:Int | 0 <= v && v <= 88800} := ?h_decision3;
def sequence0_tail3 : (Vec Int) := Vec.cons ((0 - 1)) (Vec.nil);
def sequence0_tail2 : (Vec Int) := Vec.cons (2500) (sequence0_tail3);
def sequence0_tail1 : (Vec Int) := Vec.cons (1800) (sequence0_tail2);
def sequence0_tail0 : (Vec Int) := Vec.cons (3000) (sequence0_tail1);
def sequence1_tail3 : (Vec Int) := Vec.cons (decision3) (Vec.nil);
def sequence1_tail2 : (Vec Int) := Vec.cons (decision2) (sequence1_tail3);
def sequence1_tail1 : (Vec Int) := Vec.cons (decision1) (sequence1_tail2);
def sequence1_tail0 : (Vec Int) := Vec.cons (decision0) (sequence1_tail1);

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := ((3 * decision0) + ((2 * decision1) + (20 * decision2))) <= 250;
def constraint1 : Bool := ((25 * decision0) + ((15 * decision1) + (2 * decision2))) <= 250;
def constraint2 : Bool := 0 <= decision0;
def constraint3 : Bool := 0 <= decision1;
def constraint4 : Bool := 0 <= decision2;
def constraint5 : Bool := Vec.dot (sequence0_tail0) (sequence1_tail0) = 0;
def valid : Bool := (((constraint0) && ((constraint1) && (constraint2))) && ((constraint3) && ((constraint4) && (constraint5))));

def objective : Int := 88800 - decision3;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print decision0 in
    let report1 := print decision1 in
    let report2 := print decision2 in
    let report3 := print decision3 in
    unit;
