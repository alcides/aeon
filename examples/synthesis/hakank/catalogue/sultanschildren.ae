import Vec;

def decision0 : {v:Int | 1 <= v && v <= 500} := ?h_decision0;
def decision1 : {v:Int | 1 <= v && v <= 500} := ?h_decision1;
def decision2 : {v:Int | 0 <= v && v <= 499} := ?h_decision2;
def decision3 : {v:Int | 0 <= v && v <= 249500} := ?h_decision3;
def decision4 : {v:Int | 2 <= v && v <= 1000} := ?h_decision4;
def decision5 : {v:Int | 1 <= v && v <= 999} := ?h_decision5;
def decision6 : {v:Int | 2 <= v && v <= 499000} := ?h_decision6;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := ((2 * decision3) + ((0 - 1) * decision6)) = 0;
def constraint1 : Bool := (((0 - 1) * decision0) + ((0 - 1) * decision1)) <= (0 - 100);
def constraint2 : Bool := ((1 * decision0) + (1 * decision1)) <= 500;
def constraint3 : Bool := ((1 * decision0) + ((0 - 1) * decision2)) = 1;
def constraint4 : Bool := decision3 = (decision0 * decision2);
def constraint5 : Bool := ((1 * decision0) + ((1 * decision1) + ((0 - 1) * decision4))) = 0;
def constraint6 : Bool := ((1 * decision1) + ((1 * decision0) + ((0 - 1) * decision5))) = 1;
def constraint7 : Bool := decision6 = (decision4 * decision5);
def valid : Bool := ((((constraint0) && (constraint1)) && ((constraint2) && (constraint3))) && (((constraint4) && (constraint5)) && ((constraint6) && (constraint7))));

def objective : Int := 0;
def score : Int := objective;

@require(valid)
@minimize_int(score)
