import Vec;

def decision0 : {v:Int | 2000000 <= v && v <= 9999999} := ?h_decision0;
def decision1 : {v:Int | 1000000 <= v && v <= 9999999} := ?h_decision1;
def decision2 : {v:Int | 2 <= v && v <= 10} := ?h_decision2;
def decision3 : {v:Int | 0 <= v && v <= 9} := ?h_decision3;
def decision4 : {v:Int | 0 <= v && v <= 9} := ?h_decision4;
def decision5 : {v:Int | 0 <= v && v <= 9} := ?h_decision5;
def decision6 : {v:Int | 0 <= v && v <= 9} := ?h_decision6;
def decision7 : {v:Int | 0 <= v && v <= 9} := ?h_decision7;
def decision8 : {v:Int | 0 <= v && v <= 9} := ?h_decision8;
def decision9 : {v:Int | 0 <= v && v <= 9} := ?h_decision9;
def sequence0_tail0 : (Vec Int) := Vec.cons (1) (Vec.cons ((0 - 1000000)) (Vec.cons ((0 - 100000)) (Vec.cons ((0 - 10000)) (Vec.cons ((0 - 1000)) (Vec.cons ((0 - 100)) (Vec.cons ((0 - 10)) (Vec.cons ((0 - 1)) (Vec.nil))))))));
def sequence1_tail0 : (Vec Int) := Vec.cons (decision0) (Vec.cons (decision9) (Vec.cons (decision8) (Vec.cons (decision7) (Vec.cons (decision6) (Vec.cons (decision5) (Vec.cons (decision4) (Vec.cons (decision3) (Vec.nil))))))));
def sequence2_tail0 : (Vec Int) := Vec.cons (decision1) (Vec.cons (decision3) (Vec.cons (decision4) (Vec.cons (decision5) (Vec.cons (decision6) (Vec.cons (decision7) (Vec.cons (decision8) (Vec.cons (decision9) (Vec.nil))))))));

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := ((1 * decision1) + ((0 - 1) * decision0)) <= (0 - 1);
def constraint1 : Bool := Vec.dot (sequence0_tail0) (sequence1_tail0) = 0;
def constraint2 : Bool := Vec.dot (sequence0_tail0) (sequence2_tail0) = 0;
def constraint3 : Bool := decision0 = (decision1 * decision2);
def valid : Bool := (((constraint0) && (constraint1)) && ((constraint2) && (constraint3)));

def objective : Int := 0;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

