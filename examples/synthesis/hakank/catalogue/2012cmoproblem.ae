# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := a >= b;
def constraint1 : Bool := p = a - b;
def constraint2 : Bool := a * b = n * n;
def constraint3 : Bool := Vec.contains p (sequence0_tail0);
def valid : Bool := (((constraint0) && (constraint1)) && ((constraint2) && (constraint3)));

def objective : Int := a;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print a in
    let report1 := print b in
    let report2 := print n in
    let report3 := print p in
    unit;
