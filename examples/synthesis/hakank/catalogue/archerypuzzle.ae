# archery_puzzle: explicit prepared parameters {}
# GOAL: Minimize upstream objective within its declared domain.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/minizinc/archery_puzzle.mzn
# Generated by scripts/import_hakank_flatzinc.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def decision0 : {v:Int | 0 <= v && v <= 10} := ?h_decision0;
def decision1 : {v:Int | 0 <= v && v <= 10} := ?h_decision1;
def decision2 : {v:Int | 0 <= v && v <= 10} := ?h_decision2;
def decision3 : {v:Int | 0 <= v && v <= 10} := ?h_decision3;
def decision4 : {v:Int | 0 <= v && v <= 10} := ?h_decision4;
def decision5 : {v:Int | 0 <= v && v <= 10} := ?h_decision5;
def decision6 : {v:Int | 0 <= v && v <= 1490} := ?h_decision6;
def decision7 : {v:Int | (0 - 1490) <= v && v <= 100} := ?h_decision7;
def sequence0_tail0 : (Vec Int) := Vec.cons ((0 - 16)) (Vec.cons ((0 - 17)) (Vec.cons ((0 - 23)) (Vec.cons ((0 - 24)) (Vec.cons ((0 - 39)) (Vec.cons ((0 - 40)) (Vec.cons ((0 - 1)) (Vec.nil)))))));
def sequence1_tail0 : (Vec Int) := Vec.cons (decision0) (Vec.cons (decision1) (Vec.cons (decision2) (Vec.cons (decision3) (Vec.cons (decision4) (Vec.cons (decision5) (Vec.cons (decision7) (Vec.nil)))))));

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := decision6 = Vec.absolute (decision7);
def constraint1 : Bool := Vec.dot (sequence0_tail0) (sequence1_tail0) = (0 - 100);
def valid : Bool := ((constraint0) && (constraint1));

def objective : Int := decision6 - 0;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print decision0 in
    let report1 := print decision1 in
    let report2 := print decision2 in
    let report3 := print decision3 in
    let report4 := print decision4 in
    let report5 := print decision5 in
    let report6 := print decision6 in
    let report7 := print decision7 in
    unit;
