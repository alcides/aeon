import Vec;

def decision0 : {v:Int | 4 <= v && v <= 999} := ?h_decision0;
def decision1 : {v:Int | 2 <= v && v <= 999} := ?h_decision1;
def decision2 : {v:Int | 2 <= v && v <= 999} := ?h_decision2;
def decision3 : {v:Int | 1 <= v && v <= 2} := ?h_decision3;
def decision4 : {v:Int | 1 <= v && v <= 4} := ?h_decision4;
def division_aux5 : {v:Int | (0 - 999) <= v && v <= 999} := ?h_division_aux5;
def division_aux6 : {v:Int | (0 - 999) <= v && v <= 999} := ?h_division_aux6;
def division_aux7 : {v:Int | (0 - 999) <= v && v <= 999} := ?h_division_aux7;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := ((1 * decision1) + ((0 - 1) * decision2)) <= 0;
def constraint1 : Bool := (((2 != 0) && (decision0 = (2 * division_aux5) + 1)) && ((1 < (Vec.absolute (2))) && (((0 - (Vec.absolute (2))) < 1) && ((decision0 >= 0 && 1 >= 0) || (decision0 <= 0 && 1 <= 0)))));
def constraint2 : Bool := (((3 != 0) && (decision0 = (3 * division_aux6) + decision3)) && ((decision3 < (Vec.absolute (3))) && (((0 - (Vec.absolute (3))) < decision3) && ((decision0 >= 0 && decision3 >= 0) || (decision0 <= 0 && decision3 <= 0)))));
def constraint3 : Bool := (((5 != 0) && (decision0 = (5 * division_aux7) + decision4)) && ((decision4 < (Vec.absolute (5))) && (((0 - (Vec.absolute (5))) < decision4) && ((decision0 >= 0 && decision4 >= 0) || (decision0 <= 0 && decision4 <= 0)))));
def constraint4 : Bool := decision0 = (decision1 * decision2);
def valid : Bool := (((constraint0) && (constraint1)) && ((constraint2) && ((constraint3) && (constraint4))));

def objective : Int := 0;
