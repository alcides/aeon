# 12packproblem: packs [7,13], request 20, count limit 1000
# GOAL: Minimize bottles purchased while supplying at least 20 bottles.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/cpmpy/12_pack_problem.py
# Generated by scripts/generate_hakank_manual.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def pack0 : {v:Int | 0 <= v && v <= 1000} := ?h_pack0;
def pack1 : {v:Int | 0 <= v && v <= 1000} := ?h_pack1;
def bottles : {v:Int | 0 <= v && v <= 2000} := ?h_bottles;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := bottles = ((7 * pack0) + (13 * pack1));
def constraint1 : Bool := bottles >= 20;
def valid : Bool := ((constraint0) && (constraint1));

def objective : Int := bottles;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print pack0 in
    let report1 := print pack1 in
    let report2 := print bottles in
    unit;
