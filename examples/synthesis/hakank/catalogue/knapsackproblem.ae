# knapsack_problem: explicit prepared parameters {}
# GOAL: Maximize upstream objective within its declared domain.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/minizinc/knapsack_problem.mzn
# Generated by scripts/import_hakank_flatzinc.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def decision0 : {v:Int | 0 <= v && v <= 1} := ?h_decision0;
def decision1 : {v:Int | 0 <= v && v <= 1} := ?h_decision1;
def decision2 : {v:Int | 0 <= v && v <= 1} := ?h_decision2;
def decision3 : {v:Float | 0.0 <= v && v <= 73000000.0} := ?h_decision3;
def decision4 : {v:Float | 0.0 <= v && v <= 10000.0} := ?h_decision4;
def decision5 : {v:Float | 0.0 <= v && v <= 10000.0} := ?h_decision5;
def decision6 : {v:Float | 0.0 <= v && v <= 10000.0} := ?h_decision6;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := (((0.0 - 3000.0) * decision4) + (((0.0 - 1800.0) * decision5) + ((0.0 - 2500.0) * decision6))) <= 0.0;
def constraint1 : Bool := ((0.025 * decision4) + ((0.015 * decision5) + (0.002 * decision6))) <= 0.25;
def constraint2 : Bool := ((0.3 * decision4) + ((0.2 * decision5) + (2.0 * decision6))) <= 25.0;
def constraint3 : Bool := (((3000.0 * decision4) + (1800.0 * decision5)) + ((2500.0 * decision6) + ((0.0 - 1.0) * decision3))) = -0.0;
def constraint4 : Bool := decision4 = Vec.toFloat (decision0);
def constraint5 : Bool := decision5 = Vec.toFloat (decision1);
def constraint6 : Bool := decision6 = Vec.toFloat (decision2);
def valid : Bool := (((constraint0) && ((constraint1) && (constraint2))) && (((constraint3) && (constraint4)) && ((constraint5) && (constraint6))));

def objective : Float := 73000000.0 - decision3;
def score : Float := objective;

@require(valid)
@minimize_float(score)
def benchmark : Float := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print decision0 in
    let report1 := print decision1 in
    let report2 := print decision2 in
    let report3 := print decision3 in
    let report4 := print decision4 in
    let report5 := print decision5 in
    let report6 := print decision6 in
    unit;
