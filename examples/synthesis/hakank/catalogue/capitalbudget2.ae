import Vec;

def decision0 : {v:Int | 0 <= v && v <= 1} := ?h_decision0;
def decision1 : {v:Int | 0 <= v && v <= 1} := ?h_decision1;
def decision2 : {v:Int | 0 <= v && v <= 1} := ?h_decision2;
def decision3 : {v:Int | 0 <= v && v <= 1} := ?h_decision3;
def decision4 : {v:Int | 0 <= v && v <= 58} := ?h_decision4;
def sequence0_tail3 : (Vec Int) := Vec.cons (3) (Vec.nil);
def sequence0_tail2 : (Vec Int) := Vec.cons (4) (sequence0_tail3);
def sequence0_tail1 : (Vec Int) := Vec.cons (7) (sequence0_tail2);
def sequence0_tail0 : (Vec Int) := Vec.cons (5) (sequence0_tail1);
def sequence1_tail3 : (Vec Int) := Vec.cons (decision3) (Vec.nil);
def sequence1_tail2 : (Vec Int) := Vec.cons (decision2) (sequence1_tail3);
def sequence1_tail1 : (Vec Int) := Vec.cons (decision1) (sequence1_tail2);
def sequence1_tail0 : (Vec Int) := Vec.cons (decision0) (sequence1_tail1);
def sequence2_tail4 : (Vec Int) := Vec.cons ((0 - 1)) (Vec.nil);
def sequence2_tail3 : (Vec Int) := Vec.cons (8) (sequence2_tail4);
def sequence2_tail2 : (Vec Int) := Vec.cons (12) (sequence2_tail3);
def sequence2_tail1 : (Vec Int) := Vec.cons (22) (sequence2_tail2);
def sequence2_tail0 : (Vec Int) := Vec.cons (16) (sequence2_tail1);
def sequence3_tail4 : (Vec Int) := Vec.cons (decision4) (Vec.nil);
def sequence3_tail3 : (Vec Int) := Vec.cons (decision3) (sequence3_tail4);
