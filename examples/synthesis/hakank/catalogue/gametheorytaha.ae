# game_theory_taha: explicit prepared parameters {}
# GOAL: Maximize upstream objective within its declared domain.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/minizinc/game_theory_taha.mzn
# Generated by scripts/import_hakank_flatzinc.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def decision0 : {v:Float | 0.0 <= v && v <= 1.0} := ?h_decision0;
def decision1 : {v:Float | 0.0 <= v && v <= 1.0} := ?h_decision1;
def decision2 : {v:Float | 0.0 <= v && v <= 1.0} := ?h_decision2;
def decision3 : {v:Float | (0.0 - 2.0) <= v && v <= 2.0} := ?h_decision3;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := (((1.0 * decision3) + ((0.0 - 3.0) * decision0)) + ((2.0 * decision1) + (5.0 * decision2))) <= -0.0;
def constraint1 : Bool := (((1.0 * decision3) + (1.0 * decision0)) + (((0.0 - 4.0) * decision1) + (6.0 * decision2))) <= -0.0;
def constraint2 : Bool := (((1.0 * decision3) + (3.0 * decision0)) + ((1.0 * decision1) + ((0.0 - 2.0) * decision2))) <= -0.0;
def constraint3 : Bool := -0.0 <= decision0;
def constraint4 : Bool := -0.0 <= decision1;
def constraint5 : Bool := -0.0 <= decision2;
def constraint6 : Bool := ((1.0 * decision0) + ((1.0 * decision1) + (1.0 * decision2))) = 1.0;
def valid : Bool := (((constraint0) && ((constraint1) && (constraint2))) && (((constraint3) && (constraint4)) && ((constraint5) && (constraint6))));

def objective : Float := 2.0 - decision3;
def score : Float := objective;

@require(valid)
@minimize_float(score)
def benchmark : Float := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print decision0 in
    let report1 := print decision1 in
    let report2 := print decision2 in
    let report3 := print decision3 in
    unit;
