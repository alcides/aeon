# exactly: four values in 1..4; value in 1..4, occurrence count in 2..3
# GOAL: Synthesize a sequence, a value, and an exact occurrence count of two or three.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/picat/exactly.pi
# Generated by scripts/generate_hakank_globals.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def x0 : {v:Int | 1 <= v && v <= 4} := ?h_x0;
def x1 : {v:Int | 1 <= v && v <= 4} := ?h_x1;
def x2 : {v:Int | 1 <= v && v <= 4} := ?h_x2;
def x3 : {v:Int | 1 <= v && v <= 4} := ?h_x3;
def value : {v:Int | 1 <= v && v <= 4} := ?h_value;
def occurrences : {v:Int | 2 <= v && v <= 3} := ?h_occurrences;
def sequence0_tail0 : (Vec Int) := Vec.cons (x0) (Vec.cons (x1) (Vec.cons (x2) (Vec.cons (x3) (Vec.nil))));

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := Vec.count value (sequence0_tail0) = occurrences;
def valid : Bool := (constraint0);

def objective : Int := 0;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

