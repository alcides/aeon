# number_square: explicit prepared parameters {}
# GOAL: Find a feasible assignment (score 0).
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/minizinc/number_square.mzn
# Generated by scripts/import_hakank_flatzinc.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def decision0 : {v:Int | 10000000 <= v && v <= 99999999} := ?h_decision0;
def decision1 : {v:Int | 0 <= v && v <= 20000} := ?h_decision1;
def decision2 : {v:Int | 0 <= v && v <= 20000} := ?h_decision2;
def decision3 : {v:Int | 110000000 <= v && v <= 199999999} := ?h_decision3;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := ((1 * decision0) + ((0 - 1) * decision3)) = (0 - 100000000);
def constraint1 : Bool := decision0 = (decision1 * decision1);
def constraint2 : Bool := decision3 = (decision2 * decision2);
def valid : Bool := ((constraint0) && ((constraint1) && (constraint2)));

def objective : Int := 0;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print decision0 in
    let report1 := print decision1 in
    let report2 := print decision2 in
    let report3 := print decision3 in
    unit;
