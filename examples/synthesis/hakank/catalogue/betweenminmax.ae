import Vec;

def decision0 : {v:Int | 3 <= v && v <= 3} := ?h_decision0;
def decision1 : {v:Int | 1 <= v && v <= 1} := ?h_decision1;
def decision2 : {v:Int | 8 <= v && v <= 8} := ?h_decision2;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := 1 = (if 1 <= 1 then 1 else 1);
def constraint1 : Bool := 1 = (if 4 <= 1 then 4 else 1);
def constraint2 : Bool := 1 = (if 8 <= 1 then 8 else 1);
def constraint3 : Bool := 1 = (if 1 >= 1 then 1 else 1);
def constraint4 : Bool := 4 = (if 4 >= 1 then 4 else 1);
def constraint5 : Bool := 8 = (if 8 >= 4 then 8 else 4);
def valid : Bool := (((constraint0) && ((constraint1) && (constraint2))) && ((constraint3) && ((constraint4) && (constraint5))));

def objective : Int := 0;
