# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := (((10 != 0) && (170 = (10 * division_aux5) + decision2)) && ((decision2 < (Vec.absolute (10))) && (((0 - (Vec.absolute (10))) < decision2) && ((170 >= 0 && decision2 >= 0) || (170 <= 0 && decision2 <= 0)))));
