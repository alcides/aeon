# set_covering6: explicit prepared parameters {}
# GOAL: Minimize upstream objective within its declared domain.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/minizinc/set_covering6.mzn
# Generated by scripts/import_hakank_flatzinc.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def decision0 : {v:Int | 0 <= v && v <= 1} := ?h_decision0;
def decision1 : {v:Int | 0 <= v && v <= 1} := ?h_decision1;
def decision2 : {v:Int | 0 <= v && v <= 1} := ?h_decision2;
def decision3 : {v:Int | 0 <= v && v <= 1} := ?h_decision3;
def decision4 : {v:Int | 0 <= v && v <= 100} := ?h_decision4;
def sequence0_tail0 : (Vec Int) := Vec.cons (1) (Vec.cons ((0 - 50)) (Vec.cons ((0 - 20)) (Vec.cons ((0 - 15)) (Vec.cons ((0 - 15)) (Vec.nil)))));
def sequence1_tail0 : (Vec Int) := Vec.cons (decision4) (Vec.cons (decision0) (Vec.cons (decision1) (Vec.cons (decision2) (Vec.cons (decision3) (Vec.nil)))));

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := (((0 - 1) * decision0) + ((0 - 1) * decision2)) <= (0 - 1);
def constraint1 : Bool := (((0 - 1) * decision0) + (((0 - 1) * decision1) + ((0 - 1) * decision2))) <= (0 - 1);
def constraint2 : Bool := (((0 - 1) * decision0) + (((0 - 1) * decision1) + ((0 - 1) * decision3))) <= (0 - 1);
def constraint3 : Bool := Vec.dot (sequence0_tail0) (sequence1_tail0) = 0;
def valid : Bool := (((constraint0) && (constraint1)) && ((constraint2) && (constraint3)));

def objective : Int := decision4 - 0;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print decision0 in
    let report1 := print decision1 in
    let report2 := print decision2 in
    let report3 := print decision3 in
    let report4 := print decision4 in
    unit;
