import Vec;

def decision0 : {v:Float | 0.0 <= v && v <= 6000.0} := ?h_decision0;
def decision1 : {v:Float | 0.0 <= v && v <= 4000.0} := ?h_decision1;
def decision2 : {v:Float | 0.0 <= v && v <= 270000.0} := ?h_decision2;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := ((0.005 * decision0) + (0.007142857142857143 * decision1)) <= 40.0;
def constraint1 : Bool := ((25.0 * decision0) + ((30.0 * decision1) + ((0.0 - 1.0) * decision2))) = -0.0;
def valid : Bool := ((constraint0) && (constraint1));

def objective : Float := 270000.0 - decision2;
def score : Float := objective;

@require(valid)
@minimize_float(score)
def benchmark : Float := score;

