import Vec;

def value : {v:Int | 0 <= v && v <= 9} := ?h_value;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := 0 = value || 0 = value;
def constraint1 : Bool := 1 = value || 0 = value;
def constraint2 : Bool := 0 = value || 0 = value;
def constraint3 : Bool := 0 = value || 1 = value;
def constraint4 : Bool := 1 = value || 0 = value;
def valid : Bool := (((constraint0) && (constraint1)) && ((constraint2) && ((constraint3) && (constraint4))));

def objective : Int := 0;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

