# schedule1: seven cumulative tasks, capacity 13, integer starts 1..30 (upstream data)
# GOAL: Minimize completion time without exceeding resource capacity.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/cpmpy/schedule1.py
# Generated by scripts/generate_hakank_examples.py; all decisions remain holes.
# Infeasible assignments score 1000000; every feasible score is smaller.

def s0 : {v:Int | 1 <= v && v <= 30} := ?h_s0;
def s1 : {v:Int | 1 <= v && v <= 30} := ?h_s1;
def s2 : {v:Int | 1 <= v && v <= 30} := ?h_s2;
def s3 : {v:Int | 1 <= v && v <= 30} := ?h_s3;
def s4 : {v:Int | 1 <= v && v <= 30} := ?h_s4;
def s5 : {v:Int | 1 <= v && v <= 30} := ?h_s5;
def s6 : {v:Int | 1 <= v && v <= 30} := ?h_s6;
def makespan : {v:Int | 1 <= v && v <= 50} := ?h_makespan;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := s0 + 16 <= makespan;
def constraint1 : Bool := s1 + 6 <= makespan;
def constraint2 : Bool := s2 + 13 <= makespan;
def constraint3 : Bool := s3 + 7 <= makespan;
def constraint4 : Bool := s4 + 5 <= makespan;
def constraint5 : Bool := s5 + 18 <= makespan;
def constraint6 : Bool := s6 + 4 <= makespan;
def constraint7 : Bool := (((2 * (if s0 <= s0 && s0 < s0 + 16 then 1 else 0)) + ((9 * (if s1 <= s0 && s0 < s1 + 6 then 1 else 0)) + (3 * (if s2 <= s0 && s0 < s2 + 13 then 1 else 0)))) + (((7 * (if s3 <= s0 && s0 < s3 + 7 then 1 else 0)) + (10 * (if s4 <= s0 && s0 < s4 + 5 then 1 else 0))) + ((1 * (if s5 <= s0 && s0 < s5 + 18 then 1 else 0)) + (11 * (if s6 <= s0 && s0 < s6 + 4 then 1 else 0))))) <= 13;
def constraint8 : Bool := (((2 * (if s0 <= s1 && s1 < s0 + 16 then 1 else 0)) + ((9 * (if s1 <= s1 && s1 < s1 + 6 then 1 else 0)) + (3 * (if s2 <= s1 && s1 < s2 + 13 then 1 else 0)))) + (((7 * (if s3 <= s1 && s1 < s3 + 7 then 1 else 0)) + (10 * (if s4 <= s1 && s1 < s4 + 5 then 1 else 0))) + ((1 * (if s5 <= s1 && s1 < s5 + 18 then 1 else 0)) + (11 * (if s6 <= s1 && s1 < s6 + 4 then 1 else 0))))) <= 13;
def constraint9 : Bool := (((2 * (if s0 <= s2 && s2 < s0 + 16 then 1 else 0)) + ((9 * (if s1 <= s2 && s2 < s1 + 6 then 1 else 0)) + (3 * (if s2 <= s2 && s2 < s2 + 13 then 1 else 0)))) + (((7 * (if s3 <= s2 && s2 < s3 + 7 then 1 else 0)) + (10 * (if s4 <= s2 && s2 < s4 + 5 then 1 else 0))) + ((1 * (if s5 <= s2 && s2 < s5 + 18 then 1 else 0)) + (11 * (if s6 <= s2 && s2 < s6 + 4 then 1 else 0))))) <= 13;
def constraint10 : Bool := (((2 * (if s0 <= s3 && s3 < s0 + 16 then 1 else 0)) + ((9 * (if s1 <= s3 && s3 < s1 + 6 then 1 else 0)) + (3 * (if s2 <= s3 && s3 < s2 + 13 then 1 else 0)))) + (((7 * (if s3 <= s3 && s3 < s3 + 7 then 1 else 0)) + (10 * (if s4 <= s3 && s3 < s4 + 5 then 1 else 0))) + ((1 * (if s5 <= s3 && s3 < s5 + 18 then 1 else 0)) + (11 * (if s6 <= s3 && s3 < s6 + 4 then 1 else 0))))) <= 13;
def constraint11 : Bool := (((2 * (if s0 <= s4 && s4 < s0 + 16 then 1 else 0)) + ((9 * (if s1 <= s4 && s4 < s1 + 6 then 1 else 0)) + (3 * (if s2 <= s4 && s4 < s2 + 13 then 1 else 0)))) + (((7 * (if s3 <= s4 && s4 < s3 + 7 then 1 else 0)) + (10 * (if s4 <= s4 && s4 < s4 + 5 then 1 else 0))) + ((1 * (if s5 <= s4 && s4 < s5 + 18 then 1 else 0)) + (11 * (if s6 <= s4 && s4 < s6 + 4 then 1 else 0))))) <= 13;
def constraint12 : Bool := (((2 * (if s0 <= s5 && s5 < s0 + 16 then 1 else 0)) + ((9 * (if s1 <= s5 && s5 < s1 + 6 then 1 else 0)) + (3 * (if s2 <= s5 && s5 < s2 + 13 then 1 else 0)))) + (((7 * (if s3 <= s5 && s5 < s3 + 7 then 1 else 0)) + (10 * (if s4 <= s5 && s5 < s4 + 5 then 1 else 0))) + ((1 * (if s5 <= s5 && s5 < s5 + 18 then 1 else 0)) + (11 * (if s6 <= s5 && s5 < s6 + 4 then 1 else 0))))) <= 13;
def constraint13 : Bool := (((2 * (if s0 <= s6 && s6 < s0 + 16 then 1 else 0)) + ((9 * (if s1 <= s6 && s6 < s1 + 6 then 1 else 0)) + (3 * (if s2 <= s6 && s6 < s2 + 13 then 1 else 0)))) + (((7 * (if s3 <= s6 && s6 < s3 + 7 then 1 else 0)) + (10 * (if s4 <= s6 && s6 < s4 + 5 then 1 else 0))) + ((1 * (if s5 <= s6 && s6 < s5 + 18 then 1 else 0)) + (11 * (if s6 <= s6 && s6 < s6 + 4 then 1 else 0))))) <= 13;
def valid : Bool := ((((constraint0) && ((constraint1) && (constraint2))) && (((constraint3) && (constraint4)) && ((constraint5) && (constraint6)))) && (((constraint7) && ((constraint8) && (constraint9))) && (((constraint10) && (constraint11)) && ((constraint12) && (constraint13)))));

def objective : Int := makespan;
def score : Int := if valid then objective else 1000000;

@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print s0 in
    let report1 := print s1 in
    let report2 := print s2 in
    let report3 := print s3 in
    let report4 := print s4 in
    let report5 := print s5 in
    let report6 := print s6 in
    let report7 := print makespan in
    unit;
