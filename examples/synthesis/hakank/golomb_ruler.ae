# golomb_ruler: four ordered marks, upper bound 10 (reduced instance)
# GOAL: Minimize ruler length with distinct pairwise distances.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/z3/golomb_ruler.py
# Generated by scripts/generate_hakank_examples.py; all decisions remain holes.
# Infeasible assignments score 1000000; every feasible score is smaller.

def x0 : {v:Int | 0 <= v && v <= 10} := ?h_x0;
def x1 : {v:Int | 0 <= v && v <= 10} := ?h_x1;
def x2 : {v:Int | 0 <= v && v <= 10} := ?h_x2;
def x3 : {v:Int | 0 <= v && v <= 10} := ?h_x3;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := x0 = 0;
def constraint1 : Bool := x0 < x1;
def constraint2 : Bool := x1 < x2;
def constraint3 : Bool := x2 < x3;
def constraint4 : Bool := (x1 - x0) != (x2 - x0);
def constraint5 : Bool := (x1 - x0) != (x3 - x0);
def constraint6 : Bool := (x1 - x0) != (x2 - x1);
def constraint7 : Bool := (x1 - x0) != (x3 - x1);
def constraint8 : Bool := (x1 - x0) != (x3 - x2);
def constraint9 : Bool := (x2 - x0) != (x3 - x0);
def constraint10 : Bool := (x2 - x0) != (x2 - x1);
def constraint11 : Bool := (x2 - x0) != (x3 - x1);
def constraint12 : Bool := (x2 - x0) != (x3 - x2);
def constraint13 : Bool := (x3 - x0) != (x2 - x1);
def constraint14 : Bool := (x3 - x0) != (x3 - x1);
def constraint15 : Bool := (x3 - x0) != (x3 - x2);
def constraint16 : Bool := (x2 - x1) != (x3 - x1);
def constraint17 : Bool := (x2 - x1) != (x3 - x2);
def constraint18 : Bool := (x3 - x1) != (x3 - x2);
def valid : Bool := (((((constraint0) && (constraint1)) && ((constraint2) && (constraint3))) && (((constraint4) && (constraint5)) && ((constraint6) && ((constraint7) && (constraint8))))) && ((((constraint9) && (constraint10)) && ((constraint11) && ((constraint12) && (constraint13)))) && (((constraint14) && (constraint15)) && ((constraint16) && ((constraint17) && (constraint18))))));

def objective : Int := x3;
def score : Int := if valid then objective else 1000000;

@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print x0 in
    let report1 := print x1 in
    let report2 := print x2 in
    let report3 := print x3 in
    unit;
