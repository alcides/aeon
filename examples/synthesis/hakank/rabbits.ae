# rabbits: nine rabbits/pheasants with 24 legs (upstream data)
# GOAL: Find a feasible assignment (score 0).
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/z3/rabbits.py
# Generated by scripts/generate_hakank_examples.py; all decisions remain holes.
# Infeasible assignments score 1000000; every feasible score is smaller.

def rabbits : {v:Int | 0 <= v && v <= 9} := ?h_rabbits;
def pheasants : {v:Int | 0 <= v && v <= 9} := ?h_pheasants;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := rabbits + pheasants = 9;
def constraint1 : Bool := 4 * rabbits + 2 * pheasants = 24;
def valid : Bool := ((constraint0) && (constraint1));

def objective : Int := 0;
def score : Int := if valid then objective else 1000000;

@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print rabbits in
    let report1 := print pheasants in
    unit;
