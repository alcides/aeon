# knapsack: 11 binary items, capacity 102 (upstream data)
# GOAL: Maximize item value (minimize 455 minus value).
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/z3/knapsack.py
# Generated by scripts/generate_hakank_examples.py; all decisions remain holes.
# Infeasible assignments score 1000000; every feasible score is smaller.

def x0 : {v:Int | 0 <= v && v <= 1} := ?h_x0;
def x1 : {v:Int | 0 <= v && v <= 1} := ?h_x1;
def x2 : {v:Int | 0 <= v && v <= 1} := ?h_x2;
def x3 : {v:Int | 0 <= v && v <= 1} := ?h_x3;
def x4 : {v:Int | 0 <= v && v <= 1} := ?h_x4;
def x5 : {v:Int | 0 <= v && v <= 1} := ?h_x5;
def x6 : {v:Int | 0 <= v && v <= 1} := ?h_x6;
def x7 : {v:Int | 0 <= v && v <= 1} := ?h_x7;
def x8 : {v:Int | 0 <= v && v <= 1} := ?h_x8;
def x9 : {v:Int | 0 <= v && v <= 1} := ?h_x9;
def x10 : {v:Int | 0 <= v && v <= 1} := ?h_x10;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := ((((2 * x0) + (20 * x1)) + ((20 * x2) + ((30 * x3) + (40 * x4)))) + (((30 * x5) + ((60 * x6) + (10 * x7))) + ((21 * x8) + ((12 * x9) + (2 * x10))))) <= 102;
def valid : Bool := (constraint0);

def objective : Int := 455 - ((((15 * x0) + (100 * x1)) + ((90 * x2) + ((60 * x3) + (40 * x4)))) + (((15 * x5) + ((10 * x6) + (1 * x7))) + ((12 * x8) + ((12 * x9) + (100 * x10)))));
def score : Int := if valid then objective else 1000000;

@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print x0 in
    let report1 := print x1 in
    let report2 := print x2 in
    let report3 := print x3 in
    let report4 := print x4 in
    let report5 := print x5 in
    let report6 := print x6 in
    let report7 := print x7 in
    let report8 := print x8 in
    let report9 := print x9 in
    let report10 := print x10 in
    unit;
