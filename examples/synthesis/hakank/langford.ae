# langford: k=3, positions of two copies (reduced instance)
# GOAL: Find a feasible assignment (score 0).
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/z3/langford.py
# Generated by scripts/generate_hakank_examples.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def p0 : {v:Int | 0 <= v && v <= 5} := ?h_p0;
def p1 : {v:Int | 0 <= v && v <= 5} := ?h_p1;
def p2 : {v:Int | 0 <= v && v <= 5} := ?h_p2;
def p3 : {v:Int | 0 <= v && v <= 5} := ?h_p3;
def p4 : {v:Int | 0 <= v && v <= 5} := ?h_p4;
def p5 : {v:Int | 0 <= v && v <= 5} := ?h_p5;
def sequence0_tail5 : (Vec Int) := Vec.cons (p5) (Vec.nil);
def sequence0_tail4 : (Vec Int) := Vec.cons (p4) (sequence0_tail5);
def sequence0_tail3 : (Vec Int) := Vec.cons (p3) (sequence0_tail4);
def sequence0_tail2 : (Vec Int) := Vec.cons (p2) (sequence0_tail3);
def sequence0_tail1 : (Vec Int) := Vec.cons (p1) (sequence0_tail2);
def sequence0_tail0 : (Vec Int) := Vec.cons (p0) (sequence0_tail1);

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := Vec.allDifferent (sequence0_tail0);
def constraint1 : Bool := p3 = p0 + 2;
def constraint2 : Bool := p4 = p1 + 3;
def constraint3 : Bool := p5 = p2 + 4;
def valid : Bool := (((constraint0) && (constraint1)) && ((constraint2) && (constraint3)));

def objective : Int := 0;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print p0 in
    let report1 := print p1 in
    let report2 := print p2 in
    let report3 := print p3 in
    let report4 := print p4 in
    let report5 := print p5 in
    unit;
