# langford: k=3, positions of two copies (reduced instance)
# GOAL: Find a feasible assignment (score 0).
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/z3/langford.py
# Generated by scripts/generate_hakank_examples.py; all decisions remain holes.
# Infeasible assignments score 1000000; every feasible score is smaller.

def p0 : {v:Int | 0 <= v && v <= 5} := ?h_p0;
def p1 : {v:Int | 0 <= v && v <= 5} := ?h_p1;
def p2 : {v:Int | 0 <= v && v <= 5} := ?h_p2;
def p3 : {v:Int | 0 <= v && v <= 5} := ?h_p3;
def p4 : {v:Int | 0 <= v && v <= 5} := ?h_p4;
def p5 : {v:Int | 0 <= v && v <= 5} := ?h_p5;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := p0 != p1;
def constraint1 : Bool := p0 != p2;
def constraint2 : Bool := p0 != p3;
def constraint3 : Bool := p0 != p4;
def constraint4 : Bool := p0 != p5;
def constraint5 : Bool := p1 != p2;
def constraint6 : Bool := p1 != p3;
def constraint7 : Bool := p1 != p4;
def constraint8 : Bool := p1 != p5;
def constraint9 : Bool := p2 != p3;
def constraint10 : Bool := p2 != p4;
def constraint11 : Bool := p2 != p5;
def constraint12 : Bool := p3 != p4;
def constraint13 : Bool := p3 != p5;
def constraint14 : Bool := p4 != p5;
def constraint15 : Bool := p3 = p0 + 2;
def constraint16 : Bool := p4 = p1 + 3;
def constraint17 : Bool := p5 = p2 + 4;
def valid : Bool := (((((constraint0) && (constraint1)) && ((constraint2) && (constraint3))) && (((constraint4) && (constraint5)) && ((constraint6) && ((constraint7) && (constraint8))))) && ((((constraint9) && (constraint10)) && ((constraint11) && (constraint12))) && (((constraint13) && (constraint14)) && ((constraint15) && ((constraint16) && (constraint17))))));

def objective : Int := 0;
def score : Int := if valid then objective else 1000000;

@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print p0 in
    let report1 := print p1 in
    let report2 := print p2 in
    let report3 := print p3 in
    let report4 := print p4 in
    let report5 := print p5 in
    unit;
