# send_more_money: base 10, eight distinct digits
# GOAL: Find a feasible assignment (score 0).
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/z3/send_more_money.py
# Generated by scripts/generate_hakank_examples.py; all decisions remain holes.
# Infeasible assignments score 1000000; every feasible score is smaller.

def s : {v:Int | 1 <= v && v <= 9} := ?h_s;
def e : {v:Int | 0 <= v && v <= 9} := ?h_e;
def n : {v:Int | 0 <= v && v <= 9} := ?h_n;
def d : {v:Int | 0 <= v && v <= 9} := ?h_d;
def m : {v:Int | 1 <= v && v <= 9} := ?h_m;
def o : {v:Int | 0 <= v && v <= 9} := ?h_o;
def r : {v:Int | 0 <= v && v <= 9} := ?h_r;
def y : {v:Int | 0 <= v && v <= 9} := ?h_y;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := s != e;
def constraint1 : Bool := s != n;
def constraint2 : Bool := s != d;
def constraint3 : Bool := s != m;
def constraint4 : Bool := s != o;
def constraint5 : Bool := s != r;
def constraint6 : Bool := s != y;
def constraint7 : Bool := e != n;
def constraint8 : Bool := e != d;
def constraint9 : Bool := e != m;
def constraint10 : Bool := e != o;
def constraint11 : Bool := e != r;
def constraint12 : Bool := e != y;
def constraint13 : Bool := n != d;
def constraint14 : Bool := n != m;
def constraint15 : Bool := n != o;
def constraint16 : Bool := n != r;
def constraint17 : Bool := n != y;
def constraint18 : Bool := d != m;
def constraint19 : Bool := d != o;
def constraint20 : Bool := d != r;
def constraint21 : Bool := d != y;
def constraint22 : Bool := m != o;
def constraint23 : Bool := m != r;
def constraint24 : Bool := m != y;
def constraint25 : Bool := o != r;
def constraint26 : Bool := o != y;
def constraint27 : Bool := r != y;
def constraint28 : Bool := ((((1000 * s) + (100 * e)) + ((10 * n) + (d))) + (((1000 * m) + (100 * o)) + ((10 * r) + (e)))) = (((10000 * m) + (1000 * o)) + ((100 * n) + ((10 * e) + (y))));
def valid : Bool := (((((constraint0) && ((constraint1) && (constraint2))) && (((constraint3) && (constraint4)) && ((constraint5) && (constraint6)))) && (((constraint7) && ((constraint8) && (constraint9))) && (((constraint10) && (constraint11)) && ((constraint12) && (constraint13))))) && ((((constraint14) && ((constraint15) && (constraint16))) && (((constraint17) && (constraint18)) && ((constraint19) && (constraint20)))) && ((((constraint21) && (constraint22)) && ((constraint23) && (constraint24))) && (((constraint25) && (constraint26)) && ((constraint27) && (constraint28))))));

def objective : Int := 0;
def score : Int := if valid then objective else 1000000;

@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print s in
    let report1 := print e in
    let report2 := print n in
    let report3 := print d in
    let report4 := print m in
    let report5 := print o in
    let report6 := print r in
    let report7 := print y in
