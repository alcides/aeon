import Vec;

def s : {v:Int | 1 <= v && v <= 9} := ?h_s;
def e : {v:Int | 0 <= v && v <= 9} := ?h_e;
def n : {v:Int | 0 <= v && v <= 9} := ?h_n;
def d : {v:Int | 0 <= v && v <= 9} := ?h_d;
def m : {v:Int | 1 <= v && v <= 9} := ?h_m;
def o : {v:Int | 0 <= v && v <= 9} := ?h_o;
def r : {v:Int | 0 <= v && v <= 9} := ?h_r;
def y : {v:Int | 0 <= v && v <= 9} := ?h_y;
def sequence0_tail7 : (Vec Int) := Vec.cons (y) (Vec.nil);
def sequence0_tail6 : (Vec Int) := Vec.cons (r) (sequence0_tail7);
def sequence0_tail5 : (Vec Int) := Vec.cons (o) (sequence0_tail6);
def sequence0_tail4 : (Vec Int) := Vec.cons (m) (sequence0_tail5);
def sequence0_tail3 : (Vec Int) := Vec.cons (d) (sequence0_tail4);
def sequence0_tail2 : (Vec Int) := Vec.cons (n) (sequence0_tail3);
def sequence0_tail1 : (Vec Int) := Vec.cons (e) (sequence0_tail2);
def sequence0_tail0 : (Vec Int) := Vec.cons (s) (sequence0_tail1);

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := Vec.allDifferent (sequence0_tail0);
def constraint1 : Bool := ((((1000 * s) + (100 * e)) + ((10 * n) + (d))) + (((1000 * m) + (100 * o)) + ((10 * r) + (e)))) = (((10000 * m) + (1000 * o)) + ((100 * n) + ((10 * e) + (y))));
def valid : Bool := ((constraint0) && (constraint1));

def objective : Int := 0;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

