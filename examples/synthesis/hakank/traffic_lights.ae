# traffic_lights: CSPLib 016, four vehicle/pedestrian pairs
# GOAL: Find a feasible assignment (score 0).
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/z3/traffic_lights.py
# Generated by scripts/generate_hakank_examples.py; all decisions remain holes.
# Infeasible assignments score 1000000; every feasible score is smaller.

def v0 : {v:Int | 0 <= v && v <= 3} := ?h_v0;
def v1 : {v:Int | 0 <= v && v <= 3} := ?h_v1;
def v2 : {v:Int | 0 <= v && v <= 3} := ?h_v2;
def v3 : {v:Int | 0 <= v && v <= 3} := ?h_v3;
def p0 : {v:Int | 0 <= v && v <= 3} := ?h_p0;
def p1 : {v:Int | 0 <= v && v <= 3} := ?h_p1;
def p2 : {v:Int | 0 <= v && v <= 3} := ?h_p2;
def p3 : {v:Int | 0 <= v && v <= 3} := ?h_p3;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := ((((((v0 = 0) && (p0 = 0)) && ((v1 = 2) && (p1 = 2)))) || ((((v0 = 1) && (p0 = 0)) && ((v1 = 3) && (p1 = 0))))) || (((((v0 = 2) && (p0 = 2)) && ((v1 = 0) && (p1 = 0)))) || ((((v0 = 3) && (p0 = 0)) && ((v1 = 1) && (p1 = 0))))));
def constraint1 : Bool := ((((((v1 = 0) && (p1 = 0)) && ((v2 = 2) && (p2 = 2)))) || ((((v1 = 1) && (p1 = 0)) && ((v2 = 3) && (p2 = 0))))) || (((((v1 = 2) && (p1 = 2)) && ((v2 = 0) && (p2 = 0)))) || ((((v1 = 3) && (p1 = 0)) && ((v2 = 1) && (p2 = 0))))));
def constraint2 : Bool := ((((((v2 = 0) && (p2 = 0)) && ((v3 = 2) && (p3 = 2)))) || ((((v2 = 1) && (p2 = 0)) && ((v3 = 3) && (p3 = 0))))) || (((((v2 = 2) && (p2 = 2)) && ((v3 = 0) && (p3 = 0)))) || ((((v2 = 3) && (p2 = 0)) && ((v3 = 1) && (p3 = 0))))));
def constraint3 : Bool := ((((((v3 = 0) && (p3 = 0)) && ((v0 = 2) && (p0 = 2)))) || ((((v3 = 1) && (p3 = 0)) && ((v0 = 3) && (p0 = 0))))) || (((((v3 = 2) && (p3 = 2)) && ((v0 = 0) && (p0 = 0)))) || ((((v3 = 3) && (p3 = 0)) && ((v0 = 1) && (p0 = 0))))));
def valid : Bool := (((constraint0) && (constraint1)) && ((constraint2) && (constraint3)));

def objective : Int := 0;
def score : Int := if valid then objective else 1000000;

@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print v0 in
    let report1 := print v1 in
    let report2 := print v2 in
    let report3 := print v3 in
    let report4 := print p0 in
    let report5 := print p1 in
    let report6 := print p2 in
    let report7 := print p3 in
    unit;
