# among: exactly three of five values belong to {1,5,8}
# GOAL: Find a feasible assignment (score 0).
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/z3/among.py
# Generated by scripts/generate_hakank_examples.py; all decisions remain holes.
# Infeasible assignments score 1000000; every feasible score is smaller.

def x0 : {v:Int | 1 <= v && v <= 8} := ?h_x0;
def x1 : {v:Int | 1 <= v && v <= 8} := ?h_x1;
def x2 : {v:Int | 1 <= v && v <= 8} := ?h_x2;
def x3 : {v:Int | 1 <= v && v <= 8} := ?h_x3;
def x4 : {v:Int | 1 <= v && v <= 8} := ?h_x4;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := ((((if ((x0 = 1) || ((x0 = 5) || (x0 = 8))) then 1 else 0)) + ((if ((x1 = 1) || ((x1 = 5) || (x1 = 8))) then 1 else 0))) + (((if ((x2 = 1) || ((x2 = 5) || (x2 = 8))) then 1 else 0)) + (((if ((x3 = 1) || ((x3 = 5) || (x3 = 8))) then 1 else 0)) + ((if ((x4 = 1) || ((x4 = 5) || (x4 = 8))) then 1 else 0))))) = 3;
def valid : Bool := (constraint0);

def objective : Int := 0;
def score : Int := if valid then objective else 1000000;

@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print x0 in
    let report1 := print x1 in
    let report2 := print x2 in
    let report3 := print x3 in
    let report4 := print x4 in
    unit;
