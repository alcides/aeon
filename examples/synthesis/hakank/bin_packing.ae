# bin_packing: weights [4,3,1], capacity 4 (small upstream example)
# GOAL: Minimize occupied bins.
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/z3/bin_packing.py
# Generated by scripts/generate_hakank_examples.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def x0 : {v:Int | 0 <= v && v <= 2} := ?h_x0;
def x1 : {v:Int | 0 <= v && v <= 2} := ?h_x1;
def x2 : {v:Int | 0 <= v && v <= 2} := ?h_x2;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := ((4 * (if x0 = 0 then 1 else 0)) + ((3 * (if x1 = 0 then 1 else 0)) + (1 * (if x2 = 0 then 1 else 0)))) <= 4;
def constraint1 : Bool := ((4 * (if x0 = 1 then 1 else 0)) + ((3 * (if x1 = 1 then 1 else 0)) + (1 * (if x2 = 1 then 1 else 0)))) <= 4;
def constraint2 : Bool := ((4 * (if x0 = 2 then 1 else 0)) + ((3 * (if x1 = 2 then 1 else 0)) + (1 * (if x2 = 2 then 1 else 0)))) <= 4;
def valid : Bool := ((constraint0) && ((constraint1) && (constraint2)));

def objective : Int := (((if ((x0 = 0) || ((x1 = 0) || (x2 = 0))) then 1 else 0)) + (((if ((x0 = 1) || ((x1 = 1) || (x2 = 1))) then 1 else 0)) + ((if ((x0 = 2) || ((x1 = 2) || (x2 = 2))) then 1 else 0))));
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print x0 in
    let report1 := print x1 in
    let report2 := print x2 in
