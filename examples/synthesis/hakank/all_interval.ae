# all_interval: series of size 5 (reduced instance)
# GOAL: Find a feasible assignment (score 0).
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/cpmpy/all_interval.py
# Generated by scripts/generate_hakank_examples.py; all decisions remain holes.
# Infeasible assignments score 1000000; every feasible score is smaller.

def x0 : {v:Int | 1 <= v && v <= 5} := ?h_x0;
def x1 : {v:Int | 1 <= v && v <= 5} := ?h_x1;
def x2 : {v:Int | 1 <= v && v <= 5} := ?h_x2;
def x3 : {v:Int | 1 <= v && v <= 5} := ?h_x3;
def x4 : {v:Int | 1 <= v && v <= 5} := ?h_x4;
def d0 : {v:Int | 1 <= v && v <= 4} := ?h_d0;
def d1 : {v:Int | 1 <= v && v <= 4} := ?h_d1;
def d2 : {v:Int | 1 <= v && v <= 4} := ?h_d2;
def d3 : {v:Int | 1 <= v && v <= 4} := ?h_d3;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := x0 != x1;
def constraint1 : Bool := x0 != x2;
def constraint2 : Bool := x0 != x3;
def constraint3 : Bool := x0 != x4;
def constraint4 : Bool := x1 != x2;
def constraint5 : Bool := x1 != x3;
def constraint6 : Bool := x1 != x4;
def constraint7 : Bool := x2 != x3;
def constraint8 : Bool := x2 != x4;
def constraint9 : Bool := x3 != x4;
def constraint10 : Bool := d0 != d1;
def constraint11 : Bool := d0 != d2;
def constraint12 : Bool := d0 != d3;
def constraint13 : Bool := d1 != d2;
def constraint14 : Bool := d1 != d3;
def constraint15 : Bool := d2 != d3;
def constraint16 : Bool := d0 = x1 - x0 || d0 = x0 - x1;
def constraint17 : Bool := d1 = x2 - x1 || d1 = x1 - x2;
def constraint18 : Bool := d2 = x3 - x2 || d2 = x2 - x3;
def constraint19 : Bool := d3 = x4 - x3 || d3 = x3 - x4;
def constraint20 : Bool := x0 < x4;
def constraint21 : Bool := d0 < d1;
def valid : Bool := (((((constraint0) && (constraint1)) && ((constraint2) && ((constraint3) && (constraint4)))) && (((constraint5) && ((constraint6) && (constraint7))) && ((constraint8) && ((constraint9) && (constraint10))))) && ((((constraint11) && (constraint12)) && ((constraint13) && ((constraint14) && (constraint15)))) && (((constraint16) && ((constraint17) && (constraint18))) && ((constraint19) && ((constraint20) && (constraint21))))));

def objective : Int := 0;
def score : Int := if valid then objective else 1000000;

@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print x0 in
    let report1 := print x1 in
    let report2 := print x2 in
    let report3 := print x3 in
    let report4 := print x4 in
    let report5 := print d0 in
    let report6 := print d1 in
    let report7 := print d2 in
    let report8 := print d3 in
    unit;
