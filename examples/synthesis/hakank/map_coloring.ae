# map_coloring: Belgium/Denmark/France/Germany/Netherlands/Luxembourg, four colors
# GOAL: Find a feasible assignment (score 0).
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/cpmpy/map_coloring.py
# Generated by scripts/generate_hakank_examples.py; all decisions remain holes.
# Infeasible assignments score 1000000; every feasible score is smaller.

def x0 : {v:Int | 1 <= v && v <= 4} := ?h_x0;
def x1 : {v:Int | 1 <= v && v <= 4} := ?h_x1;
def x2 : {v:Int | 1 <= v && v <= 4} := ?h_x2;
def x3 : {v:Int | 1 <= v && v <= 4} := ?h_x3;
def x4 : {v:Int | 1 <= v && v <= 4} := ?h_x4;
def x5 : {v:Int | 1 <= v && v <= 4} := ?h_x5;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := x0 = 1;
def constraint1 : Bool := x2 != x0;
def constraint2 : Bool := x2 != x5;
def constraint3 : Bool := x2 != x3;
def constraint4 : Bool := x5 != x3;
def constraint5 : Bool := x5 != x0;
def constraint6 : Bool := x0 != x4;
def constraint7 : Bool := x0 != x3;
def constraint8 : Bool := x3 != x4;
def constraint9 : Bool := x3 != x1;
def valid : Bool := ((((constraint0) && (constraint1)) && ((constraint2) && ((constraint3) && (constraint4)))) && (((constraint5) && (constraint6)) && ((constraint7) && ((constraint8) && (constraint9)))));

def objective : Int := 0;
def score : Int := if valid then objective else 1000000;

@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print x0 in
    let report1 := print x1 in
    let report2 := print x2 in
    let report3 := print x3 in
    let report4 := print x4 in
    let report5 := print x5 in
    unit;
