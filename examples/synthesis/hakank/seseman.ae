# seseman: 3x3 border, each side sums to 9 (upstream default)
# GOAL: Find a feasible assignment (score 0).
# Source: https://github.com/hakank/hakank/blob/2823c48d3d2e5d86acb3b8e6951172499c8946b0/z3/seseman.py
# Generated by scripts/generate_hakank_examples.py; all decisions remain holes.
# @require is a hard constraint, independent of the objective.

import Vec;

def x0 : {v:Int | 1 <= v && v <= 9} := ?h_x0;
def x1 : {v:Int | 1 <= v && v <= 9} := ?h_x1;
def x2 : {v:Int | 1 <= v && v <= 9} := ?h_x2;
def x3 : {v:Int | 1 <= v && v <= 9} := ?h_x3;
def x4 : {v:Int | 1 <= v && v <= 9} := ?h_x4;
def x5 : {v:Int | 1 <= v && v <= 9} := ?h_x5;
def x6 : {v:Int | 1 <= v && v <= 9} := ?h_x6;
def x7 : {v:Int | 1 <= v && v <= 9} := ?h_x7;

# Complete finite-instance constraints; Bool annotations keep verification local.
def constraint0 : Bool := ((x0) + ((x1) + (x2))) = 9;
def constraint1 : Bool := ((x0) + ((x3) + (x5))) = 9;
def constraint2 : Bool := ((x2) + ((x4) + (x7))) = 9;
def constraint3 : Bool := ((x5) + ((x6) + (x7))) = 9;
def valid : Bool := (((constraint0) && (constraint1)) && ((constraint2) && (constraint3)));

def objective : Int := 0;
def score : Int := objective;

@require(valid)
@minimize_int(score)
def benchmark : Int := score;

def main (_:Int) : Unit :=
    let report := print score in
    let report0 := print x0 in
    let report1 := print x1 in
    let report2 := print x2 in
    let report3 := print x3 in
    let report4 := print x4 in
    let report5 := print x5 in
    let report6 := print x6 in
    let report7 := print x7 in
    unit;
