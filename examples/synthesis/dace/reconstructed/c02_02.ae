# Reconstructed DACE benchmark 2.2
# Category: copy previous or next value
# The original Stack Overflow input was not published with the paper. This
# runnable fixture reconstructs the category/operator shape from Fig. 19.
# It is not a claim about the original spreadsheet.
# Run: python -m aeon --no-main -s fta --budget 30 examples/synthesis/dace/reconstructed/c02_02.ae

import Dace (Column, prev_nonmissing)

def values : Column := native "[-999999, 3, 5, -999999, 9, 12, -999999]";

@example(fill 3 = 5)
@example(fill 6 = 12)
def fill (i: Int) : Int := ?hole;

# Intended reconstruction shape: prev_nonmissing(values, i)
