# Reconstructed DACE benchmark 6.1
# Category: average non-missing values
# The original Stack Overflow input was not published with the paper. This
# runnable fixture reconstructs the category/operator shape from Fig. 19.
# It is not a claim about the original spreadsheet.
# Run: python -m aeon --no-main -s fta --budget 30 examples/synthesis/dace/reconstructed/c06_01.ae

import Dace (Column, mean_nonmissing)

def values : Column := native "[-999999, 3, 5, -999999, 9, 12, -999999]";

@example(fill 0 = 7)
@example(fill 3 = 7)
@example(fill 6 = 7)
def fill (i: Int) : Int := ?hole;

# Intended reconstruction shape: mean_nonmissing(values)
