# Reconstructed DACE benchmark 11.1
# Category: count non-missing values
# The original Stack Overflow input was not published with the paper. This
# runnable fixture reconstructs the category/operator shape from Fig. 19.
# It is not a claim about the original spreadsheet.
# Run: python -m aeon --no-main -s fta --budget 30 examples/synthesis/dace/reconstructed/c11_01.ae

import Dace (Column, count_nonmissing_before)

def values : Column := native "[-999999, 3, 5, -999999, 9, 12, -999999]";

@example(fill 1 = 0)
@example(fill 3 = 2)
@example(fill 6 = 5)
def fill (i: Int) : Int := ?hole;

# Intended reconstruction shape: count_nonmissing_before(values, i)
