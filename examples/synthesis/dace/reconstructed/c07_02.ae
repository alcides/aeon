# Run: python -m aeon --no-main -s fta --budget 30 examples/synthesis/dace/reconstructed/c07_02.ae

import Dace (Column, max_nonmissing)

def values : Column := native "[-999999, 3, 5, -999999, 9, 12, -999999]";

@example(fill 0 = 12)
@example(fill 3 = 12)
@example(fill 6 = 12)
def fill (i: Int) : Int := ?hole;

# Intended reconstruction shape: max_nonmissing(values)
