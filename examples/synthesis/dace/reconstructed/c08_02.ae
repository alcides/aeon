# Reconstructed DACE benchmark 8.2
# Category: linear interpolation
# The original Stack Overflow input was not published with the paper. This
# runnable fixture reconstructs the category/operator shape from Fig. 19.
# It is not a claim about the original spreadsheet.
# Run: python -m aeon --no-main -s fta --budget 30 examples/synthesis/dace/reconstructed/c08_02.ae

import Dace (Column, interpolate)

def values : Column := native "[-999999, 3, 5, -999999, 9, 12, -999999]";

@example(fill 0 = 3)
@example(fill 3 = 7)
@example(fill 6 = 12)
def fill (i: Int) : Int := ?hole;

# Intended reconstruction shape: interpolate(values, i)
