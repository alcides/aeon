# Reconstructed DACE benchmark 19.1
# Category: linear extrapolation
# The original Stack Overflow input was not published with the paper. This
# runnable fixture reconstructs the category/operator shape from Fig. 19.
# It is not a claim about the original spreadsheet.
# Run: python -m aeon --no-main -s fta --budget 30 examples/synthesis/dace/reconstructed/c19_01.ae

import Dace (Column, extrapolate)

def values : Column := native "[-999999, 3, 5, -999999, 9, 12, -999999]";

@example(fill 0 = 1)
@example(fill 3 = 6)
@example(fill 6 = 15)
def fill (i: Int) : Int := ?hole;

# Intended reconstruction shape: extrapolate(values, i)
