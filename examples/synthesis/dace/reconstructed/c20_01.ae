# Reconstructed DACE benchmark 20.1
# Category: equation over previous and next values
# The original Stack Overflow input was not published with the paper. This
# runnable fixture reconstructs the category/operator shape from Fig. 19.
# It is not a claim about the original spreadsheet.
# Run: python -m aeon --no-main -s fta --budget 30 examples/synthesis/dace/reconstructed/c20_01.ae

import Dace (Column, prev_nonmissing, next_nonmissing)

def values : Column := native "[-999999, 3, 5, -999999, 9, 12, -999999]";

@example(fill 3 = 9)
@example(fill 6 = 12)
def fill (i: Int) : Int := ?hole;

# Intended reconstruction shape: prev_nonmissing(values, i) + (next_nonmissing(values, i) - prev_nonmissing(values, i))
