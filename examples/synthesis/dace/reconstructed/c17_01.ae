# Reconstructed DACE benchmark 17.1
# Category: maximum of previous five cells
# The original Stack Overflow input was not published with the paper. This
# runnable fixture reconstructs the category/operator shape from Fig. 19.
# It is not a claim about the original spreadsheet.
# Run: python -m aeon --no-main -s fta --budget 30 examples/synthesis/dace/reconstructed/c17_01.ae

import Dace (Column, max_previous)

def values : Column := native "[-999999, 3, 5, -999999, 9, 12, -999999]";

@example(fill 3 = 5)
@example(fill 6 = 12)
def fill (i: Int) : Int := ?hole;

# Intended reconstruction shape: max_previous(values, i)
