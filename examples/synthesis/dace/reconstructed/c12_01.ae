# Reconstructed DACE benchmark 12.1
# Category: sum two cells
# The original Stack Overflow input was not published with the paper. This
# runnable fixture reconstructs the category/operator shape from Fig. 19.
# It is not a claim about the original spreadsheet.
# Run: python -m aeon --no-main -s fta --budget 30 examples/synthesis/dace/reconstructed/c12_01.ae

import Dace (Column, col_at)

def values : Column := native "[-999999, 3, 5, -999999, 9, 12, -999999]";
def other : Column := native "[1, 2, 3, 4, 5, 6, 7]";
@example(fill 1 = 5)
@example(fill 2 = 8)
@example(fill 4 = 14)
def fill (i: Int) : Int := ?hole;

# Intended reconstruction shape: col_at(values, i) + col_at(other, i)
