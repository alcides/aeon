# Reconstructed DACE benchmark 4.1
# Category: conditional copy
# The original Stack Overflow input was not published with the paper. This
# runnable fixture reconstructs the category/operator shape from Fig. 19.
# It is not a claim about the original spreadsheet.
# Run: python -m aeon --no-main -s fta --budget 30 examples/synthesis/dace/reconstructed/c04_01.ae

import Dace (Column, prev_nonmissing, next_nonmissing, has_prev_nonmissing)

def values : Column := native "[-999999, 3, 5, -999999, 9, 12, -999999]";

@example(fill 3 = 5)
@example(fill 6 = 12)
def fill (i: Int) : Int := ?hole;

# Intended reconstruction shape: if has_prev_nonmissing(values, i) then prev_nonmissing(values, i) else next_nonmissing(values, i)
