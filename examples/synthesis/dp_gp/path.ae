# Longest bounded walk in a directed two-vertex graph. Unlike knapsack, moves
# change graph vertex and can return to it; remaining fuel makes the tree finite.
import DP;
def allowed(x:Int)(y:Int)(z:Int)(a:Int):Bool := true;
def next_x(x:Int)(y:Int)(z:Int)(a:Int):Int := x - 1;
def next_y(x:Int)(y:Int)(z:Int)(a:Int):Int := if a = 0 then y else 1 - y;
def next_z(x:Int)(y:Int)(z:Int)(a:Int):Int := z * 2 + a;
def reward(x:Int)(y:Int)(z:Int)(a:Int):Int := if a = 0 then 1 else if y = 0 then 4 else 2;
def distance(x:Int)(y:Int)(z:Int)(a:Int):Int := 1;
def switches(x:Int)(y:Int)(z:Int)(a:Int):Int := a;
def objective(v:Int)(d:Int)(k:Int):Int := v;
def reference(n:Int)(vertex:Int):Int :=
  DP.reference n n vertex 0 allowed next_x next_y next_z reward distance switches objective 0 0 0 0;
@dp_gp(reference, 4, 1)
def optimized(n:{v:Int | v >= 0 && v <= 4})(vertex:{v:Int | v >= 0 && v <= 1}):Int := ?algorithm;
