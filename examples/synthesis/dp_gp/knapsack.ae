# Finite 0/1 knapsack: items indexed by x, remaining capacity y, redundant
# history z. Zero-weight items and duplicate items are intentional.
import DP;
def weight(x:Int):Int := if x <= 1 then 0 else if x <= 3 then 2 else 3;
def value(x:Int):Int := if x <= 1 then 1 else if x <= 3 then 3 else 4;
def allowed(x:Int)(y:Int)(z:Int)(a:Int):Bool := a = 0 || weight x <= y;
def next_x(x:Int)(y:Int)(z:Int)(a:Int):Int := x - 1;
def next_y(x:Int)(y:Int)(z:Int)(a:Int):Int := if a = 0 then y else y - weight x;
def next_z(x:Int)(y:Int)(z:Int)(a:Int):Int := z * 2 + a;
def gain(x:Int)(y:Int)(z:Int)(a:Int):Int := if a = 0 then 0 else value x;
def used(x:Int)(y:Int)(z:Int)(a:Int):Int := if a = 0 then 0 else weight x;
def count(x:Int)(y:Int)(z:Int)(a:Int):Int := a;
def objective(v:Int)(w:Int)(k:Int):Int := v;
def reference(n:Int)(capacity:Int):Int :=
  DP.reference n n capacity 0 allowed next_x next_y next_z gain used count objective 0 0 0 0;
@dp_gp(reference, 4, 5)
def optimized(n:{v:Int | v >= 0 && v <= 4})(capacity:{v:Int | v >= 0 && v <= 5}):Int := ?algorithm;
