import Karel;
open Karel

def initial : World := with_markers (world 4 3 1 1 east) 1 1 3
def expected : World := world 4 3 1 1 east
def initial2 : World := with_markers (world 4 3 2 1 north) 2 1 7
def expected2 : World := world 4 3 2 1 north
def cases : Examples := append_examples (example initial expected) (example initial2 expected2)

@minimize(fitness solve cases)
def solve (w: World) : World :=
    let initial := unit in let expected := unit in
    let initial2 := unit in let expected2 := unit in let cases := unit in ?hole
