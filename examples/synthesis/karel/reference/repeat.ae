import Karel;
open Karel

def initial : World := world 5 3 0 1 east
def expected : World := world 5 3 3 1 east
def initial2 : World := world 3 5 1 4 north
def expected2 : World := world 3 5 1 1 north
def cases : Examples := append_examples (example initial expected) (example initial2 expected2)

def solution (w: World) : World := repeat 3 move w
def main (_: Int) : Unit := print (fitness solution cases)
