import Karel;
open Karel

def initial : World := world 4 3 1 1 east
def expected : World := with_markers (world 4 3 1 1 east) 1 1 1
def initial2 : World := with_markers (world 4 3 2 1 north) 2 1 2
def expected2 : World := with_markers (world 4 3 2 1 north) 2 1 3
def cases : Examples := append_examples (example initial expected) (example initial2 expected2)

def solution (w: World) : World := put_marker w
def main (_: Int) : Unit := print (fitness solution cases)
