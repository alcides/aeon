import Karel;
open Karel

def initial : World := with_wall (world 4 3 1 1 east) 1 0
def expected : World := with_wall (world 4 3 1 1 east) 1 0
def initial2 : World := world 4 3 1 1 east
def expected2 : World := world 4 3 1 1 north
def cases : Examples := append_examples (example initial expected) (example initial2 expected2)

def solution (w: World) : World := when_karel left_is_clear turn_left w
def main (_: Int) : Unit := print (fitness solution cases)
