# Neuroevolution of MLP topologies on (downsampled) MNIST — multi-objective.
#
# Aeon's synthesizer evolves an ``Arch`` (hidden widths + activations). Each
# candidate is scored by the NumPy oracle in ``mnist_fitness.py`` on the fixed
# subset ``mnist_subset.npz``, returning two minimised objectives:
#
#     [classification_error, n_hidden_units]
#
# so the Pareto archive can trade accuracy against model size. Training uses
# NumPy (not PyTorch) so each synthesis-worker evaluation stays under Aeon's
# ~1s timeout. The Aeon ``NN`` library itself remains PyTorch-backed.
#
# Run from the repository root:
#
#   uv pip install -e ".[nn]"
#   # CPU wheel if disk/CUDA downloads are an issue:
#   # uv pip install torch --index-url https://download.pytorch.org/whl/cpu
#   uv run python -m aeon --budget 60 -s random_search \
#       examples/synthesis/neuroevolution/mnist.ae
#
# A hand-written baseline (``arch_baseline``) is included for comparison.

# Qualified so Array_* helpers stay out of the unqualified synthesis grammar;
# ``Array_size`` is still available for the ``@multi_minimize_float`` ascription.
import Array

# Hidden-layer grammar. Each constructor encodes (activation, width).
# ``arch_out`` ends the stack; the binder always appends a linear head of
# width 10 (MNIST digits).
inductive Arch
| arch_out : Arch
| arch_relu16 (rest: Arch) : Arch
| arch_relu32 (rest: Arch) : Arch
| arch_relu64 (rest: Arch) : Arch
| arch_tanh16 (rest: Arch) : Arch
| arch_tanh32 (rest: Arch) : Arch
| arch_sigmoid16 (rest: Arch) : Arch
| arch_sigmoid32 (rest: Arch) : Arch

# Test accuracy after the short training run (for inspecting solutions).
def mnist_accuracy (a: Arch) : Float :=
    native "(__import__('sys').path.insert(0, 'examples/synthesis/neuroevolution'), __import__('mnist_fitness').test_accuracy(a))[1]";

# (a) Synthesis: evolve the architecture under two minimised objectives
# ``[error, n_hidden_units]``. The ``native`` call returns a Python list;
# ``@multi_minimize_float`` ascribes it as a length-2 ``Array`` and unpacks
# it into the Pareto vector. Helpers, the Arch recursor, and field projectors
# are shadowed by ``unit`` inside the hole so only Arch constructors are
# offered as building blocks.
@multi_minimize_float(
    native "(__import__('sys').path.insert(0, 'examples/synthesis/neuroevolution'), __import__('mnist_fitness').objectives(evolved_arch))[1]",
    2
)
def evolved_arch : Arch :=
    (let mnist_accuracy := unit in
     let arch_baseline := unit in
     let Arch_rec := unit in
     let Arch_arch_relu16_rest := unit in
     let Arch_arch_relu32_rest := unit in
     let Arch_arch_relu64_rest := unit in
     let Arch_arch_tanh16_rest := unit in
     let Arch_arch_tanh32_rest := unit in
     let Arch_arch_sigmoid16_rest := unit in
     let Arch_arch_sigmoid32_rest := unit in
     let Array_get := unit in
     let Array_got_value := unit in
     let Array_head := unit in
     let Array_reduce := unit in
     ?hole);

# (b) A reasonable hand-written baseline: 196 -> 32 (relu) -> 10 (linear).
def arch_baseline : Arch := .arch_relu32 .arch_out;
