# python -m aeon -s structure_guided --budget 10 examples/synthesis/structure_guided/paired_map.ae
# Infer both the two-elements-per-step structure and the element computations.
inductive Chain
| nil : Chain
| cons (head:Int) (tail:Chain) : Chain

@example(f Chain.nil = Chain.nil)
@example(f (Chain.cons 2 Chain.nil) = Chain.cons 2 (Chain.cons 3 Chain.nil))
@example(f (Chain.cons 1 (Chain.cons 4 Chain.nil)) = Chain.cons 1 (Chain.cons 2 (Chain.cons 4 (Chain.cons 5 Chain.nil))))
@allow_recursion
def f(xs:Chain):Chain := ?paired;

def main(args:Int):Chain := f (Chain.cons 8 (Chain.cons 3 Chain.nil));
