# 50 fixed random (value, weight) pairs (seed 20261108), capacity 100.
# Each node appends one fixed pair and its synthesized Boolean decision.
# Run: python -m aeon -s ortools --budget 30 examples/synthesis/puzzle/knapsack_50.ae

inductive Knapsack forall <fits:Int -> Int -> Bool>
| empty : {k:Knapsack{|fits|} | Knapsack.size k = 0 && Knapsack.weight k = 0}
| add (previous:Knapsack{|fits|}) (value:Int) (weight:{w:Int | w > 0})
      (used:{b:Bool | fits (if b then weight else 0) (Knapsack.weight previous)}) :
    {k:Knapsack{|fits|} | Knapsack.size k = Knapsack.size previous + 1 &&
        Knapsack.weight k = Knapsack.weight previous + (if used then weight else 0)}
+ size (k:Knapsack) : Int
+ weight (k:Knapsack) : Int

def total_value (k:Knapsack{|fun w => fun previous => w + previous <= 100|}):Int :=
    match k with
    | empty => 0
    | add previous value weight used => total_value previous + (if used then value else 0)

@maximize(toFloat (total_value knapsack))
def knapsack: {k:Knapsack{|fun w => fun previous => w + previous <= 100|} |
    Knapsack.size k = 50 && Knapsack.weight k <= 100} :=
    let add := Knapsack.add{|fun w => fun previous => w + previous <= 100|} in
    let k := Knapsack.empty{|fun w => fun previous => w + previous <= 100|} in
    let k := add k 42 15 ?b0 in
    let k := add k 29 10 ?b1 in
    let k := add k 50 18 ?b2 in
    let k := add k 2 18 ?b3 in
    let k := add k 98 14 ?b4 in
    let k := add k 11 14 ?b5 in
    let k := add k 90 4 ?b6 in
    let k := add k 1 12 ?b7 in
    let k := add k 39 13 ?b8 in
    let k := add k 60 3 ?b9 in
    let k := add k 34 12 ?b10 in
    let k := add k 89 14 ?b11 in
    let k := add k 1 14 ?b12 in
    let k := add k 73 11 ?b13 in
    let k := add k 26 14 ?b14 in
    let k := add k 51 16 ?b15 in
    let k := add k 84 6 ?b16 in
    let k := add k 2 13 ?b17 in
    let k := add k 89 16 ?b18 in
    let k := add k 88 4 ?b19 in
    let k := add k 58 15 ?b20 in
    let k := add k 92 16 ?b21 in
    let k := add k 10 18 ?b22 in
    let k := add k 50 17 ?b23 in
    let k := add k 11 3 ?b24 in
    let k := add k 82 12 ?b25 in
    let k := add k 7 9 ?b26 in
    let k := add k 64 5 ?b27 in
    let k := add k 2 9 ?b28 in
    let k := add k 67 13 ?b29 in
    let k := add k 14 9 ?b30 in
    let k := add k 52 7 ?b31 in
    let k := add k 6 1 ?b32 in
    let k := add k 66 18 ?b33 in
    let k := add k 48 4 ?b34 in
    let k := add k 20 10 ?b35 in
    let k := add k 64 11 ?b36 in
    let k := add k 17 17 ?b37 in
    let k := add k 60 12 ?b38 in
    let k := add k 15 15 ?b39 in
    let k := add k 49 1 ?b40 in
    let k := add k 75 8 ?b41 in
    let k := add k 70 7 ?b42 in
    let k := add k 32 16 ?b43 in
    let k := add k 41 15 ?b44 in
    let k := add k 47 3 ?b45 in
    let k := add k 75 7 ?b46 in
    let k := add k 12 9 ?b47 in
    let k := add k 60 11 ?b48 in
    let k := add k 92 15 ?b49 in
    k;

def main (u:Int):Knapsack{|fun w => fun previous => w + previous <= 100|} := knapsack;
