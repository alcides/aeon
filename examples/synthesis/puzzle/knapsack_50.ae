# Choose from 50 items, in the same order as the value and weight arrays.
# Return 50 Boolean decisions; maximize value while keeping weight at most 100.
# Length is refined in the type; @require enforces capacity before scoring.
# Each call constructs a fresh array because Array is linear.
# python -m aeon -s tdsyn_enumerative --budget 30 examples/synthesis/puzzle/knapsack_50.ae
import Array;
import examples.synthesis.puzzle.knapsack_data as Data;

def selected_value (used:Bool) (value:Int):Int :=
    if used then value else 0;

def knapsack (_:Unit): {a:(Array Bool) | Array.size a = 50} := ?solution;

def total_weight (_:Unit):Int :=
    (Array.consume Array.sum) (Array.zipWith selected_value (knapsack unit) (Data.weights unit));

def total_value (_:Unit):Int :=
    (Array.consume Array.sum) (Array.zipWith selected_value (knapsack unit) (Data.values unit));

@require(total_weight unit <= 100)
@maximize_int(total_value unit)
def benchmark : Int := total_value unit;

def main (_:Int): {a:(Array Bool) | Array.size a = 50} := knapsack unit;
