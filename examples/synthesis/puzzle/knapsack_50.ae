# 50 Boolean decisions, in the same order as the data arrays; capacity 100.
# The result contains only booleans and links. Weight and count are logical measures.
# Run from the repository root:
# python -m aeon -s ortools --budget 30 examples/synthesis/puzzle/knapsack_50.ae
import Array;
import examples.synthesis.puzzle.knapsack_data as Data;

# A tail with n decisions covers the final n items, so its new head is item 49 - n.
inductive Mask forall <fits:Int -> Int -> Bool>
| empty : {m:Mask{|fits|} | Mask.count m = 0 && Mask.weight m = 0}
| cons (rest:{m:Mask{|fits|} | 0 <= Mask.count m && Mask.count m < 50})
       (used:{b:Bool | fits (if b then Array.get (Data.weights unit) (49 - Mask.count rest) else 0) (Mask.weight rest)}) :
    {m:Mask{|fits|} | Mask.count m = Mask.count rest + 1 &&
        Mask.weight m = Mask.weight rest + (if used then Array.get (Data.weights unit) (49 - Mask.count rest) else 0)}
+ count (m:Mask) : Int
+ weight (m:Mask) : Int

def total_value (mask:Mask{|fun w => fun rest => w + rest <= 100|})
                (i:{n:Int | 0 <= n && n + Mask.count mask <= 50}):Int :=
    match mask with
    | empty => 0
    | cons rest used =>
        (if used then Array.get (Data.values unit) i else 0) + total_value rest (i + 1)

@maximize(toFloat (total_value knapsack 0))
def knapsack: {m:Mask{|fun w => fun rest => w + rest <= 100|} |
    Mask.count m = 50 && Mask.weight m <= 100} :=
    ?solution;

def main (u:Int):Mask{|fun w => fun rest => w + rest <= 100|} := knapsack;
