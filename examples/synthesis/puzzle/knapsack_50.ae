# 50 Boolean decisions, in the same order as the data arrays; capacity 100.
# The result contains only booleans and links. Weight and count are logical measures.
# Run from the repository root:
# python -m aeon -s ortools --budget 30 examples/synthesis/puzzle/knapsack_50.ae
import Array;
import examples.synthesis.puzzle.knapsack_data as Data;

# A tail with n decisions covers the final n items, so its new head is item 49 - n.
inductive Mask forall <fits:Int -> Int -> Bool>
| empty : {m:Mask{|fits|} | Mask.count m = 0 && Mask.weight m = 0}
| cons (rest:{m:Mask{|fits|} | 0 <= Mask.count m && Mask.count m < 50})
       (used:{b:Bool | fits (if b then Array.get (Data.weights unit) (49 - Mask.count rest) else 0) (Mask.weight rest)}) :
    {m:Mask{|fits|} | Mask.count m = Mask.count rest + 1 &&
        Mask.weight m = Mask.weight rest + (if used then Array.get (Data.weights unit) (49 - Mask.count rest) else 0)}
+ count (m:Mask) : Int
+ weight (m:Mask) : Int

def total_value (mask:Mask{|fun w => fun rest => w + rest <= 100|})
                (i:{n:Int | 0 <= n && n + Mask.count mask <= 50}):Int :=
    match mask with
    | empty => 0
    | cons rest used =>
        (if used then Array.get (Data.values unit) i else 0) + total_value rest (i + 1)

@maximize(toFloat (total_value knapsack 0))
def knapsack: {m:Mask{|fun w => fun rest => w + rest <= 100|} |
    Mask.count m = 50 && Mask.weight m <= 100} :=
    let cons := Mask.cons{|fun w => fun rest => w + rest <= 100|} in
    let mask := Mask.empty{|fun w => fun rest => w + rest <= 100|} in
    # Prepend decisions from the last item to the first.
    let mask := cons mask ?b49 in
    let mask := cons mask ?b48 in
    let mask := cons mask ?b47 in
    let mask := cons mask ?b46 in
    let mask := cons mask ?b45 in
    let mask := cons mask ?b44 in
    let mask := cons mask ?b43 in
    let mask := cons mask ?b42 in
    let mask := cons mask ?b41 in
    let mask := cons mask ?b40 in
    let mask := cons mask ?b39 in
    let mask := cons mask ?b38 in
    let mask := cons mask ?b37 in
    let mask := cons mask ?b36 in
    let mask := cons mask ?b35 in
    let mask := cons mask ?b34 in
    let mask := cons mask ?b33 in
    let mask := cons mask ?b32 in
    let mask := cons mask ?b31 in
    let mask := cons mask ?b30 in
    let mask := cons mask ?b29 in
    let mask := cons mask ?b28 in
    let mask := cons mask ?b27 in
    let mask := cons mask ?b26 in
    let mask := cons mask ?b25 in
    let mask := cons mask ?b24 in
    let mask := cons mask ?b23 in
    let mask := cons mask ?b22 in
    let mask := cons mask ?b21 in
    let mask := cons mask ?b20 in
    let mask := cons mask ?b19 in
    let mask := cons mask ?b18 in
    let mask := cons mask ?b17 in
    let mask := cons mask ?b16 in
    let mask := cons mask ?b15 in
    let mask := cons mask ?b14 in
    let mask := cons mask ?b13 in
    let mask := cons mask ?b12 in
    let mask := cons mask ?b11 in
    let mask := cons mask ?b10 in
    let mask := cons mask ?b9 in
    let mask := cons mask ?b8 in
    let mask := cons mask ?b7 in
    let mask := cons mask ?b6 in
    let mask := cons mask ?b5 in
    let mask := cons mask ?b4 in
    let mask := cons mask ?b3 in
    let mask := cons mask ?b2 in
    let mask := cons mask ?b1 in
    let mask := cons mask ?b0 in
    mask;

def main (u:Int):Mask{|fun w => fun rest => w + rest <= 100|} := knapsack;
