# Sortedness is not a termination proof: recur on the original list, not tl.
open IncList;
def insert (lo:Int) (y:{v:Int | lo <= v})
    (xs:{zs:IncList | IncList.size zs >= 0 && (IncList.size zs = 0 || lo <= IncList.first zs)})
    : {zs:IncList | IncList.size zs = IncList.size xs + 1 && IncList.size zs > 0 && lo <= IncList.first zs}
    decreasing_by [IncList.size xs] :=
    match xs with
    | nil => cons y nil
    | cons hd tl => if y <= hd then cons y xs else insert lo y xs;
def main (_:Int) : Int := 0;
