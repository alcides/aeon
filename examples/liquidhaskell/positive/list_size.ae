# Tutorial_07_Measure_Int.size: compute and prove the structural length.
open LList;
def length (xs:LList) : {n:Int | n = LList.size xs && n >= 0}
    decreasing_by [LList.size xs] :=
    match xs with
    | nil => 0
    | cons hd tl => 1 + length tl;
def main (_:Int) : Int := length (cons 10 (cons 20 nil));
