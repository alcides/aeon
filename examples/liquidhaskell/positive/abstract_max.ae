# LiquidHaskell's "Abstracting Over Refinements", maxInt/intenser.
def maxInt : forall <p : Int -> Bool>, (x:Int<p>) -> (y:Int<p>) -> Int<p> :=
    Λ <p : Int -> Bool> => fun x => fun y => if x <= y then y else x;
def rgb (x:{v:Int | 0 <= v && v < 256}) (y:{v:Int | 0 <= v && v < 256})
    : {v:Int | 0 <= v && v < 256} := maxInt{|fun v => 0 <= v && v < 256|} x y;
def negative (x:{v:Int | v < 0}) (y:{v:Int | v < 0})
    : {v:Int | v < 0} := maxInt{|fun v => v < 0|} x y;
def main (_:Int) : Int := rgb 100 200 + negative (-9) (-3);
