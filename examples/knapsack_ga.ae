# Functional 0-1 knapsack genetic algorithm in pure Aeon.
# Five items: weights [2, 3, 4, 5, 9], values [3, 4, 5, 8, 10].
# Capacity is fixed at 10 in Individual's type. Fitness is just total value:
# creation and variation must preserve feasibility before an individual can
# enter a population. All values are immutable; hot helpers use @llvm.

open List
open Pair

# The relation connects a selected item's weight to the tail's total weight.
# Constructor refinements define the weight measure; the rest argument must
# satisfy the relation, so a caller cannot manufacture an overweight genome.
# Conditional selection keeps the measure in linear integer arithmetic.
inductive Genome forall <fits: Int -> Int -> Bool>
| empty_genome : {g: Genome{|fits|} | Genome.size g = 0 && Genome.weight g = 0}
| gene (bit: Int | 0 <= bit && bit <= 1)
       (item_weight: Int | item_weight >= 0)
       (value: Int | value >= 0)
       (rest: {g: Genome{|fits|} | fits ((if bit = 0 then 0 else item_weight)) (Genome.weight g)}) :
    {g: Genome{|fits|} | Genome.size g = Genome.size rest + 1 &&
        Genome.weight g = (if bit = 0 then 0 else item_weight) + Genome.weight rest}
+ size (g: Genome) : Int
+ weight (g: Genome) : Int

# This wrapper fixes the relation once for every individual in the GA.
inductive Individual
| individual (genes: Genome{|fun selected => fun tail => selected + tail <= 10|}) :
    {i: Individual | Individual.weight i = Genome.weight genes}
+ weight (i: Individual) : Int

inductive Population
| empty_pop : {p: Population | plen p = 0}
| member (ind: Individual) (rest: Population) :
    {p: Population | plen p = plen rest + 1}
+ plen (p: Population) : Int

# Keep an item's weight and value together, including when it is deselected.
inductive Items
| no_items : {xs: Items | Items.size xs = 0}
| item (weight: Int | weight >= 0) (value: Int | value >= 0)
       (rest: {xs: Items | Items.size xs >= 0}) :
    {xs: Items | Items.size xs = Items.size rest + 1}
+ size (xs: Items) : Int

def POP_SIZE : {p: Int | p > 0} := 10
def GENERATIONS : {g: Int | g >= 0} := 20
def SEED : Int := 20260913


# ---------------------------------------------------------------------------
# Auxiliary: pure LCG RNG and helpers (threaded state, no mutation)
# ---------------------------------------------------------------------------

# Remainder coerced into ``[0, modulus)``. The exact range is not a liquid
# postcondition: ``%`` with a non-constant divisor leaves the decidable
# fragment (see ``--strict-decidable``).
@llvm
def mod_nonneg (value: Int) (modulus: {m: Int | m > 0}) : Int :=
    let rem : Int := value % modulus in
    if rem < 0 then rem + modulus else rem

@llvm
def lcg_next (state: Int) : Int :=
    mod_nonneg ((state * 1664525) + 1013904223) 2147483647

# Draw ``value`` in ``[0, bound)``; return ``(Pair new_state value)``.
@llvm
def rnd (state: Int) (bound: {b: Int | b > 0}) : (Pair Int Int) :=
    let s2 : Int := lcg_next state in
    .mk s2 (mod_nonneg s2 bound)

@llvm
def maximum_list (xs: (List Int)) : Int :=
    match xs with
    | nil => 0
    | cons hd tl =>
        let m : Int := maximum_list tl in
        if hd > m then hd else m

@llvm
def nth_list (xs: (List Int)) (i: Int) : Int :=
    match xs with
    | nil => 0
    | cons hd tl =>
        if i <= 0 then hd else nth_list tl (i - 1)


# ---------------------------------------------------------------------------
# Individuals: create and evaluate
# ---------------------------------------------------------------------------

# This executable accessor is proved equal to the logical weight measure.
# The decreasing measure justifies using its contract in recursive calls.
@llvm
def genome_weight (g: Genome{|fun selected => fun tail => selected + tail <= 10|})
    : {w: Int | w = Genome.weight g && 0 <= w && w <= 10}
    decreasing_by [Genome.size g] :=
    match g with
    | empty_genome => 0
    | gene bit w v rest =>
        let tail_weight: {t: Int | t = Genome.weight rest && 0 <= t && t <= 10} :=
            genome_weight rest in
        if bit = 0 then tail_weight else w + tail_weight

@llvm
def individual_weight (ind: Individual)
    : {w: Int | w = Individual.weight ind && 0 <= w && w <= 10} :=
    match ind with
    | individual genes => genome_weight genes

# Repair a proposed bit before constructing the gene. Zero keeps the item in
# place for subsequent crossover/mutation, while contributing no weight.
@llvm
def prepend_gene
    (bit: Int | 0 <= bit && bit <= 1) (w: Int | w >= 0) (v: Int | v >= 0)
    (rest: Genome{|fun selected => fun tail => selected + tail <= 10|})
    : Genome{|fun selected => fun tail => selected + tail <= 10|} :=
    let tail_weight: {t: Int | t = Genome.weight rest && 0 <= t && t <= 10} :=
        genome_weight rest in
    let selected_weight: {s: Int | s = (if bit = 0 then 0 else w)} :=
        if bit = 0 then 0 else w in
    if selected_weight + tail_weight <= 10 then
        Genome.gene{|fun selected => fun tail => selected + tail <= 10|} bit w v rest
    else
        Genome.gene{|fun selected => fun tail => selected + tail <= 10|} 0 w v rest

@llvm
def empty_individual (u: Int) : Individual :=
    .individual (Genome.empty_genome{|fun selected => fun tail => selected + tail <= 10|})

@llvm
def genome_value (g: Genome{|fun selected => fun tail => selected + tail <= 10|})
    : {v: Int | v >= 0} decreasing_by [Genome.size g] :=
    match g with
    | empty_genome => 0
    | gene bit w v rest =>
        let tail_value: {t: Int | t >= 0} := genome_value rest in
        if bit = 0 then tail_value else v + tail_value

# Every Individual already fits the capacity; no overweight fitness penalty.
@llvm
def evaluate_individual (ind: Individual) : {fit: Int | fit >= 0} :=
    match ind with
    | individual genes => genome_value genes

# Random genome (gene density ~15%), repaired from the tail to the head.
@llvm
def create_genome (items: Items) (rng: Int)
    : (Pair Int Genome{|fun selected => fun tail => selected + tail <= 10|})
    decreasing_by [Items.size items] :=
    match items with
    | no_items =>
        Pair.mk{Int}{Genome{|fun selected => fun tail => selected + tail <= 10|}} rng
            (Genome.empty_genome{|fun selected => fun tail => selected + tail <= 10|})
    | item w v remaining =>
        let draw: (Pair Int Int) := rnd rng 100 in
        match draw with
        | mk rng2 r =>
            let bit: {b: Int | 0 <= b && b <= 1} := if r < 15 then 1 else 0 in
            let rest: (Pair Int Genome{|fun selected => fun tail => selected + tail <= 10|}) :=
                create_genome remaining rng2 in
            match rest with
            | mk rng3 tl =>
                Pair.mk{Int}{Genome{|fun selected => fun tail => selected + tail <= 10|}} rng3 (prepend_gene bit w v tl)

@llvm
def create_individual (items: Items) (rng: Int) : (Pair Int Individual) :=
    let result: (Pair Int Genome{|fun selected => fun tail => selected + tail <= 10|}) :=
        create_genome items rng in
    match result with
    | mk rng2 genes => .mk rng2 (.individual genes)


# ---------------------------------------------------------------------------
# Variation: crossover + mutation of two parents → a feasible child
# Parents share an item catalog; only selection bits cross over or mutate.
# ---------------------------------------------------------------------------

@llvm
def crossover_genomes
    (parent_a: Genome{|fun selected => fun tail => selected + tail <= 10|})
    (parent_b: Genome{|fun selected => fun tail => selected + tail <= 10|})
    (cut: Int) (j: Int) (rng: Int)
    : (Pair Int Genome{|fun selected => fun tail => selected + tail <= 10|})
    decreasing_by [Genome.size parent_a] :=
    match parent_a with
    | empty_genome =>
        Pair.mk{Int}{Genome{|fun selected => fun tail => selected + tail <= 10|}} rng
            (Genome.empty_genome{|fun selected => fun tail => selected + tail <= 10|})
    | gene ah w v at =>
        match parent_b with
        | empty_genome =>
            Pair.mk{Int}{Genome{|fun selected => fun tail => selected + tail <= 10|}} rng
                (Genome.empty_genome{|fun selected => fun tail => selected + tail <= 10|})
        | gene bh bw bv bt =>
            let src: {b: Int | 0 <= b && b <= 1} := if j < cut then ah else bh in
            let draw: (Pair Int Int) := rnd rng 100 in
            match draw with
            | mk rng2 m =>
                let out: {b: Int | 0 <= b && b <= 1} :=
                    if m = 0 then 1 - src else src in
                let rest: (Pair Int Genome{|fun selected => fun tail => selected + tail <= 10|}) :=
                    crossover_genomes at bt cut (j + 1) rng2 in
                match rest with
                | mk rng3 tl =>
                    Pair.mk{Int}{Genome{|fun selected => fun tail => selected + tail <= 10|}} rng3 (prepend_gene out w v tl)

@llvm
def crossover_mutate
    (parent_a: Individual) (parent_b: Individual) (cut: Int) (j: Int) (rng: Int)
    : (Pair Int Individual) :=
    match parent_a with
    | individual a =>
        match parent_b with
        | individual b =>
            let result: (Pair Int Genome{|fun selected => fun tail => selected + tail <= 10|}) :=
                crossover_genomes a b cut j rng in
            match result with
            | mk rng2 genes => .mk rng2 (.individual genes)


# ---------------------------------------------------------------------------
# Population helpers and evolutionary loop (map old → new)
# ---------------------------------------------------------------------------

@llvm
def length_pop (p: Population) : Int :=
    match p with
    | empty_pop => 0
    | member i rest => 1 + (length_pop rest)

@llvm
def nth_pop (p: Population) (i: Int) : Individual :=
    match p with
    | empty_pop => empty_individual 0
    | member hd tl =>
        if i <= 0 then hd else nth_pop tl (i - 1)

# Pure map: each individual → a new individual (no shared mutation).
def map_population
    (f: (x: Individual) -> Individual) (p: Population) : Population :=
    match p with
    | empty_pop => .empty_pop
    | member hd tl => .member (f hd) (map_population f tl)

# Map while threading RNG state; used to breed a whole generation.
def map_population_state
    (f: (s: Int) -> (x: Individual) -> (Pair Int Individual))
    (s: Int)
    (p: Population) : (Pair Int Population) :=
    match p with
    | empty_pop => .mk s .empty_pop
    | member hd tl =>
        let step : (Pair Int Individual) := f s hd in
        match step with
        | mk s1 child =>
            let rest : (Pair Int Population) := map_population_state f s1 tl in
            match rest with
            | mk s2 kids => .mk s2 (.member child kids)

@llvm
def fitnesses_of
    (p: Population) : (List Int) :=
    match p with
    | empty_pop => nil
    | member hd tl =>
        cons (evaluate_individual hd)
             (fitnesses_of tl)

@llvm
def best_fitness
    (p: Population) : Int :=
    maximum_list (fitnesses_of p)

@llvm
def tournament
    (pop: Population) (fits: (List Int)) (pop_size: {p: Int | p > 0}) (rng: Int)
    : (Pair Int Individual) :=
    let d1 : (Pair Int Int) := rnd rng pop_size in
    match d1 with
    | mk rng2 i =>
        let d2 : (Pair Int Int) := rnd rng2 pop_size in
        match d2 with
        | mk rng3 j =>
            let fa : Int := nth_list fits i in
            let fb : Int := nth_list fits j in
            if fa >= fb then .mk rng3 (nth_pop pop i) else .mk rng3 (nth_pop pop j)

# Breed one child; the slot individual only shapes the ``map`` walk.
@llvm
def breed_child
    (pop: Population) (fits: (List Int)) (pop_size: {p: Int | p > 0})
    (n_items: {n: Int | n > 0}) (rng: Int) (_slot: Individual)
    : (Pair Int Individual) :=
    let t1 : (Pair Int Individual) := tournament pop fits pop_size rng in
    match t1 with
    | mk rng2 p1 =>
        let t2 : (Pair Int Individual) := tournament pop fits pop_size rng2 in
        match t2 with
        | mk rng3 p2 =>
            let dc : (Pair Int Int) := rnd rng3 n_items in
            match dc with
            | mk rng4 cut => crossover_mutate p1 p2 cut 0 rng4

# Specialized map for breeding (avoids host-side closures under ``@llvm``).
@llvm
def breed_generation
    (pop: Population) (fits: (List Int)) (pop_size: {p: Int | p > 0})
    (n_items: {n: Int | n > 0}) (s: Int) (p: Population) : (Pair Int Population) :=
    match p with
    | empty_pop => .mk s .empty_pop
    | member hd tl =>
        let step : (Pair Int Individual) := breed_child pop fits pop_size n_items s hd in
        match step with
        | mk s1 child =>
            let rest : (Pair Int Population) :=
                breed_generation pop fits pop_size n_items s1 tl in
            match rest with
            | mk s2 kids => .mk s2 (.member child kids)

@llvm
def init_population (items: Items) (n: {k: Int | k >= 0}) (rng: Int)
    : (Pair Int Population) :=
    if n <= 0 then .mk rng .empty_pop
    else
        let one : (Pair Int Individual) := create_individual items rng in
        match one with
        | mk rng2 ind =>
            let rest : (Pair Int Population) := init_population items (n - 1) rng2 in
            match rest with
            | mk rng3 tl => .mk rng3 (.member ind tl)

# One generation: evaluate, then map each slot to a freshly bred child.
@llvm
def next_generation
    (n_items: {n: Int | n > 0}) (pop_size: {p: Int | p > 0})
    (pop: Population) (rng: Int) : (Pair Int Population) :=
    let fits : (List Int) := fitnesses_of pop in
    breed_generation pop fits pop_size n_items rng pop

@llvm
def evolve_loop
    (n_items: {n: Int | n > 0}) (pop_size: {p: Int | p > 0})
    (generations: Int) (g: Int) (pop: Population) (rng: Int) (best: Int) : Int :=
    if g >= generations then best
    else
        let fit : Int := best_fitness pop in
        let best2 : Int := if fit > best then fit else best in
        let step : (Pair Int Population) :=
            next_generation n_items pop_size pop rng in
        match step with
        | mk rng2 pop2 =>
            evolve_loop n_items pop_size generations (g + 1) pop2 rng2 best2

@llvm
def evolve
    (items: Items)
    (n_items: {n: Int | n > 0}) (pop_size: {p: Int | p > 0})
    (generations: {g: Int | g >= 0}) (seed: Int) : Int :=
    let started : (Pair Int Population) := init_population items pop_size seed in
    match started with
    | mk rng pop =>
        evolve_loop n_items pop_size generations 0 pop rng 0


# ---------------------------------------------------------------------------
# Five-item puzzle: optimal feasible value is 15 (weights 2 + 3 + 5 = 10).
# ---------------------------------------------------------------------------

@llvm
def puzzle_items (u: Int) : Items :=
    .item 2 3 (.item 3 4 (.item 4 5 (.item 5 8 (.item 9 10 .no_items))))

# Entire GA stays in LLVM so inductive values never cross the host boundary.
@llvm
def run_knapsack
    (pop_size: {p: Int | p > 0}) (generations: {g: Int | g >= 0}) (seed: Int) : Int :=
    evolve (puzzle_items 0) 5 pop_size generations seed

def main (args: Int) : Unit :=
    print (run_knapsack POP_SIZE GENERATIONS SEED);
