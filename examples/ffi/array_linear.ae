open Array

# Linear (QTT) array lifecycle.
#
# ``Array`` is a ``linear type``: every binder holding an array must be
# declared at multiplicity 1, and every transforming / reading op consumes
# its array argument. Threading a value through a chain of ``let 1``s is
# the canonical shape:
#
#     mk_1 → mk_concat → set → (Array.consume Array.sum)

def build (n: Int) : Int :=
    let 1 a0 := Array.mk_1 1 in
    let 1 a1 := Array.mk_concat a0 (Array.mk_1 2) in
    let 1 a2 := set a1 0 n in
    (Array.consume Array.sum) a2;

# Borrow the length, update the array, then release the final owner.
def length_after_update (n: Int) : {count:Int | count = 2} :=
    let 1 arr := #[5, 9] in
    let count := Array.length arr in
    let 1 updated := Array.set arr (count - 1) n in
    let after := Array.length updated in
    let _ := Array.dispose updated in
    after;

def fork (n: Int) : Int :=
    let 1 a := Array.mk_2 n 7 in
    with_pair (copy a) (fun left => fun right =>
        let count := length right in
        let _ := dispose right in
        (Array.consume Array.sum) left + count);

def main (args: Int) : Unit :=
    let total := build 10 in
    let forked := fork 3 in
    let count := length_after_update 7 in
    print (total + forked + count);
