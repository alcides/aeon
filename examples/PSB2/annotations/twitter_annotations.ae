import Array
open String
open PSB2


def  train: TrainData :=  extract_train_data ( load_dataset "twitter" 200 200)
def  input_list (_: Unit) : (Array Int) :=  get_input_list ( unpack_train_data  train)
def  expected_values (_: Unit) : (Array Int) :=  get_output_list ( unpack_train_data  train)

@minimize_float(String_distance ( join_string_list( get_tt_synth_values  (input_list unit) synth)) ( join_string_list( (expected_values unit))))
def synth (tweet:String) : String := ?hole
