# Legacy random-wrapper helpers. For synthesis-backed inputs, dependent
# refinements, failure reports and shrinking, prefer @property with --test.
# See examples/testing/*_properties.ae and docs/stdlib-properties.md.
open Array
open Copy

type Random

def random : Random := native_import "random"


# Generators

def generateInt (r:Random) : Int := native "r.randint(-1000, 1000)"

def generateFloat (r:Random) : Float := native "r.uniform(0, 100)"

def generateList (r:Random) : (Array Int) := native "[r.randint(0, 100) for _ in range(r.randint(0, 10))]"


# Property Wrappers


def countTrues (1 l:(Array Bool)) : Int :=
    native "sum(1 for x in l if x)"


def ratio (a:Int) (b:Int) : Float := native "a/b"

def forAllInts (func:(a: Int) -> Bool) : Float :=
    n := 1000;
    let 1 vs := Array.mk_repeat n unit in
    let 1 rds := vs.map (fun _ => generateInt random) in
    let 1 rs := rds.map func in
    positive := (countTrues rs);
    ratio positive n


def forAllFloats (func:(a: Float) -> Bool) : Float :=
    n := 1000;
    let 1 vs := Array.mk_repeat n unit in
    let 1 rds := vs.map (fun _ => generateFloat random) in
    let 1 rs := rds.map func in
    positive := (countTrues rs);
    ratio positive n


def forAllLists (func:(1 a: (Array Int)) -> Bool) : Float :=
    n := 1000;
    let 1 vs := Array.mk_repeat n unit in
    let 1 rds := vs.map (fun _ => generateList random) in
    let 1 rs := Array.map_owned func rds in
    positive := (countTrues rs);
    ratio positive n
