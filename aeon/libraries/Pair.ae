open Copy

# Polymorphic product type. Eliminate with ``match`` over the single
# ``mk`` constructor (the generated recursor ``Pair_rec`` is also
# available). The field measures also expose the constructor's values
# to refinements, including dependent contracts over either component.

inductive Pair a b
| mk (fst:a) (snd:b) : {p:(Pair a b) | first p = fst && second p = snd}
+ first (p:(Pair a b)) : a
+ second (p:(Pair a b)) : b

# Immutable values are copyable when their elements are copyable.
instance [Copy a] [Copy b] : Copy (Pair a b) where
    duplicate x := x;
