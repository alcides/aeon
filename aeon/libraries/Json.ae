open Array

type Json

def kind : (j:Json) -> Int := uninterpreted
def size : (j:Json) -> Int := uninterpreted
def containsKey : (j:Json) -> (key:String) -> Bool := uninterpreted
def validSource : (s:String) -> Bool := uninterpreted
def isValid (s:String) : {b:Bool | b = validSource s} :=
    native "__import__('aeon.bindings.contracts', fromlist=['json_source']).json_source(s)"

def json : Unit := native_import "json"

# ── Parsing / serialization ────────────────────────────────────────────

# Parses JSON validated with isValid, or produced by stringify.
# s: syntactically valid JSON source
def parse (s: {x:String | validSource x}) : Json := native "json.loads(s)"

# Parses a JSON file at path.
# path: non-empty file path
def parseFile (path: {p:String | p != ""}) : Json :=
    native "json.load(open(path))"

# Serializes a Json value to its string form. The result is always
# non-empty (json.dumps(None) yields "null").
def stringify (j: Json) : {s:String | s != "" && validSource s} := native "json.dumps(j)"

# Pretty-prints a Json value with 2-space indentation. Always non-empty.
def stringifyPretty (j: Json) : {s:String | s != "" && validSource s} := native "json.dumps(j, indent=2)"

# Writes a Json value to a file.
# path: non-empty file path
def writeFile (path: {p:String | p != ""}) (j: Json) : Unit :=
    native "open(path, 'w').write(json.dumps(j))"

# ── Type queries ───────────────────────────────────────────────────────

def isNull (j: Json) : {b:Bool | b = (kind j = 0)} := native "j is None"
def isBool (j: Json) : {b:Bool | b = (kind j = 1)} := native "isinstance(j, bool)"
def isNumber (j: Json) : {b:Bool | b = (kind j = 2 || kind j = 3)} := native "isinstance(j, (int, float)) and not isinstance(j, bool)"
def isString (j: Json) : {b:Bool | b = (kind j = 4)} := native "isinstance(j, str)"
def isArray (j: Json) : {b:Bool | b = (kind j = 5)} := native "isinstance(j, list)"
def isObject (j: Json) : {b:Bool | b = (kind j = 6)} := native "isinstance(j, dict)"

# ── Coercion (runtime-typed) ───────────────────────────────────────────
# Each asX raises at runtime if the value is not of that kind.

def asBool (j: {v:Json | kind v = 1}) : Bool :=
    native "j if isinstance(j, bool) else (_ for _ in ()).throw(TypeError('not a bool'))"

def asInt (j: {v:Json | kind v = 2}) : Int :=
    native "j if (isinstance(j, int) and not isinstance(j, bool)) else (_ for _ in ()).throw(TypeError('not an int'))"

def asFloat (j: {v:Json | kind v = 2 || kind v = 3}) : Float :=
    native "float(j) if (isinstance(j, (int, float)) and not isinstance(j, bool)) else (_ for _ in ()).throw(TypeError('not a number'))"

def asString (j: {v:Json | kind v = 4}) : String :=
    native "j if isinstance(j, str) else (_ for _ in ()).throw(TypeError('not a string'))"

# ── Object access ──────────────────────────────────────────────────────

# Returns true if j is an object containing key.
def has (j: Json) (key: String) : {b:Bool | b = containsKey j key && (b = false || kind j = 6)} := native "isinstance(j, dict) and key in j"

# Looks up a key in a JSON object. Raises at runtime if j is not an
# object or key is absent.
def get (j: {v:Json | kind v = 6}) (key: {s:String | containsKey j s}) : Json := native "j[key]"

# ── Array access ───────────────────────────────────────────────────────

# Returns the length of an array (or string/object). Raises if j has no len.
def length (j: {v:Json | kind v = 4 || kind v = 5 || kind v = 6}) : {x:Int | x >= 0 && x = size j} := native "len(j)"

# Indexes into a JSON array. Raises at runtime if i is out of range.
def at (j: {v:Json | kind v = 5}) (i: {x:Int | x >= 0 && x < size j}) : Json := native "j[i]"

# ── Construction ───────────────────────────────────────────────────────

def mkNull : {r:Json | kind r = 0} := native "None"

def mkBool (b: Bool) : {r:Json | kind r = 1} := native "b"

def mkInt (i: Int) : {r:Json | kind r = 2} := native "i"

def mkFloat (f: Float) : {r:Json | kind r = 3} := native "f"

def mkString (s: String) : {r:Json | kind r = 4} := native "s"

def mkArray (1 xs: (Array Json)) : {r:Json | kind r = 5 && size r = Array.size xs} := native "list(xs)"

# An empty JSON object. Use setKey to populate.
def mkObject : {r:Json | kind r = 6 && size r = 0} := native "{}"

# Returns a new object with key set to value. Raises at runtime if j is
# not an object.
def setKey (j: {v:Json | kind v = 6}) (key: String) (value: Json) : {r:Json | kind r = 6 && containsKey r key} :=
    native "({**j, key: value} if isinstance(j, dict) else (_ for _ in ()).throw(TypeError('not an object')))"

def isInt (j:Json) : {b:Bool | b = (kind j = 2)} := native "type(j) is int"
