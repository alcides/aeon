# Fitness adapters preserve one objective per training example, at any count.
# Keep one objective per example; convert integer/float errors consistently.
import Array

# Lazy, deterministic dataset fixture. Only this boundary owns Python values;
# benchmark functions receive native Aeon List values and correctly typed scalars.
type Cases

def caseCount : (cases:Cases) -> Int := uninterpreted
def cases (problem:String) (count:{n:Int | n > 0}) : {c:Cases | caseCount c = count} :=
    native "__import__('aeon.bindings.psb2', fromlist=['training_data']).training_data(problem, count, 0)"

def meanError (1 errors:(Array Float)) : Float :=
    native "sum(errors) / len(errors) if errors else 0.0"

def per_example_errors (1 values: (Array Float)) : {errors: (Array Float) | Array.size errors = Array.size values} :=
    native "[float(error) for error in values]";

def per_example_errors_int (1 values: (Array Int)) : {errors: (Array Float) | Array.size errors = Array.size values} :=
    native "[float(error) for error in values]";

# Compatibility name: the length now comes from the input, like the main adapter.
def per_example_errors_50 (1 values: (Array Float)) : {errors: (Array Float) | Array.size errors = Array.size values} :=
    per_example_errors values;
