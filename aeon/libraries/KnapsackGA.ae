# 0-1 knapsack genetic algorithm as a single LLVM/CUDA kernel.
#
# The generation loop is compiled into one device function. Host code uploads
# buffers once, launches once, and synchronises only when the kernel returns —
# there is no per-generation CPU round-trip.

open Array

# Default workload: 1000 items, population 100. ``GENERATIONS`` is sized for a
# ~5 minute GPU run on a typical discrete NVIDIA GPU (calibrate with
# ``scripts/bench_knapsack_ga_gpu.py``).
def N_ITEMS : Int := 1000
def POP_SIZE : Int := 100
def GENERATIONS : Int := 14500
def SEED : Int := 20260913


def run_cpu
    (1 weights: (Array Int))
    (1 values: (Array Int))
    (n_items: Int)
    (capacity: Int)
    (pop_size: Int)
    (generations: Int)
    (seed: Int) : Int :=
    native "__import__('aeon.bindings.knapsack_ga').bindings.knapsack_ga.run_cpu_aeon(weights)(values)(n_items)(capacity)(pop_size)(generations)(seed)"


def run_gpu
    (1 weights: (Array Int))
    (1 values: (Array Int))
    (n_items: Int)
    (capacity: Int)
    (pop_size: Int)
    (generations: Int)
    (seed: Int) : Int :=
    native "__import__('aeon.bindings.knapsack_ga').bindings.knapsack_ga.run_gpu_aeon(weights)(values)(n_items)(capacity)(pop_size)(generations)(seed)"


# Convenience: build a random 1000-item instance on the host, then run the
# single GPU kernel for ``generations`` steps.
def run_random_gpu
    (n_items: Int)
    (pop_size: Int)
    (generations: Int)
    (seed: Int) : Int :=
    native "__import__('aeon.bindings.knapsack_ga').bindings.knapsack_ga.run_random_gpu_aeon(n_items)(pop_size)(generations)(seed)"


def run_random_cpu
    (n_items: Int)
    (pop_size: Int)
    (generations: Int)
    (seed: Int) : Int :=
    native "__import__('aeon.bindings.knapsack_ga').bindings.knapsack_ga.run_random_cpu_aeon(n_items)(pop_size)(generations)(seed)"
