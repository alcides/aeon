# Linear pseudo-random generators. Draws consume a generator and return a
# linear token containing the sample and its successor. Observe the sample
# with a borrowed *_value call, then consume the token with *_next or
# discard_draw / discard_int_draw / discard_range_draw.
# This prevents two projections from manufacturing aliases to one generator.

open Array

# An opaque pseudo-random generator (a Python `random.Random` at runtime),
# used linearly: every draw consumes it and produces a fresh successor. Being
# a `linear type`, every binder holding an `Rng` must be declared with
# multiplicity 1.
linear type Rng

# Each result owns its successor generator until extracted or discarded.
linear type Draw
linear type IntDraw
linear type RangeDraw

# A fresh generator seeded deterministically. The `Int` argument makes this
# an *applied* action, so each call yields a new generator — a nullary `def`
# would be a memoised value, aliasing one generator everywhere.
def new_rng (seed: Int) : Rng := native "__import__('random').Random(seed)"

# ── Float draw in [0.0, 1.0) ────────────────────────────────────────────
def draw (1 g: Rng) : Draw := native "(g.random(), g)"
def draw_value (borrow d: Draw) : {r: Float | r >= 0.0 && r < 1.0} := native "d[0]"
def draw_next (1 d: Draw) : Rng := native "d[1]"

# ── Integer draw in [lo, hi] ────────────────────────────────────────────
# The bounds are repeated on the projection so the refinement survives the
# opaque `IntDraw`.
def draw_int (lo: Int) (hi: {y: Int | y >= lo}) (1 g: Rng) : IntDraw :=
    native "(g.randint(lo, hi), g)"
def int_value (lo: Int) (hi: {y: Int | y >= lo}) (borrow d: IntDraw) : {r: Int | r >= lo && r <= hi} :=
    native "d[0]"
def int_next (1 d: IntDraw) : Rng := native "d[1]"

# ── Float draw in [lo, hi) ──────────────────────────────────────────────
def draw_range (lo: Float) (hi: {y: Float | y > lo}) (1 g: Rng) : RangeDraw :=
    native "(g.uniform(lo, hi), g)"
def range_value (lo: Float) (hi: {y: Float | y > lo}) (borrow d: RangeDraw) : {r: Float | r >= lo && r < hi} :=
    native "d[0]"
def range_next (1 d: RangeDraw) : Rng := native "d[1]"

# ── Uniform choice from a non-empty array (polymorphic) ─────────────────
# Terminal: consume `g` and return the chosen element. To choose mid-chain
# and keep drawing, draw an index instead — `draw_int 0 (Array.size xs - 1)`
# — and project the successor as usual.
def choose (1 xs: {l: (Array a) | Array.size l > 0}) (1 g: Rng) : a :=
    native "g.choice(xs)"

# Explicitly end ownership of a generator.
def close_rng (1 g: Rng) : Unit := native "None"

# End a draw chain after observing its final sample.
def discard_draw (1 d:Draw) : Unit := native "None"

# End a draw chain after observing its final sample.
def discard_int_draw (1 d:IntDraw) : Unit := native "None"

# End a draw chain after observing its final sample.
def discard_range_draw (1 d:RangeDraw) : Unit := native "None"
