# Flat, contiguous, native-backed sequence with random access.
#
# ``Array`` is an opaque type parameterised by:
#  * its element type ``a``;
#  * an abstract refinement ``p`` (Liquid Haskell-style ``data Array a <p>``)
#    that every element of the array satisfies.
#
# The underlying storage is a Python list, so operations are O(1) for
# indexed access and O(n + m) for concatenation.
#
# ── Linear (QTT) discipline ──────────────────────────────────────────────
#
# ``Array`` is a ``linear type``: an array is a *unique* value, so every
# owner that holds one must be declared at multiplicity 1 — ``let 1 a :=
# ...`` for a local, ``(1 arr: ...)`` for a parameter. Omitting the ``1`` is
# an error. Every owner is consumed **exactly once**. Read-only parameters
# use ``(borrow arr: ...)`` and return ownership to the caller after the
# call. Borrowing neither consumes the array nor permits aliasing it.
#
# Because uniqueness is statically guaranteed, the native bodies are free
# to mutate the backing list in place — there is no other observer that a
# mutation could surprise. (The bodies below stay purely functional, so the
# runtime behaviour is unchanged.)
#
# Operations follow these ownership rules:
#
#   * **Transformers** (``mk_concat``, ``set``, ``reversed``, ``map``,
#     ``filter``) consume the array and return a fresh one — bind the result
#     to the next ``let 1`` and keep going.
#
#   * **Borrowing reads** (``length``, ``empty``) leave the owner available
#     for later updates. They return scalars, never references into the
#     buffer. Reads after a move and closure captures are rejected.
#
#   * **Consuming reads** (``get``, ``head``, ``sum``, ``reduce``) end
#     ownership. ``get_at`` with ``with_get`` threads an indexed read.
#     Use ``dispose`` after the last borrow if no consuming operation is
#     needed. Element and size refinements survive borrows and updates.
#
# When you need two genuinely independent arrays — to branch a computation
# in two — call ``copy``: it consumes the array once and hands back two
# arrays packaged in an ``ArrayPair`` (consumed with ``with_pair``), each
# with the element refinement and length preserved.

linear type Array a forall <p : a -> Bool>

# Opaque pair of arrays, returned by ``copy``. Backed by a Python 2-tuple;
# kept self-contained (rather than reusing the ``Pair`` library) so that
# ``Array`` has no further imports to drag through every ``open Array``.
#
# Wrappers own their arrays and must themselves be consumed exactly once.
# Use the continuation helpers to recover both fields in one consumption.
linear type ArrayPair a

# Result of ``get_at``: the element read, plus the array it was read from.
linear type ArrayGet a

def functools : Unit := native_import "functools"


# Abstract length measure.
def size : (arr: (Array a)) -> Int := uninterpreted

# Length carried by an ``ArrayGet`` wrapper — the ``size`` of the array
# inside it. Lets the projections restate the length they were built with,
# so threading an array through a read loses nothing.
def got_size : (g: (ArrayGet a)) -> Int := uninterpreted

# Common length of the two arrays inside an ``ArrayPair``.
def pair_size : (pr: (ArrayPair a)) -> Int := uninterpreted


# A scoped read: the caller retains ownership and may update the array later.
def length (borrow arr: (Array a)) : {n:Int | n = size arr} :=
    native "len(arr)"


# End ownership when no further consuming operation is needed.
def dispose (1 arr: (Array a)) : Unit := native "None"


# A Unit argument makes each empty array a fresh allocation.
def mk_empty (_:Unit) : {xs:(Array a<p>) | size xs = 0} :=
    native "[]";

# The repeated value is unrestricted: linear resources cannot be duplicated.
def mk_repeat (n:{n:Int | n >= 0}) (v:a) :
    {xs:(Array {x:a | x = v}) | size xs = n} :=
    native "[v] * n";

# Fixed-arity constructors preserve argument order and the element predicate.
def mk_1 (1 x0:a<p>)
    : {xs:(Array a<p>) | size xs = 1} :=
    native "[x0]";

def mk_2 (1 x0:a<p>) (1 x1:a<p>)
    : {xs:(Array a<p>) | size xs = 2} :=
    native "[x0, x1]";

def mk_4 (1 x0:a<p>) (1 x1:a<p>) (1 x2:a<p>) (1 x3:a<p>)
    : {xs:(Array a<p>) | size xs = 4} :=
    native "[x0, x1, x2, x3]";

def mk_8 (1 x0:a<p>) (1 x1:a<p>) (1 x2:a<p>) (1 x3:a<p>)
        (1 x4:a<p>) (1 x5:a<p>) (1 x6:a<p>) (1 x7:a<p>)
    : {xs:(Array a<p>) | size xs = 8} :=
    native "[x0, x1, x2, x3, x4, x5, x6, x7]";

def mk_16 (1 x0:a<p>) (1 x1:a<p>) (1 x2:a<p>) (1 x3:a<p>)
        (1 x4:a<p>) (1 x5:a<p>) (1 x6:a<p>) (1 x7:a<p>)
        (1 x8:a<p>) (1 x9:a<p>) (1 x10:a<p>) (1 x11:a<p>)
        (1 x12:a<p>) (1 x13:a<p>) (1 x14:a<p>) (1 x15:a<p>)
    : {xs:(Array a<p>) | size xs = 16} :=
    native "[x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15]";

def mk_32 (1 x0:a<p>) (1 x1:a<p>) (1 x2:a<p>) (1 x3:a<p>)
        (1 x4:a<p>) (1 x5:a<p>) (1 x6:a<p>) (1 x7:a<p>)
        (1 x8:a<p>) (1 x9:a<p>) (1 x10:a<p>) (1 x11:a<p>)
        (1 x12:a<p>) (1 x13:a<p>) (1 x14:a<p>) (1 x15:a<p>)
        (1 x16:a<p>) (1 x17:a<p>) (1 x18:a<p>) (1 x19:a<p>)
        (1 x20:a<p>) (1 x21:a<p>) (1 x22:a<p>) (1 x23:a<p>)
        (1 x24:a<p>) (1 x25:a<p>) (1 x26:a<p>) (1 x27:a<p>)
        (1 x28:a<p>) (1 x29:a<p>) (1 x30:a<p>) (1 x31:a<p>)
    : {xs:(Array a<p>) | size xs = 32} :=
    native "[x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29, x30, x31]";

# Consume both inputs; preserve their order, element predicate, and total size.
def mk_concat (1 xs:(Array a<p>)) (1 ys:(Array a<p>)) :
    {zs:(Array a<p>) | size zs = size xs + size ys} :=
    native "xs + ys";


# True when the array is empty. Borrows it without transferring ownership.
def empty (borrow arr: (Array a)) : {b:Bool | b = (size arr = 0)} :=
    arr.length = 0


# Explicit copy: consume the single linear reference and return two
# independent arrays — the original buffer plus a fresh physical duplicate.
# At run time both halves hold the same elements as the input; this is the
# only way to turn one unique reference into two, to branch a linear
# computation.
#
# The element refinement ``<p>`` rides on the element type of the pair and
# the length is threaded by the ``pair_size`` measure, so both projections
# come back fully specified.
def copy (1 arr: (Array a<p>)) : {pr: (ArrayPair a<p>) | pair_size pr = size arr} :=
    native "(arr, list(arr))"


# Left projection of a ``copy`` — the original buffer.
def fst_array (1 pr: (ArrayPair a<p>)) : {r: (Array a<p>) | size r = pair_size pr} :=
    native "pr[0]"


# Right projection of a ``copy`` — the fresh duplicate.
def snd_array (1 pr: (ArrayPair a<p>)) : {r: (Array a<p>) | size r = pair_size pr} :=
    native "pr[1]"


# ── Reading without giving up the array ─────────────────────────────────
#
# ``get_at`` consumes the array and returns a wrapper holding both the
# answer and the array, so a read can be threaded through a linear chain.
# Use ``with_get`` to recover both fields. A terminal
# projection consumes the wrapper and discards the other field.

def get_at (1 arr: (Array a<p>)) (i: {n:Int | n >= 0 && n < size arr}) :
    {g: (ArrayGet a<p>) | got_size g = size arr} :=
    native "(arr[i], arr)"


# The element read by ``get_at``; still known to satisfy ``p``.
def got_value (1 g: (ArrayGet a<p>)) : a<p> :=
    native "g[0]"


# The array ``get_at`` read from, with its length intact.
def got_array (1 g: (ArrayGet a<p>)) : {r: (Array a<p>) | size r = got_size g} :=
    native "g[1]"


# Consume a copied pair once; both buffers have independent storage.
def with_pair (1 token:(ArrayPair a<p>))
    (1 consume:(1 left:{r:(Array a<p>) | size r = pair_size token}) ->
        (1 right:{r:(Array a<p>) | size r = pair_size token}) -> b<q>) : b<q> :=
    native "consume(token[0])(token[1])"


# Reading an element and continuing with the array uses one wrapper.
def with_get (1 token:(ArrayGet a<p>))
    (1 consume:(value:a<p>) -> (1 arr:{r:(Array a<p>) | size r = got_size token}) -> b<q>) : b<q> :=
    native "consume(token[0])(token[1])"


# Indexed read; the result is known to satisfy ``p``. Consumes the array —
# use ``get_at`` to read and keep it.
def get (1 arr: (Array a<p>)) (i: {n:Int | n >= 0 && n < size arr}) : {v:a | p v} :=
    native "arr[i]"


# Indexed write; preserves length, and the written value must satisfy ``p``.
# Consumes the array linearly and returns the fresh, updated array.
def set (1 arr: (Array a<p>)) (i: {n:Int | n >= 0 && n < size arr}) (1 x: {v:a | p v}) : {r:(Array a<p>) | size r = size arr} :=
    native "arr[:i] + [x] + arr[i+1:]"


# First element of a non-empty array. Its predicate must come from the input;
# a free output predicate would let callers prove arbitrary facts. Consumes it.
def head (1 arr: {arr:(Array a<p>) | size arr > 0}) : {v:a | p v} :=
    native "arr[0]"


# Reversed copy; length is preserved. Consumes the array linearly.
def reversed (1 arr: (Array a<p>)) : {r:(Array a<p>) | size r = size arr} :=
    native "arr[::-1]"


# Map a function across the array; length is preserved and the result
# refinement ``q`` is pushed through ``f``. Consumes the array linearly.
def map (f: (x: {v:a | p v}) -> {w:b | q w}) (1 arr: (Array a<p>)) : {r:(Array b<q>) | size r = size arr} :=
    native "list(map(f, arr))"


# Filter an array by ``f``; the length never grows. Consumes the array
# linearly.
def filter (f: (x: {v:a | p v}) -> Bool) (1 arr: (Array a<p>)) : {r:(Array a<p>) | size r <= size arr} :=
    native "list(filter(f, arr))"


# Right fold: ``reduce f z [x1, ..., xn] == f x1 (f x2 (... (f xn z)))``.
# Consumes the array.
def reduce (f: (x:{v:a | p v}) -> (acc:b) -> b) (z: b) (1 arr: (Array a<p>)) : b :=
    native "functools.reduce(lambda acc, curr: f(curr)(acc), reversed(arr), z)"


# Sum of an Int array. Consumes the array.
def sum (1 arr: (Array Int)) : Int :=
    native "sum(arr)"


# Mean of a Float array. Consumes the array.
def mean (1 arr: (Array Float)) : Float :=
    native "(sum(arr) / len(arr)) if len(arr) else 0.0"


# Index-aware map: ``f`` receives ``(index, element)``. Length preserved.
def imap (f: (i: Int) -> (x: {v:a | p v}) -> {w:b | q w}) (1 arr: (Array a<p>)) :
    {r:(Array b<q>) | size r = size arr} :=
    native "[f(i)(x) for i, x in enumerate(arr)]"


# Pairwise zip-with; both arrays must share length ``size``.
def zipWith (f: (x: {v:a | p v}) -> (y: {w:b | q w}) -> {z:c | r z})
    (1 xs: (Array a<p>)) (1 ys: {arr:(Array b<q>) | size arr = size xs}) :
    {out:(Array c<r>) | size out = size xs} :=
    native "[f(x)(y) for x, y in zip(xs, ys)]"


# Count elements satisfying ``f``. Consumes the array.
def count (f: (x: {v:a | p v}) -> Bool) (1 arr: (Array a<p>)) : {n:Int | n >= 0 && n <= size arr} :=
    native "sum(1 for x in arr if f(x))"


# Scale every Float element by ``k``. Consumes the array.
def scale (k: Float) (1 arr: (Array Float)) : {r:(Array Float) | size r = size arr} :=
    native "[k * x for x in arr]"


# Elementwise add of two equal-length Float arrays.
def vadd (1 xs: (Array Float)) (1 ys: {arr:(Array Float) | size arr = size xs}) :
    {r:(Array Float) | size r = size xs} :=
    native "[a + b for a, b in zip(xs, ys)]"
