open Copy

# Linked list — an inductive datatype with the standard ``nil`` / ``cons``
# constructors and a length measure.
#
# ``List`` is parameterised by:
#  * its element type ``a``;
#  * an abstract refinement ``p`` (Liquid Haskell-style ``data List a <p>``)
#    that every element of the list satisfies. The refinement flows through
#    every constructor: a value can only enter the list if it satisfies ``p``.
inductive List a forall <p : a -> Bool>
| nil : {l: (List a) | size l = 0 && structuralRank l = 0}
| cons (hd: {v:a | p v}) (tl: (List a)) : {l: (List a) | size l = size tl + 1 && size tl >= 0 && structuralRank l = structuralRank tl + 1 && structuralRank tl >= 0 && first l = hd && rest l = tl}
+ size (l: (List a)) : Int
+ structuralRank (l: (List a)) : Int
+ first (l: (List a)) : a
+ rest (l: (List a)) : (List a)


# Length of the list (counted by recursion).
def length (l: (List a)) : Int :=
    match l with
    | nil => 0
    | cons hd tl => 1 + (length tl);


# True when the list is empty.
def empty (l: (List a)) : Bool :=
    match l with
    | nil => true
    | cons hd tl => false;


# Append two lists.
def append (xs: (List a)) (ys: (List a)) : (List a) :=
    match xs with
    | nil => ys
    | cons hd tl => cons hd (append tl ys);


# Map a function over the list.
def map (f: (x:a) -> b) (l: (List a)) : (List b) :=
    match l with
    | nil => nil
    | cons hd tl => cons (f hd) (map f tl);


# Right fold: ``foldr f z [x1, ..., xn] == f x1 (f x2 (... (f xn z)))``.
def foldr (f: (x:a) -> (acc:b) -> b) (z: b) (l: (List a)) : b :=
    match l with
    | nil => z
    | cons hd tl => f hd (foldr f z tl);


# Reverse helper: prepends elements of ``xs`` onto ``acc``.
def reverse_acc (xs: (List a)) (acc: (List a)) : (List a) :=
    match xs with
    | nil => acc
    | cons hd tl => reverse_acc tl (cons hd acc);


# Reverse a list.
def reversed (l: (List a)) : (List a) :=
    l.reverse_acc nil;


# Append a value at the back of the list (snoc).
def snoc (l: (List a)) (x: a) : (List a) :=
    l.append (cons x nil);


# Sum of a list of integers.
def sum (l: (List Int)) : Int :=
    match l with
    | nil => 0
    | cons hd tl => hd + (sum tl);


# True when ``p`` holds for every element of ``l``.
def all (p: (x:a) -> Bool) (l: (List a)) : Bool :=
    match l with
    | nil => true
    | cons hd tl => p hd && (all p tl);

# Left fold, preserving the order of accumulation.
def foldl (f:(acc:b) -> (x:a) -> b) (initial:b) (xs:(List a)) : b :=
    match xs with
    | nil => initial
    | cons x rest => foldl f (f initial x) rest;

# Retain matching elements in their original order.
def filter (predicate:(x:a) -> Bool) (xs:(List a)) : (List a) :=
    match xs with
    | nil => nil
    | cons x rest => if predicate x then cons x (filter predicate rest) else filter predicate rest;

# Combine corresponding elements, stopping at the shorter input.
def zipWith (f:(x:a) -> (y:b) -> c) (xs:(List a)) (ys:(List b)) : (List c) :=
    match xs with
    | nil => nil
    | cons x tail => match ys with
        | nil => nil
        | cons y rest => cons (f x y) (zipWith f tail rest);

# Prefix/suffix operations clamp nonpositive counts to zero and stop at the end.
def take (count:Int) (xs:(List a)) : (List a) :=
    if count <= 0 then nil else
        match xs with
        | nil => nil
        | cons x rest => cons x (take (count - 1) rest);

def drop (count:Int) (xs:(List a)) : (List a) :=
    if count <= 0 then xs else
        match xs with
        | nil => nil
        | cons x rest => drop (count - 1) rest;

# Half-open ascending integer range; an inverted interval is empty.
def range (start:Int) (stop:Int) : (List Int) :=
    if start >= stop then nil else cons start (range (start + 1) stop);

def sumFloat (xs:(List Float)) : Float :=
    foldl (fun total => fun x => total + x) 0.0 xs;

# Remove one occurrence, preserving the order and any later duplicates.
def removeFirst (value:a) (xs:(List a)) : (List a) :=
    match xs with
    | nil => nil
    | cons x rest => if x = value then rest else cons x (removeFirst value rest);

# Immutable values are copyable when their elements are copyable.
instance [Copy a] : Copy (List a) where
    duplicate x := x;
